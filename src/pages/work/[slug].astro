---
import PageLayout from "@layouts/PageLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<PageLayout title={project.data.title} description={project.data.description}>
  <!-- Case Study Hero -->
  <section class="pt-[72px] py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <a href="/work" class="inline-flex items-center font-body text-[14px] text-[var(--color-primary)] font-medium hover:underline mb-8">
        &larr; Back to Work
      </a>
      <p class="font-body text-[12px] font-semibold uppercase tracking-widest text-[var(--color-primary)] mb-3">Case Study</p>
      <h1 class="font-display italic text-[40px] md:text-[56px] lg:text-[72px] text-[var(--color-text-primary)] leading-[1.1] font-bold tracking-tight">
        {project.data.title}
      </h1>
      <p class="font-body text-[18px] text-[var(--color-text-secondary)] mt-4 leading-relaxed">
        {project.data.description}
      </p>

      {project.data.technologies.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-6">
          {project.data.technologies.map((tech) => (
            <span class="font-body text-[12px] text-[var(--color-text-muted)] bg-[var(--color-secondary)] px-3 py-1 rounded-full">{tech}</span>
          ))}
        </div>
      )}

      <div class="flex gap-3 mt-8">
        {project.data.github && (
          <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-5 py-2.5 border border-[var(--color-card-border)] text-[var(--color-text-primary)] font-body text-[14px] font-medium rounded-[8px] hover:bg-[var(--color-secondary)] transition-colors">
            GitHub &nearr;
          </a>
        )}
        {project.data.live && (
          <a href={project.data.live} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-5 py-2.5 bg-[var(--color-primary)] text-white font-body text-[14px] font-medium rounded-[8px] hover:bg-[var(--color-primary-hover)] transition-colors">
            Live Site &nearr;
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="pb-16 md:pb-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>

  <!-- Back -->
  <section class="pb-16 md:pb-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10 text-center">
      <a href="/work" class="inline-flex items-center justify-center px-8 py-3 border border-[var(--color-primary)] text-[var(--color-primary)] font-body text-[16px] font-medium rounded-[10px] hover:bg-[var(--color-primary)] hover:text-white transition-colors">
        &larr; Back to All Projects
      </a>
    </div>
  </section>
</PageLayout>
