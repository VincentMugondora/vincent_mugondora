---
import PageLayout from "@layouts/PageLayout.astro";
import { siteConfig } from "@config/site";
import { getAllProjects } from "@lib/content";

const projects = await getAllProjects();

const categories = ["All", "Software", "AI", "Web", "Automation", "Education"];

const featuredProjects = [
  {
    number: "01",
    title: "AI Opportunity Intelligence",
    description: "A platform designed to identify emerging business and technology opportunities from information and real-world signals.",
    role: "Founder / Engineer",
    category: "AI / Product",
    stack: ["Python", "FastAPI", "PostgreSQL", "AI"],
    slug: "ai-opportunity-intelligence",
    gradient: "from-purple-100 to-purple-50",
  },
  {
    number: "02",
    title: "School Management Platform",
    description: "A role-based platform for managing students, teachers, parents, classes and academic operations.",
    role: "Full-Stack Engineer",
    category: "SaaS / Education",
    stack: ["Next.js", "TypeScript", "PostgreSQL", "Prisma"],
    slug: "school-management-platform",
    gradient: "from-blue-100 to-blue-50",
  },
  {
    number: "03",
    title: "AI WhatsApp Assistant",
    description: "Making useful AI accessible through a communication platform people already use.",
    role: "Engineer",
    category: "AI / Automation",
    stack: ["Python", "FastAPI", "WhatsApp API", "AI"],
    slug: "ai-whatsapp-assistant",
    gradient: "from-green-100 to-green-50",
  },
];

const techStack = {
  Languages: ["Python", "JavaScript", "TypeScript", "PHP"],
  Frontend: ["React", "Next.js", "Astro", "Tailwind"],
  Backend: ["Node.js", "Express", "FastAPI", "Django", "Laravel"],
  Data: ["PostgreSQL", "Prisma", "Supabase"],
  AI: ["LLMs", "AI Agents", "RAG", "AI Automation"],
};
---

<PageLayout title="Work" description="Software engineering projects and case studies by Vincent Mugondora.">
  <!-- Hero -->
  <section class="pt-[72px] py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <h1 class="font-display italic text-[48px] md:text-[72px] lg:text-[96px] text-[var(--color-text-primary)] leading-[1.05] font-bold tracking-tight">
        Selected <span class="marker-highlight">Work</span>
      </h1>
      <p class="font-display italic text-[24px] md:text-[28px] text-[var(--color-text-primary)] mt-4 leading-snug">
        Turning real problems into software, AI systems and digital products.
      </p>
      <p class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] mt-4 max-w-[700px] leading-relaxed">
        A collection of products, experiments, and systems I've designed and built across software engineering, AI, education, and entrepreneurship.
      </p>
    </div>
  </section>

  <!-- Featured Work -->
  <section class="pb-16 md:pb-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <div class="space-y-12 md:space-y-16">
        {featuredProjects.map((project) => (
          <a href={`/work/${project.slug}`} class="block group">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
              <div class={`aspect-[4/3] rounded-[16px] bg-gradient-to-br ${project.gradient} flex items-center justify-center overflow-hidden border border-[var(--color-card-border)] transition-all duration-300 group-hover:-translate-y-1 group-hover:shadow-lg`}>
                <span class="font-display italic text-[24px] text-[var(--color-text-muted)]">{project.title}</span>
              </div>
              <div>
                <p class="font-body text-[12px] font-semibold uppercase tracking-widest text-[var(--color-primary)] mb-2">{project.number} &mdash; {project.category}</p>
                <h2 class="font-display italic text-[28px] md:text-[36px] font-bold text-[var(--color-text-primary)] tracking-tight leading-tight">{project.title}</h2>
                <p class="font-body text-[16px] text-[var(--color-text-secondary)] mt-3 leading-relaxed">{project.description}</p>
                <div class="mt-4">
                  <p class="font-body text-[13px] text-[var(--color-text-muted)]">
                    <span class="font-semibold">Role:</span> {project.role}
                  </p>
                  <div class="flex flex-wrap gap-2 mt-3">
                    {project.stack.map((tech) => (
                      <span class="font-body text-[12px] text-[var(--color-text-muted)] bg-[var(--color-secondary)] px-2.5 py-1 rounded">{tech}</span>
                    ))}
                  </div>
                </div>
                <span class="inline-flex items-center font-body text-[14px] text-[var(--color-primary)] font-medium mt-5 group-hover:underline">
                  View Case Study &rarr;
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Project Categories + Grid -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-8 tracking-tight leading-tight">
        All <span class="scribble-circle">Projects</span>
      </h2>

      <!-- Filters -->
      <div class="flex flex-wrap gap-2 mb-10">
        {categories.map((cat, i) => (
          <button class:list={[
            "font-body text-[13px] font-medium px-4 py-2 rounded-full border transition-colors",
            i === 0 ? "bg-[var(--color-primary)] text-white border-[var(--color-primary)]" : "bg-white text-[var(--color-text-secondary)] border-[var(--color-card-border)] hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]"
          ]}>
            {cat}
          </button>
        ))}
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.length > 0 ? (
          projects.map((project) => (
            <a href={`/work/${project.id}`} class="block group">
              <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] overflow-hidden transition-all duration-200 hover:-translate-y-1 hover:shadow-lg">
                <div class="aspect-[4/3] bg-gradient-to-br from-gray-100 to-gray-50 flex items-center justify-center overflow-hidden">
                  {project.data.image ? (
                    <img src={project.data.image} alt={project.data.title} width="400" height="300" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" loading="lazy" />
                  ) : (
                    <span class="font-display italic text-[18px] text-[var(--color-text-muted)]">{project.data.title}</span>
                  )}
                </div>
                <div class="p-5">
                  <p class="font-body text-[11px] font-semibold uppercase tracking-widest text-[var(--color-primary)] mb-1">{project.data.role ?? "Project"}</p>
                  <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">{project.data.title}</h3>
                  <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1.5 leading-relaxed line-clamp-2">{project.data.description}</p>
                  {project.data.technologies.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mt-3">
                      {project.data.technologies.slice(0, 4).map((tech) => (
                        <span class="font-body text-[11px] text-[var(--color-text-muted)] bg-[var(--color-secondary)] px-2 py-0.5 rounded">{tech}</span>
                      ))}
                    </div>
                  )}
                  <span class="inline-flex items-center font-body text-[13px] text-[var(--color-primary)] font-medium mt-3 group-hover:underline">View Case Study &rarr;</span>
                </div>
              </div>
            </a>
          ))
        ) : (
          <>
            <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6">
              <p class="font-body text-[11px] font-semibold uppercase tracking-widest text-[var(--color-primary)] mb-1">Software Engineering</p>
              <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">Case studies being documented</h3>
              <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1.5 leading-relaxed">Project details are being prepared with problem context, architecture decisions and lessons learned.</p>
            </div>
            <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6">
              <p class="font-body text-[11px] font-semibold uppercase tracking-widest text-[var(--color-primary)] mb-1">AI & Automation</p>
              <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">AI experiments coming soon</h3>
              <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1.5 leading-relaxed">Build notes around AI agents, automation and practical AI for African businesses are being organized.</p>
            </div>
            <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6">
              <p class="font-body text-[11px] font-semibold uppercase tracking-widest text-[var(--color-primary)] mb-1">Digital Products</p>
              <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">Product work in review</h3>
              <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1.5 leading-relaxed">Selected digital product work will be published once scope and implementation notes are ready.</p>
            </div>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- How I Build -->
  <section class="py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-4 tracking-tight leading-tight">
        How I <span class="scribble-underline">build</span>
      </h2>
      <p class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] mb-10 max-w-[700px] leading-relaxed">
        I care about more than making software work. I care about understanding the problem, designing systems that can evolve, and creating products that work in the environments they're actually used in.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div>
          <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight mb-2">Understand the problem</h3>
          <p class="font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed">Don't code before understanding what needs solving.</p>
        </div>
        <div>
          <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight mb-2">Design deliberately</h3>
          <p class="font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed">Architecture should support the product rather than complicate it.</p>
        </div>
        <div>
          <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight mb-2">Build for reality</h3>
          <p class="font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed">Consider bandwidth, devices, users, infrastructure and cost.</p>
        </div>
        <div>
          <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight mb-2">Measure</h3>
          <p class="font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed">Performance and outcomes matter.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Technologies -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-10 tracking-tight leading-tight">
        Technologies I work with
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8">
        {Object.entries(techStack).map(([category, techs]) => (
          <div>
            <h3 class="font-body text-[12px] font-semibold uppercase tracking-widest text-[var(--color-primary)] mb-3">{category}</h3>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed">
              {techs.join(" · ")}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-20 md:py-28">
    <div class="max-w-[800px] mx-auto px-4 md:px-10 text-center">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-4 tracking-tight leading-tight">
        Have a problem worth <span class="marker-highlight">building</span> for?
      </h2>
      <p class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] leading-relaxed max-w-[600px] mx-auto">
        I'm interested in ambitious products, meaningful technology problems, AI applications and opportunities to build with people who are trying to create something valuable.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-8 py-3 bg-[var(--color-primary)] text-white font-body text-[16px] font-medium rounded-[10px] hover:bg-[var(--color-primary-hover)] active:scale-95 transition duration-200 mt-8"
      >
        Let's build &rarr;
      </a>
    </div>
  </section>
</PageLayout>

<style>
  .marker-highlight {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }
  .marker-highlight::before {
    content: "";
    position: absolute;
    left: -0.08em;
    right: -0.08em;
    bottom: 0.05em;
    height: 45%;
    background-color: #FFB800;
    border-radius: 20% 5% 15% 8%;
    z-index: -1;
    transform: rotate(-1deg);
  }

  .scribble-circle {
    position: relative;
    display: inline-block;
  }
  .scribble-circle::after {
    content: "";
    position: absolute;
    inset: -18% -12% -22% -12%;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 100' fill='none'><path d='M40 50 C 30 20, 80 8, 130 14 C 180 22, 195 55, 165 78 C 130 95, 60 92, 30 70 C 12 56, 18 32, 50 22' stroke='%2300CEB2' stroke-width='4' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
    z-index: -1;
  }

  .scribble-underline {
    position: relative;
    display: inline-block;
  }
  .scribble-underline::after {
    content: "";
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: -14px;
    height: 12px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 14' fill='none' preserveAspectRatio='none'><path d='M3 9 C 50 3, 110 12, 197 5' stroke='%231BB6F9' stroke-width='6' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
