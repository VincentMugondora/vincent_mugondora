---
import ArticleLayout from "@layouts/ArticleLayout.astro";
import { getCollection, render } from "astro:content";
import { env } from "cloudflare:workers";
import { eq } from "drizzle-orm";
import { getDb } from "@lib/db";
import { posts as postsTable } from "../../../db/schema";
import { marked } from "marked";
import { formatDate } from "@lib/utils";
import { siteConfig } from "@config/site";
import { getBreadcrumbJsonLd, getFAQJsonLd, getSpeakableJsonLd, getHowToJsonLd } from "@/lib/seo";
import TableOfContents from "@components/writing/TableOfContents.astro";

export const prerender = false;

const { slug } = Astro.params;

// Try content collection first (existing markdown posts with rich data)
const allFilePosts = await getCollection("posts");
const filePost = allFilePosts.find((p) => p.id === slug && !p.data.draft);

// Try database
let dbPost: any = null;
try {
  const db = getDb(env.DB);
  const results = await db.select().from(postsTable).where(eq(postsTable.slug, slug!)).all();
  if (results.length > 0 && !results[0].draft) {
    dbPost = results[0];
  }
} catch (e) {
  // DB unavailable
}

if (!filePost && !dbPost) {
  return Astro.redirect("/404");
}

// Determine data source
const isFilePost = !!filePost;
const title = isFilePost ? filePost.data.title : dbPost.title;
const description = isFilePost ? filePost.data.description : dbPost.description;
const category = isFilePost ? filePost.data.category : dbPost.category;
const publishedAt = isFilePost ? filePost.data.publishedAt : new Date(dbPost.publishedAt);
const updatedAt = isFilePost ? filePost.data.updatedAt : (dbPost.updatedAt ? new Date(dbPost.updatedAt) : undefined);
const image = isFilePost ? filePost.data.image : dbPost.image;

// Render content
let renderedContent = "";
let FileContent: any = null;
let headings: any[] = [];
if (isFilePost) {
  const rendered = await render(filePost);
  FileContent = rendered.Content;
  headings = rendered.headings;
} else {
  // Database posts don't automatically generate headings without parsing markdown manually
  renderedContent = await marked(dbPost.content);
}

// Related posts (from both sources)
interface RelatedPost {
  slug: string;
  title: string;
  description: string;
  category: string;
  publishedAt: Date;
}

const relatedPosts: RelatedPost[] = [];

// File-based related posts
allFilePosts
  .filter((p) => !p.data.draft && p.id !== slug)
  .forEach((p) => {
    relatedPosts.push({
      slug: p.id,
      title: p.data.title,
      description: p.data.description,
      category: p.data.category,
      publishedAt: p.data.publishedAt,
    });
  });

// DB related posts
try {
  const db = getDb(env.DB);
  const dbPosts = await db.select().from(postsTable).where(eq(postsTable.draft, false)).all();
  dbPosts
    .filter((p) => p.slug !== slug)
    .forEach((p) => {
      if (!relatedPosts.find((r) => r.slug === p.slug)) {
        relatedPosts.push({
          slug: p.slug,
          title: p.title,
          description: p.description,
          category: p.category,
          publishedAt: new Date(p.publishedAt),
        });
      }
    });
} catch (e) {}

const sortedRelated = relatedPosts
  .sort((a, b) => {
    const sameCategory = (p: RelatedPost) => p.category === category;
    if (sameCategory(a) && !sameCategory(b)) return -1;
    if (!sameCategory(a) && sameCategory(b)) return 1;
    return b.publishedAt.getTime() - a.publishedAt.getTime();
  })
  .slice(0, 3);

const breadcrumbs = getBreadcrumbJsonLd([
  { name: "Home", url: siteConfig.url },
  { name: "Writing", url: `${siteConfig.url}/writing` },
  { name: title, url: `${siteConfig.url}/writing/${slug}` },
]);

const speakableJsonLd = getSpeakableJsonLd({
  url: `${siteConfig.url}/writing/${slug}`,
  title,
});

const faqsBySlug: Record<string, Array<{question: string, answer: string}>> = {
  "ai-agents-explained-for-beginners": [
    {
      question: "What is an AI agent and how does it work?",
      answer: "An AI agent is software that receives a goal, plans how to achieve it, takes actions using tools (like APIs, databases, or email), and evaluates the results - repeating until the task is complete. Unlike a chatbot that just answers questions, an agent actively completes multi-step tasks on your behalf.",
    },
    {
      question: "What does it mean to create an AI agent?",
      answer: "Creating an AI agent means building software that combines a language model (for reasoning and planning) with tools (for taking real-world actions) and memory (for maintaining context). You define what the agent can do, connect it to the systems it needs, and give it clear instructions about its purpose.",
    },
    {
      question: "What are AI agents and how do they work?",
      answer: "AI agents are autonomous software programs that use artificial intelligence to complete tasks without step-by-step human guidance. They work in a think-act-observe loop: the AI reasons about what to do next, uses a tool to take action, observes the result, and repeats until the goal is achieved.",
    },
  ],
  "ai-agents-vs-chatbots": [
    {
      question: "What is the difference between an AI agent and a chatbot?",
      answer: "A chatbot responds to messages - you ask a question, it gives an answer. An AI agent completes tasks autonomously - you give it a goal, and it plans steps, uses tools, and takes actions to achieve it. Chatbots are reactive and single-turn; agents are proactive and multi-step.",
    },
