---
import ArticleLayout from "@layouts/ArticleLayout.astro";
import Container from "@components/ui/Container.astro";
import { getCollection } from "astro:content";
import { formatDate } from "@lib/utils";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<ArticleLayout title={post.data.title} description={post.data.description} image={post.data.image}>
  <header class="not-prose mb-12">
    <div class="flex items-center gap-3">
      <span class="rounded-full bg-midnight/5 px-3 py-1 font-mono text-xs text-muted">
        {post.data.category.replace("-", " ")}
      </span>
      <time class="font-mono text-xs text-muted" datetime={post.data.publishedAt.toISOString()}>
        {formatDate(post.data.publishedAt)}
      </time>
    </div>
    <h1 class="mt-6 font-heading text-4xl font-bold text-midnight lg:text-5xl">
      {post.data.title}
    </h1>
    <p class="mt-4 text-lg text-muted">{post.data.description}</p>
  </header>
  <Content />
</ArticleLayout>
