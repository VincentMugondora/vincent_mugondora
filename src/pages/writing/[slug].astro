const howToData = howToBySlug[slug!];
const howToJsonLd = howToData ? getHowToJsonLd({
  ...howToData,
  url: `${siteConfig.url}/writing/${slug}`,
}) : null;
---

<ArticleLayout
  title={title}
  description={description}
  image={image}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  category={category}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(speakableJsonLd)} />
  {faqJsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  )}
  {howToJsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
  )}

  <header class="not-prose mb-12">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/writing">Writing</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>
    <div class="flex items-center gap-3 mt-4">
      <span class="font-body text-[11px] font-semibold uppercase tracking-widest text-[var(--color-primary)]">
        {category.replace("-", " ")}
      </span>
      <time class="font-body text-[12px] text-[var(--color-text-muted)]" datetime={publishedAt.toISOString()}>
        {formatDate(publishedAt)}
      </time>
      {updatedAt && (
        <span class="font-body text-[12px] text-[var(--color-text-muted)]">
          (Updated {formatDate(updatedAt)})
        </span>
      )}
    </div>
    <h1 class="font-display italic text-[36px] md:text-[48px] lg:text-[56px] font-bold text-[var(--color-text-primary)] tracking-tight leading-tight mt-5">
      {title}
    </h1>
    <p data-speakable class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] mt-4 leading-relaxed">{description}</p>
    <div class="mt-6 flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-full bg-[var(--color-primary)] text-sm font-semibold text-white">V</div>
      <div>
        <p class="font-body text-[14px] font-medium text-[var(--color-text-primary)]">Vincent Mugondora</p>
        <p class="font-body text-[12px] text-[var(--color-text-muted)]">Software Developer & AI Builder</p>
      </div>
    </div>
  </header>

  {headings.length > 0 && <TableOfContents headings={headings} />}

  {FileContent ? (
    <FileContent />
  ) : (
    <Fragment set:html={renderedContent} />
  )}

  {sortedRelated.length > 0 && (
    <aside class="not-prose mt-16 pt-10 border-t border-[var(--color-card-border)]">
      <h2 class="font-display italic text-[28px] md:text-[32px] font-bold text-[var(--color-text-primary)] tracking-tight mb-6">Continue Reading</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {sortedRelated.map((related) => (
          <a href={`/writing/${related.slug}`} class="block p-5 rounded-[12px] border border-[var(--color-card-border)] hover:-translate-y-0.5 hover:shadow-md transition duration-200">
            <span class="font-body text-[11px] font-semibold uppercase tracking-widest text-[var(--color-primary)]">{related.category.replace("-", " ")}</span>
            <h3 class="font-display italic text-[16px] font-bold text-[var(--color-text-primary)] tracking-tight leading-snug mt-2">{related.title}</h3>
            <p class="font-body text-[13px] text-[var(--color-text-secondary)] mt-1.5 leading-relaxed line-clamp-2">{related.description}</p>
          </a>
        ))}
      </div>
    </aside>
  )}
</ArticleLayout>

<style>
  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .breadcrumb li:not(:last-child)::after {
    content: "/";
    margin-left: 0.25rem;
    color: var(--color-card-border);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .breadcrumb [aria-current="page"] {
    color: var(--color-text-secondary);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 30ch;
  }
</style>
