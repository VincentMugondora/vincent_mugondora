---
import PageLayout from "@layouts/PageLayout.astro";
import { siteConfig } from "@config/site";

const reasons = [
  { icon: "code", title: "Build something", description: "Websites, software, AI products, prototypes" },
  { icon: "bot", title: "AI & Innovation", description: "AI ideas, automation, emerging technology" },
  { icon: "school", title: "Teaching & Training", description: "Workshops, coding programs, mentorship" },
  { icon: "mic", title: "Speaking", description: "Technology, AI, engineering, African innovation" },
  { icon: "handshake", title: "Collaboration", description: "Projects, startups, hackathons, research" },
  { icon: "lightbulb", title: "Just an idea", description: "Something interesting worth exploring" },
];

const availability = [
  "Interesting technology projects",
  "AI collaborations",
  "Speaking opportunities",
  "Teaching and training",
  "African technology initiatives",
];
---

<PageLayout title="Let's Talk" description="Get in touch with Vincent Mugondora for software development, AI solutions, speaking, teaching, or collaboration.">
  <!-- Hero -->
  <section class="pt-[72px] py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10 text-center">
      <h1 class="font-display italic text-[48px] md:text-[72px] lg:text-[96px] text-[var(--color-text-primary)] leading-[1.05] font-bold tracking-tight">
        Let's <span class="marker-highlight">Talk</span>.
      </h1>
      <p class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] mt-4 max-w-[600px] mx-auto leading-relaxed">
        Have an idea, problem, opportunity, or project worth exploring? Ideas start with conversations.
      </p>
    </div>
  </section>

  <!-- Reasons to Contact -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-10 tracking-tight leading-tight text-center">
        What can we <span class="scribble-circle">talk</span> about?
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {reasons.map((reason) => (
          <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 hover:-translate-y-0.5 hover:shadow-md transition duration-200">
            <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">{reason.title}</h3>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-2 leading-relaxed">{reason.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="py-16 md:py-24">
    <div class="max-w-[640px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-8 tracking-tight leading-tight">
        Tell me what's on your <span class="scribble-underline">mind</span>
      </h2>

      <form action="https://formspree.io/f/placeholder" method="POST" class="space-y-5">
        <div>
          <label class="font-body text-[13px] font-medium text-[var(--color-text-primary)] block mb-1.5">Name</label>
          <input
            type="text"
            name="name"
            required
            class="w-full font-body text-[15px] text-[var(--color-text-primary)] bg-white border border-[var(--color-card-border)] rounded-[10px] px-4 py-3 outline-none focus:border-[var(--color-primary)] transition-colors"
            placeholder="Your name"
          />
        </div>
        <div>
          <label class="font-body text-[13px] font-medium text-[var(--color-text-primary)] block mb-1.5">Email</label>
          <input
            type="email"
            name="email"
            required
            class="w-full font-body text-[15px] text-[var(--color-text-primary)] bg-white border border-[var(--color-card-border)] rounded-[10px] px-4 py-3 outline-none focus:border-[var(--color-primary)] transition-colors"
            placeholder="you@email.com"
          />
        </div>
        <div>
          <label class="font-body text-[13px] font-medium text-[var(--color-text-primary)] block mb-1.5">What would you like to discuss?</label>
          <select
            name="topic"
            class="w-full font-body text-[15px] text-[var(--color-text-primary)] bg-white border border-[var(--color-card-border)] rounded-[10px] px-4 py-3 outline-none focus:border-[var(--color-primary)] transition-colors"
          >
            <option value="">Select a topic</option>
            <option value="build">Build a project</option>
            <option value="ai">AI / Innovation</option>
            <option value="teaching">Teaching / Training</option>
            <option value="speaking">Speaking</option>
            <option value="collaboration">Collaboration</option>
            <option value="other">Something else</option>
          </select>
        </div>
        <div>
          <label class="font-body text-[13px] font-medium text-[var(--color-text-primary)] block mb-1.5">Message</label>
          <textarea
            name="message"
            required
            rows="5"
            class="w-full font-body text-[15px] text-[var(--color-text-primary)] bg-white border border-[var(--color-card-border)] rounded-[10px] px-4 py-3 outline-none focus:border-[var(--color-primary)] transition-colors resize-y"
            placeholder="Tell me about your idea, project, or question..."
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full inline-flex items-center justify-center px-8 py-3.5 bg-[var(--color-primary)] text-white font-body text-[16px] font-medium rounded-[10px] hover:bg-[var(--color-primary-hover)] active:scale-[0.98] transition duration-200"
        >
          Start the conversation &rarr;
        </button>
      </form>
    </div>
  </section>

  <!-- Have an idea? -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[800px] mx-auto px-4 md:px-10 text-center">
      <h2 class="font-display italic text-[32px] md:text-[40px] text-[var(--color-text-primary)] mb-4 tracking-tight leading-tight">
        Have a problem you think technology could <span class="marker-highlight">solve</span>?
      </h2>
      <p class="font-body text-[16px] text-[var(--color-text-secondary)] max-w-[560px] mx-auto leading-relaxed">
        You don't need to have the solution figured out. Tell me about the problem. We can explore whether there's something worth building.
      </p>
    </div>
  </section>

  <!-- Direct Contact & Email -->
  <section class="py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-10 tracking-tight leading-tight">
        Prefer somewhere <span class="scribble-underline">else</span>?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Email -->
        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex flex-col">
          <div class="w-12 h-12 rounded-full bg-[var(--color-secondary)] flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
          </div>
          <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">Email</h3>
          <p class="font-body text-[13px] text-[var(--color-text-secondary)] mt-1">Best way to reach me. I reply within a day.</p>
          <div class="mt-auto pt-4 flex items-center gap-2">
            <a href={`mailto:${siteConfig.email}`} class="font-body text-[14px] text-[var(--color-primary)] font-medium hover:underline">{siteConfig.email}</a>
            <button
              id="copy-email-btn"
              class="p-1.5 rounded-md hover:bg-[var(--color-secondary)] transition-colors text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)]"
              title="Copy email"
              data-email={siteConfig.email}
            >
              <svg id="copy-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              <svg id="check-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </button>
          </div>
        </div>

        <!-- WhatsApp -->
        <a
          href="https://wa.me/263777530322?text=Hi%20Vincent%2C%20I'd%20like%20to%20discuss%20a%20project"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex flex-col hover:border-[var(--color-primary)] transition-colors"
        >
          <div class="w-12 h-12 rounded-full bg-[var(--color-secondary)] flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
            </svg>
          </div>
          <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">WhatsApp</h3>
          <p class="font-body text-[13px] text-[var(--color-text-secondary)] mt-1">Quick chats or follow-ups. Available GMT+2.</p>
          <p class="font-body text-[14px] text-[var(--color-primary)] font-medium mt-auto pt-4">+263 777 530 322</p>
        </a>

        <!-- LinkedIn -->
        <a
          href={siteConfig.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex flex-col hover:border-[var(--color-primary)] transition-colors"
        >
          <div class="w-12 h-12 rounded-full bg-[var(--color-secondary)] flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
            </svg>
          </div>
          <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">LinkedIn</h3>
          <p class="font-body text-[13px] text-[var(--color-text-secondary)] mt-1">Connect professionally or say hello.</p>
          <p class="font-body text-[14px] text-[var(--color-primary)] font-medium mt-auto pt-4">Vincent Mugondora &nearr;</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Availability -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[32px] md:text-[40px] text-[var(--color-text-primary)] mb-6 tracking-tight leading-tight">
        Currently open to
      </h2>
      <div class="flex flex-wrap gap-3">
        {availability.map((item) => (
          <span class="font-body text-[14px] text-[var(--color-text-primary)] bg-white border border-[var(--color-card-border)] px-4 py-2 rounded-full">
            {item}
          </span>
        ))}
      </div>
      <p class="font-body text-[14px] text-[var(--color-text-muted)] mt-6">
        Based in Zimbabwe &middot; Building for Africa &middot; Open to the world
      </p>
    </div>
  </section>
</PageLayout>

<style>
  .marker-highlight {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }
  .marker-highlight::before {
    content: "";
    position: absolute;
    left: -0.08em;
    right: -0.08em;
    bottom: 0.05em;
    height: 45%;
    background-color: #FFB800;
    border-radius: 20% 5% 15% 8%;
    z-index: -1;
    transform: rotate(-1deg);
  }

  .scribble-circle {
    position: relative;
    display: inline-block;
  }
  .scribble-circle::after {
    content: "";
    position: absolute;
    inset: -18% -12% -22% -12%;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 100' fill='none'><path d='M40 50 C 30 20, 80 8, 130 14 C 180 22, 195 55, 165 78 C 130 95, 60 92, 30 70 C 12 56, 18 32, 50 22' stroke='%2300CEB2' stroke-width='4' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
    z-index: -1;
  }

  .scribble-underline {
    position: relative;
    display: inline-block;
  }
  .scribble-underline::after {
    content: "";
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: -14px;
    height: 12px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 14' fill='none' preserveAspectRatio='none'><path d='M3 9 C 50 3, 110 12, 197 5' stroke='%231BB6F9' stroke-width='6' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
  }
</style>

<script is:inline>
  (function() {
    const btn = document.getElementById('copy-email-btn');
    if (btn) {
      btn.addEventListener('click', async function() {
        const email = btn.getAttribute('data-email');
        try {
          await navigator.clipboard.writeText(email);
        } catch (err) {
          const ta = document.createElement('textarea');
          ta.value = email;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        }
        document.getElementById('copy-icon').classList.add('hidden');
        document.getElementById('check-icon').classList.remove('hidden');
        setTimeout(function() {
          document.getElementById('copy-icon').classList.remove('hidden');
          document.getElementById('check-icon').classList.add('hidden');
        }, 2000);
      });
    }
  })();
</script>
