---
import PageLayout from "@layouts/PageLayout.astro";
import { siteConfig } from "@config/site";
---

<PageLayout title="Contact Vincent Mugondora" description="Get in touch with Vincent Mugondora for software development, AI solutions, speaking, or collaboration.">
  <main class="pt-[72px]">
    <!-- Hero -->
    <section class="max-w-[1200px] mx-auto px-6 md:px-10 py-16 md:py-24 text-center">
      <h1 class="font-[var(--font-display)] text-[48px] md:text-[64px] lg:text-[96px] text-[var(--color-text-primary)] leading-[1.1]">
        Got something you're
        <br />
        <span class="relative inline-block">
          <span class="relative z-10">working</span>
          <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[115%] h-[0.9em] max-w-none pointer-events-none z-0 rounded-[50%] border-[3px] border-[var(--color-primary)]"></span>
        </span>{" "}
        on?
      </h1>

      <p class="font-[var(--font-body)] text-[18px] text-[var(--color-text-secondary)] mt-6 max-w-[600px] mx-auto">
        I'm always open to new ideas, collaborations, or problems that need solving.
        Send me a message and I'll get back to you within a day.
      </p>

      <div class="mt-8">
        <span class="inline-block font-[var(--font-display)] text-[16px] text-[var(--color-text-muted)] border border-[var(--color-card-border)] rounded-full px-4 py-1">
          Best way to reach me
        </span>
      </div>

      <div class="inline-flex items-center gap-3 mt-4">
        <a
          href={`mailto:${siteConfig.email}`}
          class="font-[var(--font-display)] text-[24px] md:text-[32px] text-[var(--color-text-primary)] hover:text-[var(--color-primary)] transition-colors cursor-pointer"
        >
          {siteConfig.email}
        </a>
        <button
          id="copy-email-btn"
          class="inline-flex items-center justify-center p-2 rounded-lg hover:bg-[var(--color-secondary)] transition-colors duration-200 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]"
          title="Copy email address"
          data-email={siteConfig.email}
        >
          <svg id="copy-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <svg id="check-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path class="text-[var(--color-primary)]" d="M20 6 9 17l-5-5"/></svg>
        </button>
      </div>

      <!-- Service tags -->
      <div class="flex flex-wrap items-center justify-center gap-y-4 gap-x-8 mt-10">
        <div class="flex items-center gap-1.5 font-[var(--font-body)] text-[13px] text-[var(--color-text-secondary)]">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FAB130" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>
          Software Development
        </div>
        <div class="flex items-center gap-1.5 font-[var(--font-body)] text-[13px] text-[var(--color-text-secondary)]">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1BB6F9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
          AI Solutions
        </div>
        <div class="flex items-center gap-1.5 font-[var(--font-body)] text-[13px] text-[var(--color-text-secondary)]">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#724B68" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
          Web Applications
        </div>
        <div class="flex items-center gap-1.5 font-[var(--font-body)] text-[13px] text-[var(--color-text-secondary)]">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00CEB2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          Technology Education
        </div>
        <div class="flex items-center gap-1.5 font-[var(--font-body)] text-[13px] text-[var(--color-text-secondary)]">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FD787D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
          Technical Consulting
        </div>
      </div>
    </section>

    <!-- Other ways section -->
    <section class="max-w-[1200px] mx-auto px-6 md:px-10 py-8 md:py-16">
      <h2 class="font-[var(--font-display)] text-[36px] md:text-[48px] text-[var(--color-text-primary)]">
        Other ways to{" "}
        <span class="relative inline-block">
          <span class="relative z-10">reach</span>
          <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[0.9em] max-w-none pointer-events-none z-0 rounded-[50%] border-[3px] border-[var(--color-primary)]"></span>
        </span>{" "}
        me.
      </h2>
      <p class="font-[var(--font-body)] text-[16px] text-[var(--color-text-secondary)] mt-2">
        Email is best, but if you prefer something else, here are a few options.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10 items-stretch">
        <!-- Phone -->
        <a
          href="https://wa.me/263777530322?text=Hi%20Vincent%2C%20I'd%20like%20to%20discuss%20a%20project"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex flex-col h-full min-h-[440px] hover:border-[var(--color-primary)] transition-colors"
        >
          <div class="h-[180px] flex items-start">
            <div class="w-14 h-14 rounded-full bg-[var(--color-secondary)] flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
          </div>
          <div class="mt-auto">
            <p class="font-[var(--font-body)] text-[16px] text-[var(--color-text-primary)] font-medium">+263 777 530 322</p>
            <h3 class="font-[var(--font-display)] text-[22px] font-bold text-[var(--color-text-primary)] italic mt-1">Phone / WhatsApp</h3>
            <ul class="font-[var(--font-body)] text-[14px] text-[var(--color-text-secondary)] mt-3 space-y-1 list-disc list-inside">
              <li>Best for quick chats or follow-ups.</li>
              <li>Available during GMT+2 hours.</li>
            </ul>
          </div>
        </a>

        <!-- LinkedIn -->
        <a
          href={siteConfig.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex flex-col h-full min-h-[440px] hover:border-[var(--color-primary)] transition-colors"
        >
          <div class="h-[180px] flex items-start">
            <div class="w-14 h-14 rounded-full bg-[var(--color-secondary)] flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            </div>
          </div>
          <div class="mt-auto">
            <span class="font-[var(--font-body)] text-[16px] text-[var(--color-primary)] underline font-medium">Vincent Mugondora</span>
            <h3 class="font-[var(--font-display)] text-[22px] font-bold text-[var(--color-text-primary)] italic mt-1">LinkedIn</h3>
            <ul class="font-[var(--font-body)] text-[14px] text-[var(--color-text-secondary)] mt-3 space-y-1 list-disc list-inside">
              <li>Connect professionally or just say hi.</li>
              <li>I check in a few times a week.</li>
            </ul>
          </div>
        </a>

        <!-- GitHub -->
        <a
          href={siteConfig.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex flex-col h-full min-h-[440px] hover:border-[var(--color-primary)] transition-colors"
        >
          <div class="h-[180px] flex items-start">
            <div class="w-14 h-14 rounded-full bg-[var(--color-secondary)] flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            </div>
          </div>
          <div class="mt-auto">
            <span class="font-[var(--font-body)] text-[16px] text-[var(--color-text-primary)] font-medium">View Projects</span>
            <h3 class="font-[var(--font-display)] text-[22px] font-bold text-[var(--color-text-primary)] italic mt-1">GitHub</h3>
            <ul class="font-[var(--font-body)] text-[14px] text-[var(--color-text-secondary)] mt-3 space-y-1 list-disc list-inside">
              <li>Open-source work and side projects.</li>
              <li>See how I write and structure code.</li>
            </ul>
          </div>
        </a>
      </div>
    </section>

    <!-- CTA Banner -->
    <section class="max-w-[1200px] mx-auto px-6 md:px-10 py-8 md:py-16">
      <div class="bg-[var(--color-footer)] rounded-[24px] px-8 md:px-16 py-12 md:py-16 text-center">
        <h2 class="font-[var(--font-display)] text-[36px] md:text-[48px] text-white">
          Currently <span class="text-[var(--color-highlight-yellow)]">open</span> to new work.
        </h2>
        <p class="font-[var(--font-body)] text-[16px] text-gray-300 mt-4 max-w-[600px] mx-auto">
          I'm available for freelance projects, contract roles, or ongoing work. I enjoy working with teams that care about building things properly and keeping things simple.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3 mt-6">
          <span class="font-[var(--font-body)] text-[13px] text-gray-300 border border-gray-500 rounded-full px-4 py-1.5">Open to projects</span>
          <span class="font-[var(--font-body)] text-[13px] text-gray-300 border border-gray-500 rounded-full px-4 py-1.5">Remote or hybrid</span>
          <span class="font-[var(--font-body)] text-[13px] text-gray-300 border border-gray-500 rounded-full px-4 py-1.5">Contract or freelance</span>
          <span class="font-[var(--font-body)] text-[13px] text-gray-300 border border-gray-500 rounded-full px-4 py-1.5">Flexible hours (GMT+2)</span>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-4 mt-8">
          <a
            href={`mailto:${siteConfig.email}`}
            class="inline-flex w-full max-w-[320px] items-center justify-center h-[48px] bg-white text-[var(--color-footer)] font-[var(--font-body)] text-[16px] font-medium rounded-[10px] hover:bg-gray-100 transition-colors duration-200 md:w-[220px] md:max-w-none"
          >
            Send me an email
          </a>
          <a
            href="/about"
            class="inline-flex w-full max-w-[320px] items-center justify-center h-[48px] border border-white text-white font-[var(--font-body)] text-[16px] font-medium rounded-[10px] hover:bg-white hover:text-[var(--color-footer)] transition-colors duration-200 md:w-[220px] md:max-w-none"
          >
            Learn More
          </a>
        </div>
      </div>
    </section>
  </main>
</PageLayout>

<script is:inline>
  (function() {
    const btn = document.getElementById('copy-email-btn');
    if (btn) {
      btn.addEventListener('click', async function() {
        const email = btn.getAttribute('data-email');
        try {
          await navigator.clipboard.writeText(email);
        } catch (err) {
          const ta = document.createElement('textarea');
          ta.value = email;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        }
        document.getElementById('copy-icon').classList.add('hidden');
        document.getElementById('check-icon').classList.remove('hidden');
        setTimeout(function() {
          document.getElementById('copy-icon').classList.remove('hidden');
          document.getElementById('check-icon').classList.add('hidden');
        }, 2000);
      });
    }
  })();
</script>
