---
import PageLayout from "@layouts/PageLayout.astro";
import { Image } from "astro:assets";
import heroImage from "@/assets/vincent.avif";
---

<PageLayout>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__badge">Software Developer &bull; AI Builder</div>
        <h1 class="hero__title">
          <span class="hero__title-first">Vincent</span>
          <span class="hero__title-last">Mugondora</span>
        </h1>
        <p class="hero__tagline">Build better software, faster.</p>
        <div class="hero__actions">
          <a class="hero__btn hero__btn--dark" href="/work">View Work</a>
          <a class="hero__btn hero__btn--orange" href="/contact">Let's Work Together</a>
        </div>
      </div>
      <div class="hero__media">
        <div class="hero__image-frame">
          <Image
            src={heroImage}
            alt="Vincent Mugondora"
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 33vw"
            loading="eager"
            fetchpriority="high"
            class="hero__img"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Credibility Strip -->
  <section class="credibility-strip" aria-label="Core values">
    <div class="credibility-strip__track">
      <span>Building</span>
      <span class="credibility-strip__dot">&bull;</span>
      <span>Teaching</span>
      <span class="credibility-strip__dot">&bull;</span>
      <span>Learning</span>
      <span class="credibility-strip__dot">&bull;</span>
      <span>Sharing</span>
      <span class="credibility-strip__dot">&bull;</span>
      <span>Building</span>
      <span class="credibility-strip__dot">&bull;</span>
      <span>Teaching</span>
      <span class="credibility-strip__dot">&bull;</span>
      <span>Learning</span>
      <span class="credibility-strip__dot">&bull;</span>
      <span>Sharing</span>
    </div>
  </section>

  <!-- What I Do -->
  <section class="what-i-do" id="services">
    <div class="section-container">
      <div class="section-header">
        <div class="section-header__left">
          <div class="section-number section-number--orange">01</div>
          <h2 class="section-title">What I Do</h2>
        </div>
        <p class="section-subtitle">Solving problems through code and communication.</p>
      </div>

      <div class="services-grid">
        <div class="service-card">
          <div class="service-card__icon">💻</div>
          <h3 class="service-card__title">Software Development</h3>
          <p class="service-card__text">Building robust, scalable applications from frontend interfaces to backend systems.</p>
          <div class="service-card__bar"></div>
        </div>

        <div class="service-card service-card--dark">
          <div class="service-card__glow"></div>
          <div class="service-card__icon">🤖</div>
          <h3 class="service-card__title">AI Solutions</h3>
          <p class="service-card__text">Integrating machine learning models and LLMs to automate tasks and extract insights.</p>
          <div class="service-card__bar"></div>
        </div>

        <div class="service-card">
          <div class="service-card__icon">🎓</div>
          <h3 class="service-card__title">Technology Education</h3>
          <p class="service-card__text">Translating complex technical concepts into accessible knowledge for teams and students.</p>
          <div class="service-card__bar"></div>
        </div>

        <div class="service-card service-card--accent">
          <div class="service-card__icon">🧠</div>
          <h3 class="service-card__title">Technical Thinking</h3>
          <p class="service-card__text">System architecture, database design, and strategic technical consulting.</p>
          <div class="service-card__bar"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Work -->
  <section class="featured-work" id="work">
    <div class="section-container">
      <div class="section-header section-header--dark">
        <div class="section-header__left">
          <div class="section-number section-number--orange-rotated">02</div>
          <h2 class="section-title">Featured Work</h2>
        </div>
        <p class="section-subtitle section-subtitle--dark">In-depth looks at solving real problems.</p>
      </div>

      <div class="projects">
        <!-- Project 1 -->
        <div class="project project--reversed">
          <div class="project__info">
            <h3 class="project__title">Enterprise Data Pipeline</h3>
            <div class="project__tags">
              <span>// Backend</span>
              <span>// Data Eng</span>
              <span>// Python</span>
            </div>
            <p class="project__desc">Architected a high-throughput data processing pipeline capable of handling millions of events daily, reducing data latency by 80% and providing real-time analytics dashboards for stakeholders.</p>
            <a class="project__link" href="#">Read Case Study <span>↗</span></a>
          </div>
          <div class="project__image">
            <div class="project__image-frame">
              <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBn8aa-s8msfW66PtWCc8RioHqn2_Dfo7N0wVF44yKSfLkkXp8kELj0s8MvGzrJfAp2Q6jksu4pMtlU-vOKdBVxoK7PSdpC_X3G8BC7KqhpM0qCTiVnO6vYCPYppxtxhhUMaYuqAXjJuPCCsSTkcq3gct79Esqnk1awiC_E6QGjAsW2pCQ19w_KmbFMvdOuo95GyEAspOfFQDdCWmEsYmFHSCdfqwscO4fq1f1EokfOUvVfrl7vYsQCSA" alt="Enterprise Data Pipeline project" loading="lazy" />
            </div>
          </div>
        </div>

        <!-- Project 2 -->
        <div class="project">
          <div class="project__image">
            <div class="project__image-frame">
              <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuDFdTI-V7ZD5hNZLzi9g2_sJTSiCQ8ZOcBWYA2A_OyGVB3N3m43m_kO9uCOndvLBiVZ-0rCnBH9lk42Px14TiYOl7dkiEk59vKXLgevx6S7fLYDOi9GzIJPZfGdTYaaOZ5vN1koNvbvrL8u4f9DoaPOegTl3tZqMyCP-8oLxquxp39UaOz6klrICT1TH5BvasXMFb0ODWaXAmaQvGsZtvoPioP6jg6Y6u9ExMVcvaxESabjyp0J01VqQw" alt="AI Customer Service Bot project" loading="lazy" />
            </div>
          </div>
          <div class="project__info">
            <h3 class="project__title">AI Customer Service Bot</h3>
            <div class="project__tags">
              <span>// AI / LLM</span>
              <span>// Fullstack</span>
              <span>// TypeScript</span>
            </div>
            <p class="project__desc">Integrated custom-trained LLMs into an existing customer support workflow. The solution automated 40% of tier-1 support tickets while maintaining a 95% customer satisfaction rating.</p>
            <a class="project__link" href="#">Read Case Study <span>↗</span></a>
          </div>
        </div>

        <!-- Project 3 -->
        <div class="project project--reversed">
          <div class="project__info">
            <h3 class="project__title">SaaS Platform Architecture</h3>
            <div class="project__tags">
              <span>// Architecture</span>
              <span>// React</span>
              <span>// Node.js</span>
            </div>
            <p class="project__desc">Led the technical rewrite of a legacy monolithic application into a microservices-based SaaS platform, improving developer velocity and system reliability across a global user base.</p>
            <a class="project__link" href="#">Read Case Study <span>↗</span></a>
          </div>
          <div class="project__image">
            <div class="project__image-frame">
              <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuB3nm5Hvu_MrEY4FPF_2Vh-H4IQsTDbBdp2KyLC35uhJCrSQ4tDAFG0PiTdbJ4_-COpiJNkPlHeVytaD-CGLIzQq7tzTGHLUlSOHz7AJe6CVqkMparI3sTGk7_EiS_w7J5BTvLNRITHmjEECWnc_LHWgzzz3duzFob6uFofb9OaX4EDMFzib7X0pCnUbppjPoquGq30nyRw29H_M-zB1G1ST6jLj3xwN3T9M4NJ6Y0WYzAbj2q1YkzrbA" alt="SaaS Platform Architecture project" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How I Think -->
  <section class="how-i-think">
    <div class="how-i-think__bg" aria-hidden="true">THINK</div>
    <div class="how-i-think__inner">
      <h2 class="how-i-think__title">I don't just build.<br/>I investigate.</h2>
      <p class="how-i-think__subtitle">Great software isn't just written; it's discovered through careful inquiry and robust architecture.</p>

      <div class="philosophy-grid">
        <div class="philosophy-card">
          <div class="philosophy-card__number">01</div>
          <h4 class="philosophy-card__title">Understand the Problem</h4>
          <p class="philosophy-card__text">Code is the last step. I start by asking 'why' until the actual business need is exposed.</p>
        </div>
        <div class="philosophy-card">
          <div class="philosophy-card__number">02</div>
          <h4 class="philosophy-card__title">Design for Reality</h4>
          <p class="philosophy-card__text">Perfect architecture rarely survives contact with production. I build resilient, pragmatic systems.</p>
        </div>
        <div class="philosophy-card">
          <div class="philosophy-card__number">03</div>
          <h4 class="philosophy-card__title">Learn in Public</h4>
          <p class="philosophy-card__text">Sharing knowledge reinforces understanding. I document my process to help others grow.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Expertise -->
  <section class="expertise" id="expertise">
    <div class="section-container">
      <div class="section-header">
        <div class="section-header__left">
          <div class="section-number section-number--dark">03</div>
          <h2 class="section-title">Expertise</h2>
        </div>
        <p class="section-subtitle">Tools of the trade.</p>
      </div>

      <div class="expertise-grid">
        <div class="expertise-card">
          <h4 class="expertise-card__heading">Languages</h4>
          <ul>
            <li>JavaScript</li>
            <li>TypeScript</li>
            <li>Python</li>
            <li>Go</li>
          </ul>
        </div>
        <div class="expertise-card">
          <h4 class="expertise-card__heading">Frontend</h4>
          <ul>
            <li>React / Next.js</li>
            <li>Vue.js</li>
            <li>Tailwind CSS</li>
            <li>Web Components</li>
          </ul>
        </div>
        <div class="expertise-card">
          <h4 class="expertise-card__heading">Backend</h4>
          <ul>
            <li>Node.js</li>
            <li>Django / FastAPI</li>
            <li>Express</li>
            <li>REST / GraphQL</li>
          </ul>
        </div>
        <div class="expertise-card expertise-card--accent">
          <h4 class="expertise-card__heading expertise-card__heading--accent">AI / ML</h4>
          <ul>
            <li>OpenAI API</li>
            <li>LangChain</li>
            <li>Vector DBs</li>
            <li>Custom LLMs</li>
          </ul>
        </div>
        <div class="expertise-card">
          <h4 class="expertise-card__heading">Data</h4>
          <ul>
            <li>PostgreSQL</li>
            <li>MongoDB</li>
            <li>Redis</li>
            <li>Snowflake</li>
          </ul>
        </div>
        <div class="expertise-card">
          <h4 class="expertise-card__heading">Engineering</h4>
          <ul>
            <li>Docker</li>
            <li>AWS / GCP</li>
            <li>CI/CD</li>
            <li>System Design</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Writing -->
  <section class="writing" id="writing">
    <div class="section-container">
      <div class="section-header section-header--dark">
        <div class="section-header__left">
          <div class="section-number section-number--orange-rotated-alt">04</div>
          <h2 class="section-title">Writing</h2>
        </div>
        <p class="section-subtitle section-subtitle--dark">Ideas, Experiments & Lessons.</p>
      </div>

      <div class="articles-grid">
        <a class="article-card" href="#">
          <div class="article-card__image">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBEdHNn9bx-eSfH6HAvi5TzbdZjO5rYsYvJ5_a1EP6_byNUuRMgRpcRQUFSwmZdKLmWM8v4onazoqC-lLZkD_n11RcBrV6qtMo4Dr44diPF32Tlxdto9G17Du6Hkwcexl-iGo2sDo90KIrWFmwvmsvByQ7CT33vq2JPSkbQsX5q0w_n0_GFhAab87-6o0T6b67zdninkH0VOJ2beGi8DmSxjzM81qjV7thywIpceF-HvyY0gF4zM0AAXA" alt="Article about LLMs" loading="lazy" />
          </div>
          <div class="article-card__meta">
            <span>AI Development</span>
            <span>5 Min Read</span>
          </div>
          <h3 class="article-card__title">The Reality of Integrating LLMs into Legacy Codebases</h3>
        </a>

        <a class="article-card" href="#">
          <div class="article-card__image">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCHv8C4OM_lFQ9opfWpDXRKVghhLzJVfyoFJfoIOpoazbwQUt45lsl0jdCSI8ghIJSrm1Abytr8lpNCriDy8VPQ7YIdiwtAse0e1mDNhaCsnJ1_iEMg_nX7ceK-wxH4wF3GpSFDfrzB3snFFY5VDyUFBJpz2P8deJ2kkigPiCYu_0n_c6mHI2m2nzvDC0sTWTaYqaYlUn-Q3EwC0Yo6hEMFAQEk0pp9csMTDOAMeGc7o6gRqRK_IC0VsQ" alt="Article about state management" loading="lazy" />
          </div>
          <div class="article-card__meta">
            <span>Frontend</span>
            <span>8 Min Read</span>
          </div>
          <h3 class="article-card__title">Rethinking State Management in Large React Applications</h3>
        </a>

        <a class="article-card" href="#">
          <div class="article-card__image">
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCH-KjSjQmFo2QWIELWeaN5_MHuoJm0yRPOdhN9iWq3LZ627k0zw0mG-jaiGrUvzYgU1uOHyBJo4stVTox78GLtC5wo9lDYEu6a4ZCtv0Vu_QeZXX45goO1XyczCAfIV_vyDSOQLrsFd33vBM1XnEEIWw6XLWgG-b1TsuC4ZrRDNdGXslQWoz41FozxlCxUNlyUwkiCFzTcSKQ_M9qvD6qWAH6GjWCNVgTytHRY0F84qTiGZIbaW2vGCA" alt="Article about career growth" loading="lazy" />
          </div>
          <div class="article-card__meta">
            <span>Career</span>
            <span>4 Min Read</span>
          </div>
          <h3 class="article-card__title">From Junior to Senior: The Invisible Technical Skills</h3>
        </a>
      </div>

      <div class="writing__cta">
        <a class="writing__cta-btn" href="/writing">View All Articles</a>
      </div>
    </div>
  </section>

  <!-- Teaching -->
  <section class="teaching" id="speaking">
    <div class="teaching__inner">
      <h2 class="teaching__title">I teach technology.</h2>
      <p class="teaching__text">Whether speaking at conferences, running corporate workshops, or creating online courses, I break down complex technical topics so developers can build better.</p>
      <a class="teaching__cta" href="#contact">Book me to speak or teach</a>
    </div>
  </section>

  <!-- About -->
  <section class="about" id="about">
    <div class="about__container">
      <div class="about__image-col">
        <div class="about__image-bg"></div>
        <Image
          src={heroImage}
          alt="Vincent Mugondora"
          widths={[400, 600]}
          sizes="(max-width: 768px) 100vw, 40vw"
          loading="lazy"
          class="about__img"
        />
      </div>
      <div class="about__content">
        <span class="about__label">A Little About Me</span>
        <h2 class="about__title">Software Engineer,<br/>AI Builder, Educator.</h2>
        <div class="about__text">
          <p>I started coding because I loved the idea of building something out of nothing. Over the years, that passion evolved into a deep fascination with system architecture and solving hard business problems through technology.</p>
          <p>Currently, I focus on the intersection of traditional software engineering and artificial intelligence, helping companies integrate cutting-edge AI capabilities into reliable, production-ready applications.</p>
          <p>When I'm not writing code, I'm usually writing about it, teaching it, or trying to figure out how to make technical concepts more accessible to everyone.</p>
        </div>
        <div class="about__links">
          <a href="https://twitter.com/vincemugondora" target="_blank" rel="noopener noreferrer">Twitter ↗</a>
          <a href="https://www.linkedin.com/in/vincemugondora" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a href="https://github.com/vincemugondora" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Vision Quote -->
  <section class="vision-quote">
    <h2 class="vision-quote__text">"Technology should create opportunity."</h2>
  </section>

  <!-- Final CTA -->
  <section class="final-cta" id="contact">
    <div class="final-cta__inner">
      <h2 class="final-cta__title">Have a problem<br/>worth solving?</h2>
      <p class="final-cta__subtitle">Let's build something great together.</p>
      <a class="final-cta__btn" href="mailto:hello@vincentmugondora.com">Start a Conversation</a>
    </div>
  </section>
</PageLayout>

<style>
  /* Grid background utility */
  .grid-bg {
    background-size: 40px 40px;
    background-image:
      linear-gradient(to right, rgba(0, 0, 0, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.05) 1px, transparent 1px);
  }

  .grid-bg-dark {
    background-size: 40px 40px;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
  }

  /* Section shared styles */
  .section-container {
    max-width: 80rem;
    margin: 0 auto;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 4rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    padding-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .section-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .section-header--dark {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .section-header__left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .section-number {
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: #fff;
  }

  .section-number--orange {
    background: var(--color-orange);
    transform: rotate(-6deg);
  }

  .section-number--orange-rotated {
    background: var(--color-orange);
    transform: rotate(6deg);
  }

  .section-number--orange-rotated-alt {
    background: var(--color-orange);
    transform: rotate(3deg);
  }

  .section-number--dark {
    background: #111;
    transform: rotate(-3deg);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 3.75rem;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    margin: 0;
    line-height: 1;
  }

  .section-subtitle {
    font-family: var(--font-mono);
    color: #6b7280;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    max-width: 24rem;
    margin: 0;
  }

  .section-subtitle--dark {
    color: #9ca3af;
  }

  /* ===== HERO ===== */
  .hero {
    min-height: 100vh;
    padding: 8rem 1.5rem 5rem;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    background-size: 40px 40px;
    background-image:
      linear-gradient(to right, rgba(0, 0, 0, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.05) 1px, transparent 1px);
  }

  @media (min-width: 768px) {
    .hero {
      padding: 8rem 3rem 5rem;
    }
  }

  .hero__container {
    max-width: 80rem;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero__container {
      grid-template-columns: 2fr 1fr;
    }
  }

  .hero__badge {
    display: inline-block;
    background: #111;
    color: #fff;
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 0.375rem;
    transform: rotate(-2deg);
    margin-bottom: 1.5rem;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #111;
    margin: 0 0 1rem;
    display: flex;
    flex-direction: column;
  }

  .hero__title-first {
    color: var(--color-orange);
  }

  .hero__tagline {
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 3vw, 1.875rem);
    color: #4b5563;
    max-width: 40rem;
    line-height: 1.4;
    margin: 0 0 2.5rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__btn {
    padding: 1rem 2rem;
    border-radius: 9999px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.875rem;
    text-decoration: none;
    transition: background 0.15s, transform 0.15s;
  }

  .hero__btn:hover {
    transform: translateY(-1px);
  }

  .hero__btn--dark {
    background: #111;
    color: #fff;
  }

  .hero__btn--dark:hover {
    background: #333;
  }

  .hero__btn--orange {
    background: var(--color-orange);
    color: #fff;
    border: 2px solid var(--color-orange);
  }

  .hero__btn--orange:hover {
    background: var(--color-orange-600);
    border-color: var(--color-orange-600);
  }

  .hero__media {
    display: none;
    position: relative;
    height: 24rem;
  }

  @media (min-width: 768px) {
    .hero__media {
      display: block;
    }
  }

  .hero__image-frame {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 1.5rem;
    border: 1px solid rgba(0, 0, 0, 0.1);
    overflow: hidden;
    transform: rotate(3deg);
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
    mix-blend-mode: multiply;
    filter: grayscale(1);
    transition: filter 0.7s;
  }

  .hero__img:hover {
