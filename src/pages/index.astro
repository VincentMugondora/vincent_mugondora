---
import PageLayout from "@layouts/PageLayout.astro";
import { siteConfig } from "@config/site";
---

<PageLayout>
  <!-- Hero Section -->
  <section class="w-full max-w-full overflow-x-hidden pt-[72px] h-[90vh] flex items-center">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10 py-10 md:py-16 text-center box-border w-full">
      <h1 class="font-[var(--font-display)] text-[48px] md:text-[72px] lg:text-[96px] text-[var(--color-text-primary)] leading-[1.05] font-bold italic tracking-tight break-words">
        Hi I'm Vincent Mugondora, a{" "}
        <span class="relative inline-block">
          <span class="relative z-10">Software Developer</span>
          <img
            src="/highlight-marker.svg"
            alt=""
            aria-hidden="true"
            class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[105%] h-[1.1em] max-w-none pointer-events-none -z-10"
          />
        </span>
      </h1>

      <p class="font-[var(--font-body)] text-[18px] text-[var(--color-text-secondary)] mt-6 max-w-full md:max-w-[1100px] mx-auto leading-relaxed">
        I build intelligent software solutions, integrate AI into real-world applications, and teach technology to help others grow.
      </p>

      <div class="flex flex-col items-center gap-4 mt-8 md:flex-row md:justify-center">
        <a
          href="/contact"
          class="inline-flex w-full md:w-[240px] items-center justify-center px-8 py-3 bg-[var(--color-primary)] text-[var(--color-primary-foreground)] font-[var(--font-body)] text-[16px] font-medium rounded-[10px] hover:bg-[var(--color-primary-hover)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] active:scale-95 transition duration-200"
        >
          Get in Touch
        </a>
        <a
          href="/about"
          class="inline-flex w-full md:w-[240px] items-center justify-center px-8 py-3 border border-[var(--color-primary)] text-[var(--color-primary)] bg-transparent font-[var(--font-body)] text-[16px] font-medium rounded-[10px] hover:bg-[var(--color-primary)] hover:text-[var(--color-primary-foreground)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] active:scale-95 transition duration-200"
        >
          View CV
        </a>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10 box-border w-full">
      <h2 class="font-[var(--font-display)] text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-2 tracking-tight leading-tight">
        You Can <span class="scribble-circle">View</span> My{" "}
        <span class="scribble-underline">Projects</span>.
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-10">
        <!-- Project Card 1 -->
        <a href="/work" class="block group">
          <div class="bg-[var(--color-secondary)] rounded-[16px] border border-[var(--color-card-border)] overflow-hidden transition-all duration-200 hover:-translate-y-1 hover:shadow-lg cursor-pointer">
            <div class="aspect-[4/3] overflow-hidden bg-white flex items-center justify-center">
              <div class="w-full h-full bg-gradient-to-br from-purple-100 to-purple-50 flex items-center justify-center">
                <span class="font-[var(--font-display)] text-[24px] text-[var(--color-text-muted)]">AI Solutions</span>
              </div>
            </div>
            <div class="p-5">
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-[var(--font-display)] text-[20px] md:text-[22px] font-bold text-[var(--color-text-primary)] tracking-tight">AI-Powered Applications</h3>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-text-muted)] mt-1 flex-shrink-0 group-hover:text-[var(--color-primary)] transition-colors"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
              </div>
              <p class="font-[var(--font-body)] text-base text-[var(--color-text-secondary)] mt-1 leading-relaxed">Building intelligent systems that integrate LLMs, automation, and machine learning to solve real business problems.</p>
            </div>
          </div>
        </a>

        <!-- Project Card 2 -->
        <a href="/work" class="block group">
          <div class="bg-[var(--color-secondary)] rounded-[16px] border border-[var(--color-card-border)] overflow-hidden transition-all duration-200 hover:-translate-y-1 hover:shadow-lg cursor-pointer">
            <div class="aspect-[4/3] overflow-hidden bg-white flex items-center justify-center">
              <div class="w-full h-full bg-gradient-to-br from-blue-100 to-blue-50 flex items-center justify-center">
                <span class="font-[var(--font-display)] text-[24px] text-[var(--color-text-muted)]">Web Apps</span>
              </div>
            </div>
            <div class="p-5">
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-[var(--font-display)] text-[20px] md:text-[22px] font-bold text-[var(--color-text-primary)] tracking-tight">Full-Stack Web Development</h3>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-text-muted)] mt-1 flex-shrink-0 group-hover:text-[var(--color-primary)] transition-colors"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
              </div>
              <p class="font-[var(--font-body)] text-base text-[var(--color-text-secondary)] mt-1 leading-relaxed">Creating robust, scalable web applications with modern frameworks, from frontend interfaces to backend APIs and databases.</p>
            </div>
          </div>
        </a>

        <!-- Project Card 3 -->
        <a href="/work" class="block group">
          <div class="bg-[var(--color-secondary)] rounded-[16px] border border-[var(--color-card-border)] overflow-hidden transition-all duration-200 hover:-translate-y-1 hover:shadow-lg cursor-pointer">
            <div class="aspect-[4/3] overflow-hidden bg-white flex items-center justify-center">
              <div class="w-full h-full bg-gradient-to-br from-green-100 to-green-50 flex items-center justify-center">
                <span class="font-[var(--font-display)] text-[24px] text-[var(--color-text-muted)]">Education</span>
              </div>
            </div>
            <div class="p-5">
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-[var(--font-display)] text-[20px] md:text-[22px] font-bold text-[var(--color-text-primary)] tracking-tight">Technology Education</h3>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-text-muted)] mt-1 flex-shrink-0 group-hover:text-[var(--color-primary)] transition-colors"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
              </div>
              <p class="font-[var(--font-body)] text-base text-[var(--color-text-secondary)] mt-1 leading-relaxed">Teaching software development and AI concepts in practical, accessible ways that help students and developers grow.</p>
            </div>
          </div>
        </a>

        <!-- Project Card 4 -->
        <div class="block">
          <div class="bg-[var(--color-secondary)] rounded-[16px] border border-[var(--color-card-border)] overflow-hidden transition-all duration-200">
            <div class="aspect-[4/3] overflow-hidden bg-white flex items-center justify-center">
              <span class="font-[var(--font-display)] text-sm tracking-wide text-[var(--color-text-muted)]">Coming soon...</span>
            </div>
            <div class="p-5">
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-[var(--font-display)] text-[20px] md:text-[22px] font-bold text-[var(--color-text-primary)] tracking-tight">AI Automation Platform</h3>
              </div>
              <p class="font-[var(--font-body)] text-base text-[var(--color-text-secondary)] mt-1 leading-relaxed">An automation platform helping businesses streamline workflows using intelligent AI agents and custom integrations.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mini About Section -->
  <section class="relative max-w-[1280px] mx-auto px-4 md:px-10 py-20 md:py-28 text-center overflow-visible box-border w-full">
    <div class="relative z-10 max-w-[1180px] mx-auto w-full">
      <h2 class="relative inline-block w-full font-[var(--font-display)] text-[36px] md:text-[48px] text-[var(--color-text-primary)] leading-tight tracking-tight">
        Building for <span class="relative inline-block"><span class="relative z-10 bg-[var(--color-highlight-yellow)]/20 px-1">people</span></span>, building for the future.
      </h2>
    </div>

    <p class="font-[var(--font-body)] text-[18px] text-[var(--color-text-secondary)] mt-8 max-w-[980px] mx-auto leading-relaxed">
      I am a software developer who enjoys turning ideas into things people can actually use.
    </p>

    <div class="relative font-[var(--font-body)] text-[18px] text-[var(--color-text-secondary)] mt-6 max-w-[1080px] mx-auto space-y-5 leading-relaxed">
      <p>
        I like working through the whole process. Understanding the problem, designing the architecture, and then bringing it to life through clean, maintainable code. For me, it's not just about making something work. It's about whether it solves the real problem and whether people can rely on it.
      </p>
      <p>
        I started in web development, and over time built expertise in AI, system design, and technology education. That helps me think broadly when I build — not just the code, but how everything fits together in the real world.
      </p>
    </div>

    <a
      href="/about"
      class="inline-flex w-full md:w-auto items-center justify-center px-12 py-3 bg-[var(--color-primary)] text-white font-[var(--font-body)] text-[16px] font-medium rounded-[10px] hover:bg-[var(--color-primary-hover)] transition-colors duration-200 mt-10"
    >
      View Full About
    </a>
  </section>
</PageLayout>

<style>
  .scribble-circle {
    position: relative;
    display: inline-block;
  }
  .scribble-circle::after {
    content: "";
    position: absolute;
    inset: -18% -12% -22% -12%;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 100' fill='none'><path d='M40 50 C 30 20, 80 8, 130 14 C 180 22, 195 55, 165 78 C 130 95, 60 92, 30 70 C 12 56, 18 32, 50 22' stroke='%2300CEB2' stroke-width='4' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
    z-index: -1;
  }

  .scribble-underline {
    position: relative;
    display: inline-block;
  }
  .scribble-underline::after {
    content: "";
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: -14px;
    height: 12px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 14' fill='none' preserveAspectRatio='none'><path d='M3 9 C 50 3, 110 12, 197 5' stroke='%231BB6F9' stroke-width='6' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
  }
</style>
