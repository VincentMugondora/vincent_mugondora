---
import PageLayout from "@layouts/PageLayout.astro";
---

<PageLayout title="Page Not Found | Vincent Mugondora" description="The page you're looking for doesn't exist.">
  <section class="min-h-[70vh] flex items-center justify-center py-20 md:py-28">
    <div class="max-w-[500px] mx-auto px-4 md:px-10 text-center">
      <p class="font-display italic text-[80px] md:text-[120px] text-[var(--color-primary)] font-bold leading-none tracking-tight">
        404
      </p>
      <h1 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mt-4 tracking-tight leading-tight">
        Page not <span class="scribble-underline">found</span>
      </h1>
      <p class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] mt-4 leading-relaxed">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
        <a
          href="/"
          class="inline-flex items-center justify-center px-8 py-3 bg-[var(--color-primary)] text-white font-body text-[14px] font-medium rounded-[10px] hover:bg-[var(--color-primary-hover)] transition-colors duration-200"
        >
          Go home
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-8 py-3 border border-[var(--color-card-border)] text-[var(--color-text-primary)] font-body text-[14px] font-medium rounded-[10px] hover:bg-[var(--color-secondary)] transition-colors duration-200"
        >
          Contact me
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .scribble-underline {
    position: relative;
    display: inline-block;
  }
  .scribble-underline::after {
    content: "";
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: -14px;
    height: 12px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 14' fill='none' preserveAspectRatio='none'><path d='M3 9 C 50 3, 110 12, 197 5' stroke='%231BB6F9' stroke-width='6' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
  }
</style>
