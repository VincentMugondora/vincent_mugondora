---
import PageLayout from "@layouts/PageLayout.astro";
import { getBreadcrumbJsonLd } from "@/lib/seo";
import { siteConfig } from "@config/site";

const breadcrumbJsonLd = getBreadcrumbJsonLd([
  { name: "Home", url: siteConfig.url },
  { name: "Teaching", url: `${siteConfig.url}/teaching` },
]);

const skillAreas = [
  { title: "Programming", skills: "Python, JavaScript, TypeScript" },
  { title: "Web Development", skills: "HTML, CSS, React, Node.js, Next.js" },
  { title: "AI & Machine Learning", skills: "AI fundamentals, AI tools, AI agents, AI-assisted development" },
  { title: "Software Engineering", skills: "Git, APIs, databases, architecture, testing" },
  { title: "Creative Technology", skills: "Roblox, game development, Scratch" },
  { title: "Digital Skills", skills: "SEO, productivity, technology entrepreneurship" },
];

const audiences = [
  { title: "School students", description: "Primary and secondary school learners discovering programming and technology." },
  { title: "Beginners", description: "People writing their first lines of code with zero prior experience." },
  { title: "Young developers", description: "Junior developers building confidence and expanding their skills." },
  { title: "Aspiring engineers", description: "People committed to becoming professional software engineers." },
  { title: "Educators", description: "Teachers integrating technology and coding into their curriculum." },
  { title: "Career changers", description: "Professionals transitioning into technology from other fields." },
];

const methods = [
  { title: "Project-based learning", description: "Every concept is applied to a real project, not an abstract exercise." },
  { title: "Live coding", description: "I build alongside learners so they see the thinking process, not just the result." },
  { title: "Real-world problems", description: "Students solve problems that matter - not toy examples they'll never use again." },
  { title: "Step-by-step", description: "Complex concepts are broken into digestible steps that build on each other." },
  { title: "AI-assisted learning", description: "Using AI tools as learning accelerators while building genuine understanding." },
  { title: "Building applications", description: "Students ship actual applications, not just follow tutorials." },
];

const programs = [
  { title: "School Coding Programs", description: "Multi-week programming courses delivered to schools, introducing students to coding through hands-on projects.", type: "Ongoing" },
  { title: "AI Workshops", description: "Focused sessions teaching AI fundamentals, AI tools, and how to build AI-powered applications.", type: "Workshop" },
  { title: "Coding Bootcamps", description: "Intensive programs taking beginners from zero to building their first web applications.", type: "Intensive" },
  { title: "Hackathons", description: "Collaborative events where students solve real problems by building technology solutions in teams.", type: "Event" },
  { title: "Mentorship", description: "One-on-one and small group guidance for developers building skills and careers.", type: "Ongoing" },
];

const studentProjects = [
  "Websites & portfolios",
  "REST APIs",
  "AI chatbots",
  "Games (Roblox, Scratch)",
  "Business applications",
  "WhatsApp integrations",
  "School management tools",
  "Data dashboards",
];

const impact = [
  { number: "100+", label: "Students taught" },
  { number: "10+", label: "Workshops conducted" },
  { number: "5+", label: "Schools reached" },
  { number: "50+", label: "Projects completed" },
];
---

<PageLayout title="Teaching" description="Vincent Mugondora teaches programming, AI, web development, and software engineering through practical, project-based learning in Zimbabwe.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <!-- Hero -->
  <section class="pt-[72px] py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <h1 class="font-display italic text-[48px] md:text-[72px] lg:text-[96px] text-[var(--color-text-primary)] leading-[1.05] font-bold tracking-tight">
        Teaching people to <span class="marker-highlight">build</span>.
      </h1>
      <p class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] mt-4 max-w-[640px] leading-relaxed">
        I teach people how to build with technology - not just how to use it. Through practical, project-based learning in software engineering, AI, and web development.
      </p>
      <div class="flex flex-col sm:flex-row sm:items-center gap-4 mt-8">
        <a
          href="#programs"
          class="inline-flex items-center justify-center px-8 py-3 bg-[var(--color-primary)] text-white font-body text-[14px] font-medium rounded-[10px] hover:bg-[var(--color-primary-hover)] transition-colors duration-200"
        >
          View Programs
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-8 py-3 border border-[var(--color-card-border)] text-[var(--color-text-primary)] font-body text-[14px] font-medium rounded-[10px] hover:bg-[var(--color-secondary)] transition-colors duration-200"
        >
          Book a Workshop
        </a>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-6 tracking-tight leading-tight">
        How I <span class="scribble-circle">think</span> about teaching
      </h2>
      <div class="space-y-5 font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] leading-relaxed">
        <p>
          I believe in learning by building. Every concept is better understood when applied to a real problem, not an abstract exercise.
        </p>
        <p>
          I meet students where they are - whether they're writing their first function or architecting distributed systems. The goal is always to build confidence alongside competence.
        </p>
        <p>
          I focus on fundamentals that transfer across languages and frameworks. Tools change; thinking endures.
        </p>
      </div>
    </div>
  </section>

  <!-- What I Teach -->
  <section class="py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-10 tracking-tight leading-tight">
        What I <span class="scribble-underline">teach</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {skillAreas.map((area) => (
          <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6">
            <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">{area.title}</h3>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-2 leading-relaxed">{area.skills}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who I Teach -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-10 tracking-tight leading-tight">
        Who I <span class="marker-highlight">teach</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {audiences.map((aud) => (
          <div class="bg-white rounded-[12px] border border-[var(--color-card-border)] p-5">
            <h3 class="font-display italic text-[18px] font-bold text-[var(--color-text-primary)] tracking-tight">{aud.title}</h3>
            <p class="font-body text-[13px] text-[var(--color-text-secondary)] mt-1.5 leading-relaxed">{aud.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How I Teach -->
  <section class="py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-10 tracking-tight leading-tight">
        How I <span class="scribble-circle">teach</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {methods.map((method) => (
          <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6">
            <h3 class="font-display italic text-[18px] font-bold text-[var(--color-text-primary)] tracking-tight">{method.title}</h3>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-2 leading-relaxed">{method.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Programs & Workshops -->
  <section id="programs" class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-10 tracking-tight leading-tight">
        Programs & <span class="scribble-underline">workshops</span>
      </h2>

      <div class="space-y-5">
        {programs.map((prog) => (
          <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
              <h3 class="font-display italic text-[22px] md:text-[24px] font-bold text-[var(--color-text-primary)] tracking-tight">{prog.title}</h3>
              <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-2 leading-relaxed max-w-[600px]">{prog.description}</p>
            </div>
            <span class="inline-flex items-center font-body text-[12px] font-medium px-3 py-1 rounded-full border border-[var(--color-card-border)] text-[var(--color-text-muted)] whitespace-nowrap shrink-0">
              {prog.type}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What Students Build -->
  <section class="py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-8 tracking-tight leading-tight">
        What students <span class="marker-highlight">build</span>
      </h2>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {studentProjects.map((project) => (
          <div class="bg-[var(--color-secondary)] rounded-[10px] border border-[var(--color-card-border)] px-4 py-3 text-center">
            <p class="font-body text-[14px] text-[var(--color-text-primary)] font-medium">{project}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Impact -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-10 tracking-tight leading-tight">
        Impact
      </h2>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {impact.map((item) => (
          <div class="text-center">
            <p class="font-display italic text-[36px] md:text-[44px] text-[var(--color-primary)] font-bold">{item.number}</p>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1">{item.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Certificates -->
  <section class="py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-4 tracking-tight leading-tight">
        Certifications
      </h2>
      <p class="font-body text-[16px] text-[var(--color-text-secondary)] mb-8 max-w-[600px] leading-relaxed">
        Industry certifications and courses that back my teaching practice.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="teaching-certs-grid">
        <p class="font-body text-[14px] text-[var(--color-text-muted)] col-span-full text-center py-6">Loading...</p>
      </div>
    </div>
  </section>

  <script is:inline>
    (async function() {
      try {
        const res = await fetch('/api/certificates');
        if (!res.ok) return;
        const allCerts = await res.json();
        const grid = document.getElementById('teaching-certs-grid');
        if (!allCerts.length) { grid.innerHTML = ''; return; }
        const certs = allCerts.slice(0, 3);
        let html = certs.map(c => `
          <div class="bg-white rounded-[12px] border border-[var(--color-card-border)] p-5 flex items-start gap-3">
            <div class="w-9 h-9 rounded-full bg-[var(--color-secondary)] flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" />
              </svg>
            </div>
            <div>
              <h3 class="font-display italic text-[15px] font-bold text-[var(--color-text-primary)] tracking-tight leading-snug">${c.name}</h3>
              ${c.issuer ? `<p class="font-body text-[12px] text-[var(--color-primary)] font-medium mt-0.5">${c.issuer}</p>` : ''}
            </div>
          </div>
        `).join('');
        if (allCerts.length > 3) {
          html += `<a href="/certificates" class="bg-[var(--color-secondary)] rounded-[12px] border border-[var(--color-card-border)] p-5 flex items-center justify-center hover:border-[var(--color-primary)] transition-colors">
            <span class="font-body text-[14px] text-[var(--color-primary)] font-medium">View all certificates &rarr;</span>
          </a>`;
        }
        grid.innerHTML = html;
      } catch(e) { document.getElementById('teaching-certs-grid').innerHTML = ''; }
    })();
  </script>

  <!-- Final CTA -->
  <section class="py-20 md:py-28">
    <div class="max-w-[800px] mx-auto px-4 md:px-10 text-center">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-4 tracking-tight leading-tight">
        Want me to teach at your <span class="scribble-circle">school</span> or event?
      </h2>
      <p class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] leading-relaxed max-w-[600px] mx-auto">
        Available for workshops, bootcamps, school programs, corporate training, mentorship, and hackathons.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-8 py-3 bg-[var(--color-primary)] text-white font-body text-[16px] font-medium rounded-[10px] hover:bg-[var(--color-primary-hover)] active:scale-95 transition duration-200 mt-8"
      >
        Book a session &rarr;
      </a>
    </div>
  </section>
</PageLayout>

<style>
  .marker-highlight {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }
  .marker-highlight::before {
    content: "";
    position: absolute;
    left: -0.08em;
    right: -0.08em;
    bottom: 0.05em;
    height: 45%;
    background-color: #FFB800;
    border-radius: 20% 5% 15% 8%;
    z-index: -1;
    transform: rotate(-1deg);
  }

  .scribble-circle {
    position: relative;
    display: inline-block;
  }
  .scribble-circle::after {
    content: "";
    position: absolute;
    inset: -18% -12% -22% -12%;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 100' fill='none'><path d='M40 50 C 30 20, 80 8, 130 14 C 180 22, 195 55, 165 78 C 130 95, 60 92, 30 70 C 12 56, 18 32, 50 22' stroke='%2300CEB2' stroke-width='4' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
    z-index: -1;
  }

  .scribble-underline {
    position: relative;
    display: inline-block;
  }
  .scribble-underline::after {
    content: "";
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: -14px;
    height: 12px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 14' fill='none' preserveAspectRatio='none'><path d='M3 9 C 50 3, 110 12, 197 5' stroke='%231BB6F9' stroke-width='6' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
  }
</style>
