---
import PageLayout from "@layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";
---

<PageLayout title="Teaching" description="Vincent Mugondora teaches software engineering, AI development, and system design through workshops and mentorship.">
  <section class="hero">
    <div class="container">
      <span class="badge">Education</span>
      <h1 class="hero__title">Teaching</h1>
      <p class="hero__subtitle">
        Helping developers build confidence through practical, project-based learning in software engineering, AI, and system design.
      </p>
    </div>
  </section>

  <section class="areas-section">
    <div class="container">
      <h2 class="section-heading">What I Teach</h2>
      <div class="areas-grid">
        <div class="area-card">
          <div class="area-card__icon">
            <Icon name="lucide:code" />
          </div>
          <h3 class="area-card__title">Software Engineering</h3>
          <p class="area-card__text">Fundamentals, clean code, testing, and building production-ready applications.</p>
        </div>
        <div class="area-card">
          <div class="area-card__icon">
            <Icon name="lucide:bot" />
          </div>
          <h3 class="area-card__title">AI Development</h3>
          <p class="area-card__text">Building AI agents, RAG systems, and integrating LLMs into real products.</p>
        </div>
        <div class="area-card">
          <div class="area-card__icon">
            <Icon name="lucide:boxes" />
          </div>
          <h3 class="area-card__title">System Design</h3>
          <p class="area-card__text">Architecture patterns, scalability, performance, and technical decision-making.</p>
        </div>
        <div class="area-card">
          <div class="area-card__icon">
            <Icon name="lucide:globe" />
          </div>
          <h3 class="area-card__title">Web Development</h3>
          <p class="area-card__text">Modern frameworks, TypeScript, performance optimization, and deployment.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="philosophy-section">
    <div class="container">
      <div class="philosophy-wrapper">
        <h2 class="section-heading">Teaching Philosophy</h2>
        <div class="philosophy-content">
          <p>I believe in learning by building. Every concept is better understood when applied to a real problem, not an abstract exercise.</p>
          <p>I meet students where they are — whether they're writing their first function or architecting distributed systems. The goal is always to build confidence alongside competence.</p>
          <p>I focus on fundamentals that transfer across languages and frameworks. Tools change; thinking endures.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <div class="cta-wrapper">
        <h2 class="cta__title">Work with me</h2>
        <p class="cta__text">
          Available for workshops, mentorship, and course development. Let's discuss how I can help your team or community grow.
        </p>
        <a href="/contact" class="cta__btn">Get In Touch</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .hero {
    background: #f4f2ed;
    padding: clamp(80px, 12vw, 140px) 0 clamp(48px, 6vw, 80px);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(18px, 3vw, 36px);
  }

  .badge {
    display: inline-block;
    border-radius: 999px;
    border: 1px solid #e4e0d8;
    background: #fff;
    font-size: 12px;
    padding: 6px 16px;
    color: #5f5f5f;
    letter-spacing: 0.04em;
  }

  .hero__title {
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.06;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    color: #1b1b1b;
    margin: 20px 0 0;
  }

  .hero__subtitle {
    color: #5f5f5f;
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 560px;
    margin: 14px 0 0;
  }

  .section-heading {
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.06;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    color: #1b1b1b;
    margin: 0 0 24px;
  }

  .areas-section {
    padding: clamp(40px, 6vw, 80px) 0;
  }

  .areas-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .areas-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .area-card {
    background: #fff;
    border: 1px solid #e6e2db;
    border-radius: 16px;
    padding: clamp(20px, 3vw, 28px);
    transition: box-shadow 0.2s, border-color 0.2s;
  }

  .area-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    border-color: #d4d0c8;
  }

  .area-card__icon {
    width: 36px;
    height: 36px;
    color: #1b1b1b;
    margin-bottom: 16px;
  }

  .area-card__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .area-card__title {
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-size: 1.15rem;
    color: #1b1b1b;
    margin: 0 0 8px;
  }

  .area-card__text {
    color: #666;
    font-size: 0.9rem;
    line-height: 1.55;
    margin: 0;
  }

  .philosophy-section {
    padding: 0 0 clamp(40px, 6vw, 80px);
  }

  .philosophy-wrapper {
    background: #f4f2ed;
    border-radius: 20px;
    padding: clamp(28px, 4vw, 48px) clamp(20px, 3vw, 34px);
    max-width: 800px;
  }

  .philosophy-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .philosophy-content p {
    color: #5f5f5f;
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0;
  }

  .cta-section {
    padding: clamp(40px, 6vw, 80px) 0 clamp(60px, 8vw, 100px);
  }

  .cta-wrapper {
    text-align: center;
    max-width: 520px;
    margin: 0 auto;
  }

  .cta__title {
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.06;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: #1b1b1b;
    margin: 0 0 12px;
  }

  .cta__text {
    color: #666;
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0 0 28px;
  }

  .cta__btn {
    display: inline-block;
    background: #1b1b1b;
    color: #fff;
    border-radius: 999px;
    padding: 14px 32px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s;
  }

  .cta__btn:hover {
    background: #333;
  }
</style>
