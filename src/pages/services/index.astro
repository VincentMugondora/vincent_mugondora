---
import PageLayout from "@layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";
import { getBreadcrumbJsonLd, getServiceCatalogJsonLd } from "@/lib/seo";
import { siteConfig } from "@config/site";

const breadcrumbJsonLd = getBreadcrumbJsonLd([
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
]);

const serviceCatalogJsonLd = getServiceCatalogJsonLd();

const services = [
  {
    title: "Software Development",
    href: "/services/software-development",
    icon: "lucide:code",
    description: "Custom software solutions built with modern technologies. Full-stack applications, APIs, and system architecture for businesses that need reliable, scalable software.",
    technologies: ["TypeScript", "Python", "React", "Node.js", "PostgreSQL"],
  },
  {
    title: "Web Development",
    href: "/services/web-development",
    icon: "lucide:globe",
    description: "Fast, accessible, SEO-friendly websites and web applications. Built for performance on African internet conditions with modern frameworks and best practices.",
    technologies: ["Astro", "Next.js", "Tailwind CSS", "Cloudflare"],
  },
  {
    title: "AI Solutions",
    href: "/services/ai-solutions",
    icon: "lucide:bot",
    description: "Practical AI implementations for businesses. From intelligent chatbots to custom AI agents, I help organisations integrate artificial intelligence into their workflows.",
    technologies: ["LLMs", "RAG", "AI Agents", "LangChain", "Vector DBs"],
  },
  {
    title: "AI Automation",
    href: "/services/ai-automation",
    icon: "lucide:workflow",
    description: "Automate repetitive business processes with AI. Workflow automation, document processing, and intelligent systems that save time and reduce errors.",
    technologies: ["AI Agents", "Automation", "APIs", "Integrations"],
  },
];
---

<PageLayout title="Services | Software Development, Web Development & AI" description="Software development, web development, AI solutions and automation services by Vincent Mugondora. Building technology for businesses in Zimbabwe and Africa.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <!-- Hero -->
  <section class="pt-[72px] py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <span class="inline-block font-display text-[12px] text-[var(--color-text-secondary)] border border-[var(--color-card-border)] rounded-full px-4 py-1 mb-6">
        Services
      </span>
      <h1 class="font-display italic text-[48px] md:text-[64px] lg:text-[72px] text-[var(--color-text-primary)] leading-[1.05] font-bold tracking-tight">
        How I can <span class="marker-highlight">help</span>
      </h1>
      <p class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] mt-6 max-w-[600px] leading-relaxed">
        I build software, AI solutions and web applications for businesses and organisations. Based in Zimbabwe, working with clients across Africa and globally.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {services.map((service) => (
          <a href={service.href} class="group block bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 md:p-8 hover:border-[var(--color-primary)] transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg">
            <div class="flex items-start justify-between mb-4">
              <div class="w-11 h-11 rounded-[12px] bg-[var(--color-secondary)] flex items-center justify-center text-[var(--color-text-primary)]">
                <Icon name={service.icon} class="w-5 h-5" />
              </div>
              <span class="w-8 h-8 rounded-full bg-[var(--color-secondary)] flex items-center justify-center text-[var(--color-text-primary)] opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200">
                <Icon name="lucide:arrow-right" class="w-4 h-4" />
              </span>
            </div>
            <h2 class="font-display italic text-[22px] md:text-[24px] font-bold text-[var(--color-text-primary)] tracking-tight mb-2">{service.title}</h2>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed mb-4">{service.description}</p>
            <div class="flex flex-wrap gap-2">
              {service.technologies.map((tech) => (
                <span class="font-body text-[11px] text-[var(--color-text-muted)] border border-[var(--color-card-border)] rounded-full px-3 py-1">{tech}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-28">
    <div class="max-w-[800px] mx-auto px-4 md:px-10 text-center">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-4 tracking-tight leading-tight">
        Ready to build <span class="scribble-underline">something</span>?
      </h2>
      <p class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] leading-relaxed max-w-[500px] mx-auto">
        Share your project details and I'll get back with a clear direction.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 px-8 py-3 bg-[var(--color-primary)] text-white font-body text-[14px] font-medium rounded-[10px] hover:bg-[var(--color-primary-hover)] transition-colors duration-200 mt-8"
      >
        Get in touch
        <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
      </a>
    </div>
  </section>
</PageLayout>

<style>
  .marker-highlight {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }
  .marker-highlight::before {
    content: "";
    position: absolute;
    left: -0.08em;
    right: -0.08em;
    bottom: 0.05em;
    height: 45%;
    background-color: #FFB800;
    border-radius: 20% 5% 15% 8%;
    z-index: -1;
    transform: rotate(-1deg);
  }

  .scribble-underline {
    position: relative;
    display: inline-block;
  }
  .scribble-underline::after {
    content: "";
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: -14px;
    height: 12px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 14' fill='none' preserveAspectRatio='none'><path d='M3 9 C 50 3, 110 12, 197 5' stroke='%231BB6F9' stroke-width='6' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
  }
</style>
