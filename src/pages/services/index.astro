---
import PageLayout from "@layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";
import { getBreadcrumbJsonLd } from "@/lib/seo";
import { siteConfig } from "@config/site";

const breadcrumbJsonLd = getBreadcrumbJsonLd([
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
]);

const services = [
  {
    title: "Software Development",
    href: "/services/software-development",
    icon: "lucide:code",
    description: "Custom software solutions built with modern technologies. Full-stack applications, APIs, and system architecture for businesses that need reliable, scalable software.",
    technologies: ["TypeScript", "Python", "React", "Node.js", "PostgreSQL"],
  },
  {
    title: "Web Development",
    href: "/services/web-development",
    icon: "lucide:globe",
    description: "Fast, accessible, SEO-friendly websites and web applications. Built for performance on African internet conditions with modern frameworks and best practices.",
    technologies: ["Astro", "Next.js", "Tailwind CSS", "Cloudflare"],
  },
  {
    title: "AI Solutions",
    href: "/services/ai-solutions",
    icon: "lucide:bot",
    description: "Practical AI implementations for businesses. From intelligent chatbots to custom AI agents, I help organisations integrate artificial intelligence into their workflows.",
    technologies: ["LLMs", "RAG", "AI Agents", "LangChain", "Vector DBs"],
  },
  {
    title: "AI Automation",
    href: "/services/ai-automation",
    icon: "lucide:workflow",
    description: "Automate repetitive business processes with AI. Workflow automation, document processing, and intelligent systems that save time and reduce errors.",
    technologies: ["AI Agents", "Automation", "APIs", "Integrations"],
  },
];
---

<PageLayout title="Services | Software Development, Web Development & AI" description="Software development, web development, AI solutions and automation services by Vincent Mugondora. Building technology for businesses in Zimbabwe and Africa.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <section class="hero">
    <div class="hero__container">
      <span class="hero__badge">Services</span>
      <h1 class="hero__heading">How I Can Help</h1>
      <p class="hero__description">
        I build software, AI solutions and web applications for businesses and organisations. Based in Zimbabwe, working with clients across Africa and globally.
      </p>
    </div>
  </section>

  <section class="services">
    <div class="services__container">
      <div class="services__grid">
        {services.map((service) => (
          <a href={service.href} class="card">
            <div class="card__icon">
              <Icon name={service.icon} />
            </div>
            <h2 class="card__title">{service.title}</h2>
            <p class="card__description">{service.description}</p>
            <div class="card__technologies">
              {service.technologies.map((tech) => (
                <span class="card__pill">{tech}</span>
              ))}
            </div>
            <span class="card__arrow" aria-hidden="true">
              <Icon name="lucide:arrow-right" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="cta__container">
      <h2 class="cta__heading">Ready to build something?</h2>
      <p class="cta__description">
        Share your project details and I'll get back with a clear direction.
      </p>
      <a href="/contact" class="cta__button">
        Get in touch
        <Icon name="lucide:arrow-up-right" />
      </a>
    </div>
  </section>
</PageLayout>

<style>
  .hero {
    background: #f2f0ec;
    padding: clamp(48px, 8vw, 96px) clamp(20px, 4vw, 40px);
  }

  .hero__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero__badge {
    display: inline-block;
    border-radius: 999px;
    border: 1px solid #e4e0d8;
    background: #fff;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #5f5f5f;
  }

  .hero__heading {
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-weight: 500;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    letter-spacing: -0.02em;
    line-height: 1.06;
    color: #1a1a1a;
    margin: 20px 0 0;
  }

  .hero__description {
    max-width: 600px;
    margin: 16px 0 0;
    color: #5f5f5f;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .services {
    background: #f4f2ed;
    padding: clamp(32px, 5vw, 64px) clamp(20px, 4vw, 40px);
  }

  .services__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media (max-width: 768px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #e6e2db;
    border-radius: 16px;
    padding: clamp(24px, 3vw, 32px);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .card:hover {
    border-color: #d4d0c8;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
  }

  .card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #f4f2ed;
    color: #1a1a1a;
    margin-bottom: 16px;
  }

  .card__icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .card__title {
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-weight: 500;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: #1a1a1a;
    margin: 0 0 10px;
  }

  .card__description {
    color: #666;
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0 0 16px;
    flex: 1;
  }

  .card__technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .card__pill {
    display: inline-block;
    border-radius: 999px;
    border: 1px solid #e4e0d8;
    background: #fff;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 400;
    color: #5f5f5f;
  }

  .card__arrow {
    position: absolute;
    top: clamp(24px, 3vw, 32px);
    right: clamp(24px, 3vw, 32px);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: #f4f2ed;
    color: #1a1a1a;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .card:hover .card__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .card__arrow :global(svg) {
    width: 16px;
    height: 16px;
  }

  .cta {
    background: #262626;
    border-radius: 20px;
    margin: 0 clamp(20px, 4vw, 40px) clamp(32px, 5vw, 64px);
    padding: clamp(40px, 6vw, 80px) clamp(24px, 4vw, 48px);
    text-align: center;
  }

  .cta__container {
    max-width: 600px;
    margin: 0 auto;
  }

  .cta__heading {
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-weight: 500;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    letter-spacing: -0.02em;
    line-height: 1.06;
    color: #fff;
    margin: 0;
  }

  .cta__description {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1rem;
    line-height: 1.55;
    margin: 16px 0 0;
  }

  .cta__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    padding: 12px 28px;
    border-radius: 999px;
    background: #fff;
    color: #111;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .cta__button:hover {
    background: #f2f0ec;
    transform: translateY(-1px);
  }

  .cta__button :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
