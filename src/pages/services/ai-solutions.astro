---
import PageLayout from "@layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@config/site";
import { getBreadcrumbJsonLd, getSpeakableJsonLd, getFAQJsonLd } from "@/lib/seo";
import "@fontsource-variable/lora";

const faqs = [
  {
    question: "What AI solutions work best for small businesses in Zimbabwe?",
    answer: "AI chatbots for customer support, document processing for invoices and contracts, lead qualification agents, and WhatsApp automation are the highest-impact AI solutions for small businesses in Zimbabwe. They reduce repetitive work and improve response times without requiring large teams.",
  },
  {
    question: "How much does it cost to build an AI chatbot for my business?",
    answer: "AI chatbot costs depend on complexity. A basic FAQ chatbot for WhatsApp or your website starts from a few hundred dollars. More advanced AI agents that handle lead qualification, appointments, or document processing cost more depending on integrations required. I provide a free consultation to scope your specific needs.",
  },
  {
    question: "Can AI agents work with WhatsApp in Zimbabwe?",
    answer: "Yes. AI agents integrate with the WhatsApp Business API to handle customer enquiries, qualify leads, process orders, and provide 24/7 support. WhatsApp is the primary communication channel in Zimbabwe, making it the most practical platform for AI-powered customer interactions.",
  },
  {
    question: "What is the difference between an AI chatbot and an AI agent?",
    answer: "An AI chatbot responds to messages using pre-defined flows or language models. An AI agent goes further — it can take actions, access databases, make decisions, and complete multi-step tasks autonomously. Agents can research, analyse data, and execute workflows without human intervention.",
  },
  {
    question: "How long does it take to implement AI in a business?",
    answer: "A basic AI chatbot can be deployed in 1-2 weeks. More complex AI systems like document processing pipelines or multi-agent workflows take 4-8 weeks depending on integrations and data requirements. I start with a discovery session to identify the fastest path to value.",
  },
];

const faqJsonLd = getFAQJsonLd(faqs);

const breadcrumbJsonLd = getBreadcrumbJsonLd([
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
  { name: "AI Solutions", url: `${siteConfig.url}/services/ai-solutions` },
]);

const speakableJsonLd = getSpeakableJsonLd({
  url: `${siteConfig.url}/services/ai-solutions`,
  title: "AI Solutions for Businesses in Zimbabwe",
});

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "AI Solutions for Businesses",
  description: "Practical AI implementations for businesses in Zimbabwe and Africa. AI chatbots, intelligent agents, RAG systems, and custom AI integration.",
  provider: { "@id": `${siteConfig.url}/#person` },
  areaServed: [
    { "@type": "Country", name: "Zimbabwe" },
    { "@type": "Continent", name: "Africa" },
  ],
  serviceType: "AI Development",
};
---

<PageLayout title="AI Solutions for Businesses in Zimbabwe | AI Chatbots & Agents" description="AI solutions for businesses in Zimbabwe and Africa. AI chatbot development, AI agents, workflow automation, and practical business AI for customer support and operations.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(speakableJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <!-- Hero -->
  <section class="pt-[72px] py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <span class="inline-block font-display text-[12px] text-[var(--color-text-secondary)] border border-[var(--color-card-border)] rounded-full px-4 py-1 mb-6">
        Services
      </span>
      <h1 class="font-display italic text-[48px] md:text-[64px] lg:text-[72px] text-[var(--color-text-primary)] leading-[1.05] font-bold tracking-tight">
        AI <span class="marker-highlight">Solutions</span>
      </h1>
      <p class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] mt-6 max-w-[600px] leading-relaxed">
        AI solutions for businesses that want faster customer support, cleaner internal systems, and practical automation that saves time. I build AI chatbots, AI agents, and custom business AI systems for organisations in Zimbabwe and across Africa.
      </p>
    </div>
  </section>

  <!-- What I Build -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-8 tracking-tight leading-tight">
        What I <span class="scribble-underline">build</span>
      </h2>

      <div class="space-y-4">
        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-[10px] bg-[var(--color-secondary)] flex items-center justify-center flex-shrink-0 text-[var(--color-text-primary)]">
            <Icon name="lucide:message-circle" class="w-5 h-5" />
          </div>
          <div>
            <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">AI Chatbots</h3>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">Intelligent conversational agents for customer support, sales, and internal tools. WhatsApp, web, and multi-platform.</p>
          </div>
        </div>

        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-[10px] bg-[var(--color-secondary)] flex items-center justify-center flex-shrink-0 text-[var(--color-text-primary)]">
            <Icon name="lucide:bot" class="w-5 h-5" />
          </div>
          <div>
            <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">AI Agents</h3>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">Autonomous agents that can research, analyse, and take actions on behalf of your business.</p>
          </div>
        </div>

        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-[10px] bg-[var(--color-secondary)] flex items-center justify-center flex-shrink-0 text-[var(--color-text-primary)]">
            <Icon name="lucide:book-open" class="w-5 h-5" />
          </div>
          <div>
            <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">RAG Systems</h3>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">AI that understands your documents, knowledge base, and business context to answer questions accurately.</p>
          </div>
        </div>

        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-[10px] bg-[var(--color-secondary)] flex items-center justify-center flex-shrink-0 text-[var(--color-text-primary)]">
            <Icon name="lucide:puzzle" class="w-5 h-5" />
          </div>
          <div>
            <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">Custom AI Integration</h3>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">Connect AI capabilities to your existing systems, workflows, and business processes.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technologies -->
  <section class="py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-6 tracking-tight leading-tight">
        Technologies
      </h2>
      <div class="flex flex-wrap gap-2">
        {["LLMs", "GPT-4", "Claude", "RAG", "LangChain", "Vector Databases", "AI Agents", "Python", "FastAPI", "WhatsApp API"].map((t) => (
          <span class="font-body text-[12px] text-[var(--color-text-muted)] border border-[var(--color-card-border)] rounded-full px-4 py-1.5">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- AI for African Businesses -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-6 tracking-tight leading-tight">
        AI for <span class="scribble-circle">African</span> businesses
      </h2>
      <div class="space-y-5 font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] leading-relaxed max-w-[640px]">
        <p>AI isn't just for Silicon Valley. Businesses in Zimbabwe and Africa can use AI to automate customer support, process documents, analyse data, and build intelligent products.</p>
        <p>I focus on practical AI — solutions that deliver measurable business value, not experimental technology for its own sake. Every AI implementation starts with a clear business problem and a realistic assessment of what AI can solve.</p>
        <p>Whether you need a WhatsApp chatbot that handles customer enquiries 24/7, or an AI system that processes and categorises your business documents, I build solutions that work within real-world constraints.</p>
      </div>

      <div class="mt-10 bg-white rounded-[16px] border border-[var(--color-card-border)] p-6">
        <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight mb-3">Learn more</h3>
        <ul class="space-y-2 font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed">
          <li><a href="/writing/ai-agents-explained-for-beginners" class="text-[var(--color-primary)] hover:underline">What Are AI Agents? A Simple Guide for Beginners</a></li>
          <li><a href="/writing/how-zimbabwean-businesses-can-use-ai" class="text-[var(--color-primary)] hover:underline">How Zimbabwean Businesses Can Use AI</a></li>
          <li><a href="/writing/ai-agent-use-cases-for-small-businesses" class="text-[var(--color-primary)] hover:underline">5 AI Agent Use Cases for Small Businesses</a></li>
          <li><a href="/services/ai-automation" class="text-[var(--color-primary)] hover:underline">AI Automation Services</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-28">
    <div class="max-w-[800px] mx-auto px-4 md:px-10 text-center">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-4 tracking-tight leading-tight">
        Ready to use <span class="marker-highlight">AI</span> in your business?
      </h2>
      <p class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] leading-relaxed max-w-[500px] mx-auto">
        Tell me about your business challenge and I'll suggest how AI can help.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 px-8 py-3 bg-[var(--color-primary)] text-white font-body text-[14px] font-medium rounded-[10px] hover:bg-[var(--color-primary-hover)] transition-colors duration-200 mt-8"
      >
        Start a conversation
        <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
      </a>
    </div>
  </section>
</PageLayout>

<style>
  .marker-highlight {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }
  .marker-highlight::before {
    content: "";
    position: absolute;
    left: -0.08em;
    right: -0.08em;
    bottom: 0.05em;
    height: 45%;
    background-color: #FFB800;
    border-radius: 20% 5% 15% 8%;
    z-index: -1;
    transform: rotate(-1deg);
  }

  .scribble-circle {
    position: relative;
    display: inline-block;
  }
  .scribble-circle::after {
    content: "";
    position: absolute;
    inset: -18% -12% -22% -12%;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 100' fill='none'><path d='M40 50 C 30 20, 80 8, 130 14 C 180 22, 195 55, 165 78 C 130 95, 60 92, 30 70 C 12 56, 18 32, 50 22' stroke='%2300CEB2' stroke-width='4' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
    z-index: -1;
  }

  .scribble-underline {
    position: relative;
    display: inline-block;
  }
  .scribble-underline::after {
    content: "";
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: -14px;
    height: 12px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 14' fill='none' preserveAspectRatio='none'><path d='M3 9 C 50 3, 110 12, 197 5' stroke='%231BB6F9' stroke-width='6' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
  }
</style>
