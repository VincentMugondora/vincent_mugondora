---
import PageLayout from "@layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@config/site";
import { getBreadcrumbJsonLd } from "@/lib/seo";

const breadcrumbJsonLd = getBreadcrumbJsonLd([
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
  { name: "Software Development", url: `${siteConfig.url}/services/software-development` },
]);

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Custom Software Development",
  description: "Custom software development services by Vincent Mugondora. Full-stack development, APIs, and system architecture for businesses in Zimbabwe and Africa.",
  provider: { "@type": "Person", name: "Vincent Mugondora", url: siteConfig.url },
  areaServed: [
    { "@type": "Country", name: "Zimbabwe" },
    { "@type": "Continent", name: "Africa" },
  ],
  serviceType: "Software Development",
};
---

<PageLayout title="Software Development Services in Zimbabwe" description="Custom software development services by Vincent Mugondora. Full-stack development, APIs, and system architecture for businesses in Zimbabwe and Africa.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <!-- Hero -->
  <section class="hero">
    <div class="hero__container">
      <span class="hero__badge">Services</span>
      <h1 class="hero__title">Software Development Services</h1>
      <p class="hero__description">
        Custom software solutions built with modern technologies for businesses that need reliable, scalable applications. Based in Zimbabwe, working with clients across Africa.
      </p>
    </div>
  </section>

  <!-- What I Build -->
  <section class="what-i-build">
    <div class="section-container">
      <h2 class="section-heading">What I Build</h2>
      <ul class="build-list">
        <li class="build-list__item">
          <span class="build-list__icon"><Icon name="lucide:layers" /></span>
          <div class="build-list__content">
            <strong class="build-list__label">Full-Stack Applications</strong>
            <span class="build-list__text"> — End-to-end web applications with modern frontend frameworks and robust backend systems.</span>
          </div>
        </li>
        <li class="build-list__item">
          <span class="build-list__icon"><Icon name="lucide:plug" /></span>
          <div class="build-list__content">
            <strong class="build-list__label">REST & GraphQL APIs</strong>
            <span class="build-list__text"> — Well-documented, secure APIs that power your applications and integrations.</span>
          </div>
        </li>
        <li class="build-list__item">
          <span class="build-list__icon"><Icon name="lucide:network" /></span>
          <div class="build-list__content">
            <strong class="build-list__label">System Architecture</strong>
            <span class="build-list__text"> — Scalable, maintainable system design that grows with your business.</span>
          </div>
        </li>
        <li class="build-list__item">
          <span class="build-list__icon"><Icon name="lucide:database" /></span>
          <div class="build-list__content">
            <strong class="build-list__label">Database Design</strong>
            <span class="build-list__text"> — Efficient data models and database architecture for complex business requirements.</span>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- Technologies -->
  <section class="technologies">
    <div class="section-container">
      <h2 class="section-heading">Technologies</h2>
      <div class="tags">
        {["TypeScript", "Python", "React", "Next.js", "Node.js", "Django", "FastAPI", "PostgreSQL", "Docker", "AWS", "Cloudflare"].map((t) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Content / Approach -->
  <section class="approach">
    <div class="section-container">
      <h2 class="section-heading">How I Work</h2>
      <div class="approach__body">
        <p>I build software with a focus on reliability and performance. Clean architecture and strong fundamentals matter more than chasing trends.</p>
        <p>Every project starts with understanding your business requirements. I then design a solution that balances technical quality with practical constraints — budget, timeline, and the real-world conditions your users face.</p>
        <p>For businesses in Zimbabwe and Africa, this means building software that works reliably on slower connections, handles intermittent connectivity, and serves users across different devices.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="cta__container">
      <h2 class="cta__title">Need custom software?</h2>
      <p class="cta__text">Tell me about your project and I'll get back with a clear direction.</p>
      <a class="cta__btn" href="/contact">
        Start a conversation
        <Icon name="lucide:arrow-up-right" />
      </a>
    </div>
  </section>
</PageLayout>

<style>
  /* Hero */
  .hero {
    background: #f2f0ec;
    padding: clamp(60px, 10vw, 100px) clamp(18px, 3vw, 36px) clamp(40px, 6vw, 60px);
  }

  .hero__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero__badge {
    display: inline-block;
    border-radius: 999px;
    border: 1px solid #e4e0d8;
    background: #fff;
    font-size: 12px;
    padding: 6px 16px;
    color: #5f5f5f;
    letter-spacing: 0.04em;
    margin-bottom: 20px;
  }

  .hero__title {
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-size: clamp(2rem, 5vw, 3rem);
    color: #1b1b1b;
    margin: 0 0 16px;
    line-height: 1.15;
  }

  .hero__description {
    color: #5f5f5f;
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 640px;
    margin: 0;
  }

  /* Shared section styles */
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(18px, 3vw, 36px);
  }

  .section-heading {
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-size: 1.5rem;
    color: #1b1b1b;
    margin: 0 0 24px;
  }

  /* What I Build */
  .what-i-build {
    background: #f4f2ed;
    border-radius: 20px;
    padding: clamp(20px, 3vw, 34px);
    margin: 32px clamp(18px, 3vw, 36px);
  }

  .what-i-build .section-container {
    padding: 0;
  }

  .build-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .build-list__item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: #fff;
    border: 1px solid #e6e2db;
    border-radius: 16px;
    padding: 18px 20px;
  }

  .build-list__icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    color: #1b1b1b;
    margin-top: 2px;
  }

  .build-list__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .build-list__content {
    font-size: 0.95rem;
    line-height: 1.55;
    color: #5f5f5f;
  }

  .build-list__label {
    color: #1b1b1b;
    font-weight: 600;
  }

  /* Technologies */
  .technologies {
    padding: clamp(40px, 5vw, 60px) 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tag {
    display: inline-block;
    border-radius: 999px;
    border: 1px solid #e4e0d8;
    background: #fff;
    font-size: 12px;
    padding: 6px 14px;
    color: #5f5f5f;
    letter-spacing: 0.02em;
  }

  /* Approach */
  .approach {
    padding: 0 0 clamp(40px, 5vw, 60px);
  }

  .approach__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: #5f5f5f;
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 720px;
  }

  .approach__body p {
    margin: 0;
  }

  /* CTA */
  .cta {
    background: #f4f2ed;
    border-radius: 20px;
    padding: clamp(40px, 5vw, 60px) clamp(20px, 3vw, 34px);
    margin: 0 clamp(18px, 3vw, 36px) clamp(40px, 5vw, 60px);
    text-align: center;
  }

  .cta__container {
    max-width: 600px;
    margin: 0 auto;
  }

  .cta__title {
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: #1b1b1b;
    margin: 0 0 12px;
  }

  .cta__text {
    color: #666;
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0 0 28px;
  }

  .cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1b1b1b;
    color: #fff;
    border-radius: 999px;
    padding: 14px 28px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s;
  }

  .cta__btn:hover {
    background: #333;
  }

  .cta__btn :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
