---
import PageLayout from "@layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@config/site";
import { getBreadcrumbJsonLd } from "@/lib/seo";

const breadcrumbJsonLd = getBreadcrumbJsonLd([
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
  { name: "AI Automation", url: `${siteConfig.url}/services/ai-automation` },
]);

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "AI Automation Services",
  description: "AI automation services for businesses in Zimbabwe and Africa. Automate repetitive work with AI workflows, document processing, WhatsApp automation, and smart business integrations.",
  provider: { "@type": "Person", name: "Vincent Mugondora", url: siteConfig.url },
  areaServed: [
    { "@type": "Country", name: "Zimbabwe" },
    { "@type": "Continent", name: "Africa" },
  ],
  serviceType: "AI Automation",
};
---

<PageLayout title="AI Automation Services for Businesses in Zimbabwe | Workflow Automation" description="AI automation services for businesses in Zimbabwe and Africa. Automate repetitive work with AI workflows, document processing, WhatsApp automation, and smart business integrations.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <!-- Hero -->
  <section class="hero">
    <div class="hero__container">
      <span class="hero__badge">Services</span>
      <h1 class="hero__title">AI Automation Services</h1>
      <p class="hero__description">
        AI automation services for businesses that want to reduce repetitive work, improve response times, and free teams for higher-value tasks. I build workflow automation, document processing, and AI-powered systems for real-world operations in Zimbabwe and beyond.
      </p>
    </div>
  </section>

  <!-- What I Build -->
  <section class="what-i-build">
    <div class="section-container">
      <h2 class="section-heading">What I Automate</h2>
      <ul class="build-list">
        <li class="build-list__item">
          <span class="build-list__icon"><Icon name="lucide:file-text" /></span>
          <div class="build-list__content">
            <strong class="build-list__label">Document Processing</strong>
            <span class="build-list__text"> — Automatically extract, categorise, and route information from invoices, contracts, and business documents.</span>
          </div>
        </li>
        <li class="build-list__item">
          <span class="build-list__icon"><Icon name="lucide:workflow" /></span>
          <div class="build-list__content">
            <strong class="build-list__label">Workflow Automation</strong>
            <span class="build-list__text"> — Connect your tools and automate multi-step business processes with intelligent decision-making.</span>
          </div>
        </li>
        <li class="build-list__item">
          <span class="build-list__icon"><Icon name="lucide:bar-chart-3" /></span>
          <div class="build-list__content">
            <strong class="build-list__label">Data Processing</strong>
            <span class="build-list__text"> — Automated data entry, categorisation, and analysis that would take your team hours to do manually.</span>
          </div>
        </li>
        <li class="build-list__item">
          <span class="build-list__icon"><Icon name="lucide:mail" /></span>
          <div class="build-list__content">
            <strong class="build-list__label">Communication Automation</strong>
            <span class="build-list__text"> — Intelligent email responses, message routing, and customer communication that maintains a human touch.</span>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- Technologies -->
  <section class="technologies">
    <div class="section-container">
      <h2 class="section-heading">Technologies</h2>
      <div class="tags">
        {["AI Agents", "LLMs", "Python", "APIs", "Webhooks", "n8n", "Make", "Custom Integrations", "WhatsApp Business"].map((t) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Content / Approach -->
  <section class="approach">
    <div class="section-container">
      <h2 class="section-heading">The Value of Automation</h2>
      <div class="approach__body">
        <p>Most businesses have processes that take hours of repetitive work every week — data entry, document handling, email responses, report generation. AI can handle these tasks accurately and consistently.</p>
        <p>I build automation solutions that integrate with your existing tools and workflows. No need to replace your systems — I connect them intelligently so they work together with minimal manual intervention.</p>
        <p><strong>Practical automation opportunities:</strong> WhatsApp customer support, invoice and receipt processing, sales follow-up, internal documentation lookup, and automated reporting.</p>
        <p>Every automation project starts with identifying the highest-impact opportunities: tasks that are time-consuming, error-prone, and well-defined enough for AI to handle reliably. For business owners evaluating this, see <a href="/writing/how-zimbabwean-businesses-can-use-ai">How Zimbabwean Businesses Can Use AI</a> or understand the core technology in <a href="/writing/ai-agents-explained-for-beginners">What Are AI Agents?</a>. If you need a broader implementation strategy, explore my <a href="/services/ai-solutions">AI solutions for businesses</a>.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="cta__container">
      <h2 class="cta__title">Want to automate your workflows?</h2>
      <p class="cta__text">Tell me which processes are taking up your team's time and I'll suggest what can be automated.</p>
      <a class="cta__btn" href="/contact">
        Start a conversation
        <Icon name="lucide:arrow-up-right" />
      </a>
    </div>
  </section>
</PageLayout>

<style>
  /* Hero */
  .hero {
    background: #f2f0ec;
    padding: clamp(60px, 10vw, 100px) clamp(18px, 3vw, 36px) clamp(40px, 6vw, 60px);
  }

  .hero__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero__badge {
    display: inline-block;
    border-radius: 999px;
    border: 1px solid #e4e0d8;
    background: #fff;
    font-size: 12px;
    padding: 6px 16px;
    color: #5f5f5f;
    letter-spacing: 0.04em;
    margin-bottom: 20px;
  }

  .hero__title {
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-size: clamp(2rem, 5vw, 3rem);
    color: #1b1b1b;
    margin: 0 0 16px;
    line-height: 1.15;
  }

  .hero__description {
    color: #5f5f5f;
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 640px;
    margin: 0;
  }

  /* Shared section styles */
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(18px, 3vw, 36px);
  }

  .section-heading {
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-size: 1.5rem;
    color: #1b1b1b;
    margin: 0 0 24px;
  }

  /* What I Build */
  .what-i-build {
    background: #f4f2ed;
    border-radius: 20px;
    padding: clamp(20px, 3vw, 34px);
    margin: 32px clamp(18px, 3vw, 36px);
  }

  .what-i-build .section-container {
    padding: 0;
  }

  .build-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .build-list__item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: #fff;
    border: 1px solid #e6e2db;
    border-radius: 16px;
    padding: 18px 20px;
  }

  .build-list__icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    color: #1b1b1b;
    margin-top: 2px;
  }

  .build-list__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .build-list__content {
    font-size: 0.95rem;
    line-height: 1.55;
    color: #5f5f5f;
  }

  .build-list__label {
    color: #1b1b1b;
    font-weight: 600;
  }

  /* Technologies */
  .technologies {
    padding: clamp(40px, 5vw, 60px) 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tag {
    display: inline-block;
    border-radius: 999px;
    border: 1px solid #e4e0d8;
    background: #fff;
    font-size: 12px;
    padding: 6px 14px;
    color: #5f5f5f;
    letter-spacing: 0.02em;
  }

  /* Approach */
  .approach {
    padding: 0 0 clamp(40px, 5vw, 60px);
  }

  .approach__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: #5f5f5f;
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 720px;
  }

  .approach__body p {
    margin: 0;
  }

  /* CTA */
  .cta {
    background: #f4f2ed;
    border-radius: 20px;
    padding: clamp(40px, 5vw, 60px) clamp(20px, 3vw, 34px);
    margin: 0 clamp(18px, 3vw, 36px) clamp(40px, 5vw, 60px);
    text-align: center;
  }

  .cta__container {
    max-width: 600px;
    margin: 0 auto;
  }

  .cta__title {
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: #1b1b1b;
    margin: 0 0 12px;
  }

  .cta__text {
    color: #666;
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0 0 28px;
  }

  .cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1b1b1b;
    color: #fff;
    border-radius: 999px;
    padding: 14px 28px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s;
  }

  .cta__btn:hover {
    background: #333;
  }

  .cta__btn :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
