---
import PageLayout from "@layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@config/site";
import { getBreadcrumbJsonLd, getSpeakableJsonLd } from "@/lib/seo";
import "@fontsource-variable/lora";

const breadcrumbJsonLd = getBreadcrumbJsonLd([
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
  { name: "AI Automation", url: `${siteConfig.url}/services/ai-automation` },
]);

const speakableJsonLd = getSpeakableJsonLd({
  url: `${siteConfig.url}/services/ai-automation`,
  title: "AI Automation Services for Businesses in Zimbabwe",
});

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "AI Automation Services",
  description: "AI automation services for businesses in Zimbabwe and Africa. Automate repetitive work with AI workflows, document processing, WhatsApp automation, and smart business integrations.",
  provider: { "@type": "Person", name: "Vincent Mugondora", url: siteConfig.url },
  areaServed: [
    { "@type": "Country", name: "Zimbabwe" },
    { "@type": "Continent", name: "Africa" },
  ],
  serviceType: "AI Automation",
};
---

<PageLayout title="AI Automation Services for Businesses in Zimbabwe | Workflow Automation" description="AI automation services for businesses in Zimbabwe and Africa. Automate repetitive work with AI workflows, document processing, WhatsApp automation, and smart business integrations.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(speakableJsonLd)} />

  <!-- Hero -->
  <section class="pt-[72px] py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <span class="inline-block font-display text-[12px] text-[var(--color-text-secondary)] border border-[var(--color-card-border)] rounded-full px-4 py-1 mb-6">
        Services
      </span>
      <h1 class="font-display italic text-[48px] md:text-[64px] lg:text-[72px] text-[var(--color-text-primary)] leading-[1.05] font-bold tracking-tight">
        AI <span class="marker-highlight">Automation</span>
      </h1>
      <p class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] mt-6 max-w-[600px] leading-relaxed">
        AI automation services for businesses that want to reduce repetitive work, improve response times, and free teams for higher-value tasks. I build workflow automation, document processing, and AI-powered systems for real-world operations.
      </p>
    </div>
  </section>

  <!-- What I Automate -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-8 tracking-tight leading-tight">
        What I <span class="scribble-underline">automate</span>
      </h2>

      <div class="space-y-4">
        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-[10px] bg-[var(--color-secondary)] flex items-center justify-center flex-shrink-0 text-[var(--color-text-primary)]">
            <Icon name="lucide:file-text" class="w-5 h-5" />
          </div>
          <div>
            <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">Document Processing</h3>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">Automatically extract, categorise, and route information from invoices, contracts, and business documents.</p>
          </div>
        </div>

        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-[10px] bg-[var(--color-secondary)] flex items-center justify-center flex-shrink-0 text-[var(--color-text-primary)]">
            <Icon name="lucide:workflow" class="w-5 h-5" />
          </div>
          <div>
            <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">Workflow Automation</h3>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">Connect your tools and automate multi-step business processes with intelligent decision-making.</p>
          </div>
        </div>

        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-[10px] bg-[var(--color-secondary)] flex items-center justify-center flex-shrink-0 text-[var(--color-text-primary)]">
            <Icon name="lucide:bar-chart-3" class="w-5 h-5" />
          </div>
          <div>
            <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">Data Processing</h3>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">Automated data entry, categorisation, and analysis that would take your team hours to do manually.</p>
          </div>
        </div>

        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-[10px] bg-[var(--color-secondary)] flex items-center justify-center flex-shrink-0 text-[var(--color-text-primary)]">
            <Icon name="lucide:mail" class="w-5 h-5" />
          </div>
          <div>
            <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">Communication Automation</h3>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">Intelligent email responses, message routing, and customer communication that maintains a human touch.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technologies -->
  <section class="py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-6 tracking-tight leading-tight">
        Technologies
      </h2>
      <div class="flex flex-wrap gap-2">
        {["AI Agents", "LLMs", "Python", "APIs", "Webhooks", "n8n", "Make", "Custom Integrations", "WhatsApp Business"].map((t) => (
          <span class="font-body text-[12px] text-[var(--color-text-muted)] border border-[var(--color-card-border)] rounded-full px-4 py-1.5">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- The Value of Automation -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-6 tracking-tight leading-tight">
        The value of <span class="scribble-circle">automation</span>
      </h2>
      <div class="space-y-5 font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] leading-relaxed max-w-[640px]">
        <p>Most businesses have processes that take hours of repetitive work every week — data entry, document handling, email responses, report generation. AI can handle these tasks accurately and consistently.</p>
        <p>I build automation solutions that integrate with your existing tools and workflows. No need to replace your systems — I connect them intelligently so they work together with minimal manual intervention.</p>
        <p>Every automation project starts with identifying the highest-impact opportunities: tasks that are time-consuming, error-prone, and well-defined enough for AI to handle reliably.</p>
      </div>

      <div class="mt-10 bg-white rounded-[16px] border border-[var(--color-card-border)] p-6">
        <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight mb-3">Learn more</h3>
        <ul class="space-y-2 font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed">
          <li><a href="/writing/how-zimbabwean-businesses-can-use-ai" class="text-[var(--color-primary)] hover:underline">How Zimbabwean Businesses Can Use AI</a></li>
          <li><a href="/writing/ai-agents-explained-for-beginners" class="text-[var(--color-primary)] hover:underline">What Are AI Agents?</a></li>
          <li><a href="/services/ai-solutions" class="text-[var(--color-primary)] hover:underline">AI Solutions for Businesses</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-28">
    <div class="max-w-[800px] mx-auto px-4 md:px-10 text-center">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-4 tracking-tight leading-tight">
        Want to <span class="marker-highlight">automate</span> your workflows?
      </h2>
      <p class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] leading-relaxed max-w-[500px] mx-auto">
        Tell me which processes are taking up your team's time and I'll suggest what can be automated.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 px-8 py-3 bg-[var(--color-primary)] text-white font-body text-[14px] font-medium rounded-[10px] hover:bg-[var(--color-primary-hover)] transition-colors duration-200 mt-8"
      >
        Start a conversation
        <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
      </a>
    </div>
  </section>
</PageLayout>

<style>
  .marker-highlight {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }
  .marker-highlight::before {
    content: "";
    position: absolute;
    left: -0.08em;
    right: -0.08em;
    bottom: 0.05em;
    height: 45%;
    background-color: #FFB800;
    border-radius: 20% 5% 15% 8%;
    z-index: -1;
    transform: rotate(-1deg);
  }

  .scribble-circle {
    position: relative;
    display: inline-block;
  }
  .scribble-circle::after {
    content: "";
    position: absolute;
    inset: -18% -12% -22% -12%;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 100' fill='none'><path d='M40 50 C 30 20, 80 8, 130 14 C 180 22, 195 55, 165 78 C 130 95, 60 92, 30 70 C 12 56, 18 32, 50 22' stroke='%2300CEB2' stroke-width='4' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
    z-index: -1;
  }

  .scribble-underline {
    position: relative;
    display: inline-block;
  }
  .scribble-underline::after {
    content: "";
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: -14px;
    height: 12px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 14' fill='none' preserveAspectRatio='none'><path d='M3 9 C 50 3, 110 12, 197 5' stroke='%231BB6F9' stroke-width='6' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
  }
</style>
