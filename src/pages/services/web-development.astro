---
import PageLayout from "@layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@config/site";
import { getBreadcrumbJsonLd, getSpeakableJsonLd } from "@/lib/seo";

const breadcrumbJsonLd = getBreadcrumbJsonLd([
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
  { name: "Web Development", url: `${siteConfig.url}/services/web-development` },
]);

const speakableJsonLd = getSpeakableJsonLd({
  url: `${siteConfig.url}/services/web-development`,
  title: "Web Development Services in Zimbabwe",
});

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Web Development Services",
  description: "Fast, accessible, SEO-friendly web development services by Vincent Mugondora. Websites and web applications built for performance in Zimbabwe and Africa.",
  provider: { "@type": "Person", name: "Vincent Mugondora", url: siteConfig.url },
  areaServed: [
    { "@type": "Country", name: "Zimbabwe" },
    { "@type": "Continent", name: "Africa" },
  ],
  serviceType: "Web Development",
};
---

<PageLayout title="Web Development Services in Zimbabwe" description="Fast, accessible, SEO-friendly web development services by Vincent Mugondora. Websites and web applications built for performance in Zimbabwe and Africa.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <!-- Hero -->
  <section class="pt-[72px] py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <span class="inline-block font-display text-[12px] text-[var(--color-text-secondary)] border border-[var(--color-card-border)] rounded-full px-4 py-1 mb-6">
        Services
      </span>
      <h1 class="font-display italic text-[48px] md:text-[64px] lg:text-[72px] text-[var(--color-text-primary)] leading-[1.05] font-bold tracking-tight">
        Web <span class="marker-highlight">Development</span>
      </h1>
      <p class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] mt-6 max-w-[600px] leading-relaxed">
        Fast, accessible websites and web applications built for performance on African internet conditions. SEO-friendly by default, optimised for real users.
      </p>
    </div>
  </section>

  <!-- What I Build -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-8 tracking-tight leading-tight">
        What I <span class="scribble-underline">build</span>
      </h2>

      <div class="space-y-4">
        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-[10px] bg-[var(--color-secondary)] flex items-center justify-center flex-shrink-0 text-[var(--color-text-primary)]">
            <Icon name="lucide:briefcase" class="w-5 h-5" />
          </div>
          <div>
            <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">Business Websites</h3>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">Professional, fast-loading websites that represent your brand and convert visitors.</p>
          </div>
        </div>

        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-[10px] bg-[var(--color-secondary)] flex items-center justify-center flex-shrink-0 text-[var(--color-text-primary)]">
            <Icon name="lucide:layout" class="w-5 h-5" />
          </div>
          <div>
            <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">Web Applications</h3>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">Interactive applications with authentication, dashboards, and complex functionality.</p>
          </div>
        </div>

        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-[10px] bg-[var(--color-secondary)] flex items-center justify-center flex-shrink-0 text-[var(--color-text-primary)]">
            <Icon name="lucide:user" class="w-5 h-5" />
          </div>
          <div>
            <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">Portfolio & Personal Sites</h3>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">Developer portfolios, personal brands, and content sites built for SEO.</p>
          </div>
        </div>

        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-[10px] bg-[var(--color-secondary)] flex items-center justify-center flex-shrink-0 text-[var(--color-text-primary)]">
            <Icon name="lucide:rocket" class="w-5 h-5" />
          </div>
          <div>
            <h3 class="font-display italic text-[20px] font-bold text-[var(--color-text-primary)] tracking-tight">Landing Pages</h3>
            <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">High-converting landing pages for products, services, and campaigns.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technologies -->
  <section class="py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-6 tracking-tight leading-tight">
        Technologies
      </h2>
      <div class="flex flex-wrap gap-2">
        {["Astro", "Next.js", "React", "Tailwind CSS", "TypeScript", "Cloudflare Pages", "Vercel", "SEO", "Core Web Vitals"].map((t) => (
          <span class="font-body text-[12px] text-[var(--color-text-muted)] border border-[var(--color-card-border)] rounded-full px-4 py-1.5">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Performance Matters -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-6 tracking-tight leading-tight">
        Why <span class="scribble-circle">performance</span> matters
      </h2>
      <div class="space-y-5 font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] leading-relaxed max-w-[640px]">
        <p>In Zimbabwe and across Africa, internet speeds vary widely. A website that loads in 1 second on fibre takes 8 seconds on mobile data. Most visitors won't wait that long.</p>
        <p>I build websites with performance as a first-class requirement — not an afterthought. Static generation, optimised images, minimal JavaScript, and edge deployment on Cloudflare mean your site loads fast everywhere.</p>
        <p>Every website I build scores 90+ on Google PageSpeed Insights and follows accessibility best practices (WCAG guidelines), ensuring your content reaches the widest possible audience.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-28">
    <div class="max-w-[800px] mx-auto px-4 md:px-10 text-center">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-4 tracking-tight leading-tight">
        Need a <span class="marker-highlight">website</span>?
      </h2>
      <p class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] leading-relaxed max-w-[500px] mx-auto">
        Tell me about your project and I'll get back with a clear direction.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 px-8 py-3 bg-[var(--color-primary)] text-white font-body text-[14px] font-medium rounded-[10px] hover:bg-[var(--color-primary-hover)] transition-colors duration-200 mt-8"
      >
        Start a conversation
        <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
      </a>
    </div>
  </section>
</PageLayout>

<style>
  .marker-highlight {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }
  .marker-highlight::before {
    content: "";
    position: absolute;
    left: -0.08em;
    right: -0.08em;
    bottom: 0.05em;
    height: 45%;
    background-color: #FFB800;
    border-radius: 20% 5% 15% 8%;
    z-index: -1;
    transform: rotate(-1deg);
  }

  .scribble-circle {
    position: relative;
    display: inline-block;
  }
  .scribble-circle::after {
    content: "";
    position: absolute;
    inset: -18% -12% -22% -12%;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 100' fill='none'><path d='M40 50 C 30 20, 80 8, 130 14 C 180 22, 195 55, 165 78 C 130 95, 60 92, 30 70 C 12 56, 18 32, 50 22' stroke='%2300CEB2' stroke-width='4' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
    z-index: -1;
  }

  .scribble-underline {
    position: relative;
    display: inline-block;
  }
  .scribble-underline::after {
    content: "";
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: -14px;
    height: 12px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 14' fill='none' preserveAspectRatio='none'><path d='M3 9 C 50 3, 110 12, 197 5' stroke='%231BB6F9' stroke-width='6' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
  }
</style>
