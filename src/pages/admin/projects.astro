---
import AdminLayout from "@layouts/AdminLayout.astro";
export const prerender = false;
---

<AdminLayout title="Projects" active="projects">
  <div class="page-header">
    <h1>Projects</h1>
    <button class="btn btn-primary" onclick="showForm()">+ New Project</button>
  </div>

  <div class="card" id="form-card" style="display: none; margin-bottom: 1.5rem;">
    <h3 style="margin-bottom: 1rem;" id="form-title">New Project</h3>
    <form id="item-form">
      <input type="hidden" id="item-id" />
      <div class="form-row">
        <div class="form-group">
          <label for="title">Title</label>
          <input type="text" id="title" required />
        </div>
        <div class="form-group">
          <label for="slug">Slug</label>
          <input type="text" id="slug" required />
        </div>
      </div>
      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" rows="3" required></textarea>
      </div>
      <div class="form-group">
        <label for="problem">Problem</label>
        <textarea id="problem" rows="3"></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="role">Role</label>
          <input type="text" id="role" />
        </div>
        <div class="form-group">
          <label for="category">Category</label>
          <input type="text" id="category" />
        </div>
      </div>
      <div class="form-group">
        <label for="technologies">Technologies (comma-separated)</label>
        <input type="text" id="technologies" placeholder="React, Node.js, PostgreSQL" />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="image">Image URL</label>
          <input type="url" id="image" />
        </div>
        <div class="form-group">
          <label for="image_alt">Image Alt Text</label>
          <input type="text" id="image_alt" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="github">GitHub URL</label>
          <input type="url" id="github" />
        </div>
        <div class="form-group">
          <label for="live">Live URL</label>
          <input type="url" id="live" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="status">Status</label>
          <select id="status">
            <option value="active">Active</option>
            <option value="completed">Completed</option>
            <option value="paused">Paused</option>
          </select>
        </div>
        <div class="form-group">
          <label for="published_at">Published Date</label>
          <input type="date" id="published_at" />
        </div>
      </div>
      <div class="form-group">
        <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
          <input type="checkbox" id="featured" /> Featured project
        </label>
      </div>
      <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
        <button type="submit" class="btn btn-primary">Save</button>
        <button type="button" class="btn btn-secondary" onclick="hideForm()">Cancel</button>
      </div>
    </form>
  </div>

  <div class="card">
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Status</th>
            <th>Featured</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="items-table"></tbody>
      </table>
      <div class="empty-state" id="empty" style="display: none;">
        <p>No projects yet.</p>
      </div>
    </div>
  </div>

  <script is:inline>
    let items = [];

    async function loadItems() {
      items = await apiCall('/api/projects');
      renderTable();
    }

    function renderTable() {
      const tbody = document.getElementById('items-table');
      const empty = document.getElementById('empty');
      if (!items.length) { tbody.innerHTML = ''; empty.style.display = 'block'; return; }
      empty.style.display = 'none';
      tbody.innerHTML = items.map(p => `
        <tr>
          <td><strong>${p.title}</strong></td>
          <td>${p.category || '-'}</td>
          <td><span class="badge ${p.status === 'active' ? 'badge-green' : p.status === 'completed' ? 'badge-blue' : 'badge-gray'}">${p.status}</span></td>
          <td>${p.featured ? 'Yes' : '-'}</td>
          <td class="actions">
            <button class="btn btn-secondary btn-sm" onclick="editItem(${p.id})">Edit</button>
            <button class="btn btn-danger btn-sm" onclick="deleteItem(${p.id})">Delete</button>
          </td>
        </tr>
      `).join('');
    }

    function showForm(item = null) {
      document.getElementById('form-card').style.display = 'block';
      document.getElementById('form-title').textContent = item ? 'Edit Project' : 'New Project';
      document.getElementById('item-id').value = item ? item.id : '';
      document.getElementById('title').value = item ? item.title : '';
      document.getElementById('slug').value = item ? item.slug : '';
      document.getElementById('description').value = item ? item.description : '';
      document.getElementById('problem').value = item ? (item.problem || '') : '';
      document.getElementById('role').value = item ? (item.role || '') : '';
      document.getElementById('category').value = item ? (item.category || '') : '';
      const techs = item ? (Array.isArray(item.technologies) ? item.technologies.join(', ') : '') : '';
      document.getElementById('technologies').value = techs;
      document.getElementById('image').value = item ? (item.image || '') : '';
      document.getElementById('image_alt').value = item ? (item.image_alt || item.imageAlt || '') : '';
      document.getElementById('github').value = item ? (item.github || '') : '';
      document.getElementById('live').value = item ? (item.live || '') : '';
      document.getElementById('status').value = item ? (item.status || 'active') : 'active';
      document.getElementById('published_at').value = item ? (item.published_at || item.publishedAt || '') : new Date().toISOString().split('T')[0];
      document.getElementById('featured').checked = item ? item.featured : false;
    }

    function hideForm() { document.getElementById('form-card').style.display = 'none'; }

    function editItem(id) {
      const item = items.find(p => p.id === id);
      if (item) showForm(item);
    }

    async function deleteItem(id) {
      if (!confirm('Delete this project?')) return;
      try {
        await apiCall('/api/projects', 'DELETE', { id });
        showToast('Project deleted');
        loadItems();
      } catch (e) { showToast(e.message, 'error'); }
    }

    document.getElementById('item-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = document.getElementById('item-id').value;
      const techStr = document.getElementById('technologies').value;
      const data = {
        title: document.getElementById('title').value,
        slug: document.getElementById('slug').value,
        description: document.getElementById('description').value,
        problem: document.getElementById('problem').value || null,
        role: document.getElementById('role').value || null,
        category: document.getElementById('category').value || null,
        technologies: techStr ? techStr.split(',').map(t => t.trim()) : [],
        image: document.getElementById('image').value || null,
        image_alt: document.getElementById('image_alt').value || null,
        github: document.getElementById('github').value || null,
        live: document.getElementById('live').value || null,
        status: document.getElementById('status').value,
        published_at: document.getElementById('published_at').value || null,
        featured: document.getElementById('featured').checked,
      };
      try {
        if (id) {
          await apiCall('/api/projects', 'PUT', { id: Number(id), ...data });
          showToast('Project updated');
        } else {
          await apiCall('/api/projects', 'POST', data);
          showToast('Project created');
        }
        hideForm();
        loadItems();
      } catch (e) { showToast(e.message, 'error'); }
    });

    document.getElementById('title').addEventListener('input', (e) => {
      if (!document.getElementById('item-id').value) {
        document.getElementById('slug').value = e.target.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      }
    });

    loadItems();
    if (new URLSearchParams(window.location.search).has('new')) showForm();
  </script>
</AdminLayout>
