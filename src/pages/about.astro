---
import PageLayout from "@layouts/PageLayout.astro";
import { getProfilePageJsonLd, getBreadcrumbJsonLd } from "@/lib/seo";
import { siteConfig } from "@config/site";

const profileJsonLd = getProfilePageJsonLd();
const breadcrumbJsonLd = getBreadcrumbJsonLd([
  { name: "Home", url: siteConfig.url },
  { name: "About", url: `${siteConfig.url}/about` },
]);
---

<PageLayout title="About Vincent Mugondora — Software Developer & AI Builder in Zimbabwe" description="About Vincent Mugondora — software engineer, AI builder, educator and entrepreneur from Zimbabwe. Building intelligent solutions and teaching developers.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(profileJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <!-- Hero -->
  <section class="pt-[72px] py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-12 lg:gap-16 items-start">
        <!-- Left column -->
        <div>
          <span class="inline-block font-display text-[12px] text-[var(--color-text-secondary)] border border-[var(--color-card-border)] rounded-full px-4 py-1 mb-6">
            Available For Work
          </span>
          <h1 class="font-display italic text-[48px] md:text-[72px] lg:text-[96px] text-[var(--color-text-primary)] leading-[1.05] font-bold tracking-tight">
            I build <span class="text-[var(--color-primary)]">intelligent</span> things.
          </h1>
          <p class="font-body text-[16px] text-[var(--color-text-secondary)] mt-6 max-w-[520px] leading-relaxed">
            I build technology, teach people how to build it, and explore how software and AI can solve meaningful problems in Zimbabwe and across Africa. My work is grounded in practical engineering, with a focus on AI systems, automation, and products that work in real conditions.
          </p>
          <div class="flex flex-col sm:flex-row sm:items-center gap-4 mt-8">
            <a
              href="/contact"
              class="inline-flex items-center justify-center px-8 py-3 bg-[var(--color-primary)] text-white font-body text-[14px] font-medium rounded-[10px] hover:bg-[var(--color-primary-hover)] transition-colors duration-200"
            >
              Work With Me
            </a>
            <a
              href="/work"
              class="inline-flex items-center justify-center px-8 py-3 border border-[var(--color-card-border)] text-[var(--color-text-primary)] font-body text-[14px] font-medium rounded-[10px] hover:bg-[var(--color-secondary)] transition-colors duration-200"
            >
              View My Work
            </a>
          </div>
        </div>

        <!-- Right column: profile card + info cards -->
        <div class="hidden sm:flex flex-col sm:flex-row lg:flex-col xl:flex-row gap-4">
          <!-- Profile card -->
          <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 w-full sm:w-[260px] min-h-[360px] flex flex-col">
            <div class="w-[84px] h-[84px] rounded-full overflow-hidden">
              <img src="/vincent.avif" alt="Vincent Mugondora" width="84" height="84" loading="eager" decoding="async" class="w-full h-full object-cover" />
            </div>
            <div class="mt-auto">
              <h3 class="font-display text-[24px] font-bold text-[var(--color-text-primary)] text-left">Vincent Mugondora</h3>
              <p class="font-body text-[14px] text-[var(--color-text-secondary)] mt-2 text-left">
                I believe good <span class="relative inline-block"><span class="absolute left-0 right-0 bottom-0 h-[45%] bg-[#FFB800] -z-10 rounded-sm"></span><span class="relative">technology</span></span> starts with understanding real problems. Not hype, not trends. Just meaningful solutions, practically built.
              </p>
            </div>
          </div>

          <!-- Info cards column -->
          <div class="flex flex-col gap-4 w-full sm:w-[240px]">
            <!-- Details card -->
            <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 min-h-[168px] flex flex-col">
              <div class="w-12 h-12 rounded-full bg-[var(--color-secondary)] flex items-center justify-center">
                <svg class="w-6 h-6 text-[var(--color-primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div class="mt-auto">
                <h4 class="font-display text-[20px] font-bold text-[var(--color-text-primary)] italic">Details</h4>
                <ol class="font-body text-[14px] text-[var(--color-text-secondary)] mt-2 space-y-1 list-decimal list-inside">
                  <li>Harare, Zimbabwe</li>
                  <li>GMT+2</li>
                  <li>Open to remote work</li>
                </ol>
              </div>
            </div>

            <!-- How I Work card -->
            <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 min-h-[168px] flex flex-col">
              <div class="w-12 h-12 rounded-full bg-[var(--color-secondary)] flex items-center justify-center">
                <svg class="w-6 h-6 text-[var(--color-primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" />
                </svg>
              </div>
              <div class="mt-auto">
                <h4 class="font-display text-[20px] font-bold text-[var(--color-text-primary)] italic">How I Work</h4>
                <ol class="font-body text-[14px] text-[var(--color-text-secondary)] mt-2 space-y-1 list-decimal list-inside">
                  <li>I start with the problem, not the tools.</li>
                  <li>I build, test, and iterate quickly.</li>
                  <li>Then I refine until it works reliably.</li>
                </ol>
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile: simple photo (visible only on small screens) -->
        <div class="sm:hidden flex justify-center">
          <img
            src="/vincent.avif"
            alt="Vincent Mugondora"
            width="260"
            height="320"
            loading="eager"
            decoding="async"
            class="w-[260px] h-[320px] rounded-[16px] border border-[var(--color-card-border)] object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Who I Am -->
  <section class="py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-6 tracking-tight leading-tight">
        More than a <span class="marker-highlight">developer</span>.
      </h2>
      <div class="space-y-5 font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] leading-relaxed">
        <p>
          I'm interested in the intersection of software engineering, artificial intelligence, education and entrepreneurship. I don't only want to write code — I want to understand problems and turn them into useful systems and products.
        </p>
        <p>
          I think about how technology fits into the real world: the constraints of bandwidth, the needs of actual users, the economics of building in Africa, and the responsibility that comes with teaching people to build.
        </p>
        <p>
          My work spans building production software, experimenting with AI applications, teaching the next generation of developers, and exploring how technology can create genuine opportunity.
        </p>
      </div>
    </div>
  </section>

  <!-- My Story -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-10 tracking-tight leading-tight">
        How I got <span class="scribble-underline">here</span>
      </h2>

      <div class="space-y-8">
        <div class="flex gap-6">
          <div class="flex flex-col items-center">
            <div class="w-3 h-3 rounded-full bg-[var(--color-primary)]"></div>
            <div class="w-px flex-1 bg-[var(--color-divider)]"></div>
          </div>
          <div class="pb-2">
            <p class="font-body text-[12px] font-semibold uppercase tracking-widest text-[var(--color-primary)]">Discovery</p>
            <p class="font-body text-[16px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">Discovered technology and became fascinated by how software could solve real-world problems.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="flex flex-col items-center">
            <div class="w-3 h-3 rounded-full bg-[var(--color-primary)]"></div>
            <div class="w-px flex-1 bg-[var(--color-divider)]"></div>
          </div>
          <div class="pb-2">
            <p class="font-body text-[12px] font-semibold uppercase tracking-widest text-[var(--color-primary)]">Learning</p>
            <p class="font-body text-[16px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">Started learning software development — HTML, CSS, JavaScript, then deeper into backend systems, databases, and architecture.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="flex flex-col items-center">
            <div class="w-3 h-3 rounded-full bg-[var(--color-primary)]"></div>
            <div class="w-px flex-1 bg-[var(--color-divider)]"></div>
          </div>
          <div class="pb-2">
            <p class="font-body text-[12px] font-semibold uppercase tracking-widest text-[var(--color-primary)]">Building</p>
            <p class="font-body text-[16px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">Built first real projects — web applications, APIs, and tools that people actually used.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="flex flex-col items-center">
            <div class="w-3 h-3 rounded-full bg-[var(--color-primary)]"></div>
            <div class="w-px flex-1 bg-[var(--color-divider)]"></div>
          </div>
          <div class="pb-2">
            <p class="font-body text-[12px] font-semibold uppercase tracking-widest text-[var(--color-primary)]">Teaching</p>
            <p class="font-body text-[16px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">Started teaching software development, mentoring students, and creating educational content.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="flex flex-col items-center">
            <div class="w-3 h-3 rounded-full bg-[var(--color-primary)]"></div>
            <div class="w-px flex-1 bg-[var(--color-divider)]"></div>
          </div>
          <div class="pb-2">
            <p class="font-body text-[12px] font-semibold uppercase tracking-widest text-[var(--color-primary)]">AI & Products</p>
            <p class="font-body text-[16px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">Moved deeper into AI — building intelligent applications, agents, and automation systems. Started building products.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="flex flex-col items-center">
            <div class="w-3 h-3 rounded-full bg-[var(--color-primary)]"></div>
          </div>
          <div class="pb-2">
            <p class="font-body text-[12px] font-semibold uppercase tracking-widest text-[var(--color-primary)]">Now</p>
            <p class="font-body text-[16px] text-[var(--color-text-secondary)] mt-1 leading-relaxed">Building for Zimbabwe and Africa — creating technology that solves problems for people who understand them firsthand.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What I Believe -->
  <section class="py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-4 tracking-tight leading-tight">
        Technology should create <span class="scribble-underline">opportunity</span>.
      </h2>
      <p class="font-body text-[16px] md:text-[18px] text-[var(--color-text-secondary)] mb-10 max-w-[700px] leading-relaxed">
        I believe technology is most valuable when it solves problems people actually experience.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6">
          <h3 class="font-display italic text-[22px] font-bold text-[var(--color-text-primary)] tracking-tight mb-2">Build for reality</h3>
          <p class="font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed">Technology should work in the environments where people actually use it.</p>
        </div>
        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6">
          <h3 class="font-display italic text-[22px] font-bold text-[var(--color-text-primary)] tracking-tight mb-2">Learn by building</h3>
          <p class="font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed">The fastest way to understand technology is to create with it.</p>
        </div>
        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6">
          <h3 class="font-display italic text-[22px] font-bold text-[var(--color-text-primary)] tracking-tight mb-2">Share what you learn</h3>
          <p class="font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed">Knowledge becomes more valuable when it helps someone else move forward.</p>
        </div>
        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6">
          <h3 class="font-display italic text-[22px] font-bold text-[var(--color-text-primary)] tracking-tight mb-2">Africa should build</h3>
          <p class="font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed">African developers shouldn't only consume technology. We should build systems that understand African problems and contexts.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What I Do -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-10 tracking-tight leading-tight">
        What I <span class="scribble-circle">Do</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <a href="/work" class="block group bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 hover:border-[var(--color-primary)] transition-colors">
          <h3 class="font-display italic text-[22px] font-bold text-[var(--color-text-primary)] tracking-tight mb-2">Software Engineering</h3>
          <p class="font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed">I design and build web applications, APIs and software systems.</p>
          <span class="inline-flex items-center font-body text-[13px] text-[var(--color-primary)] font-medium mt-3 group-hover:underline">Explore my work &rarr;</span>
        </a>
        <a href="/ai-lab" class="block group bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 hover:border-[var(--color-primary)] transition-colors">
          <h3 class="font-display italic text-[22px] font-bold text-[var(--color-text-primary)] tracking-tight mb-2">AI</h3>
          <p class="font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed">I explore AI applications, agents, automation and intelligent systems.</p>
          <span class="inline-flex items-center font-body text-[13px] text-[var(--color-primary)] font-medium mt-3 group-hover:underline">Explore AI Lab &rarr;</span>
        </a>
        <a href="/teaching" class="block group bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 hover:border-[var(--color-primary)] transition-colors">
          <h3 class="font-display italic text-[22px] font-bold text-[var(--color-text-primary)] tracking-tight mb-2">Education</h3>
          <p class="font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed">I teach software development and technology and mentor emerging developers.</p>
          <span class="inline-flex items-center font-body text-[13px] text-[var(--color-primary)] font-medium mt-3 group-hover:underline">Explore teaching &rarr;</span>
        </a>
        <a href="/work" class="block group bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 hover:border-[var(--color-primary)] transition-colors">
          <h3 class="font-display italic text-[22px] font-bold text-[var(--color-text-primary)] tracking-tight mb-2">Entrepreneurship</h3>
          <p class="font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed">I experiment with products and businesses designed around real problems.</p>
          <span class="inline-flex items-center font-body text-[13px] text-[var(--color-primary)] font-medium mt-3 group-hover:underline">Explore &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-10 tracking-tight leading-tight">
        Experience
      </h2>

      <div class="space-y-8">
        <div class="border-b border-[var(--color-divider)] pb-8">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-1 mb-2">
            <h3 class="font-display italic text-[22px] font-bold text-[var(--color-text-primary)] tracking-tight">Senior Instructor / Hub Lead</h3>
            <span class="font-body text-[13px] text-[var(--color-text-muted)]">2026 &mdash; Present</span>
          </div>
          <p class="font-body text-[14px] text-[var(--color-primary)] font-medium mb-2">Organization &middot; Zimbabwe</p>
          <ul class="font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed space-y-1">
            <li>Leading software development instruction and curriculum design</li>
            <li>Mentoring junior developers and managing student projects</li>
            <li>Building internal tools and AI-powered educational resources</li>
          </ul>
        </div>

        <div class="border-b border-[var(--color-divider)] pb-8">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-1 mb-2">
            <h3 class="font-display italic text-[22px] font-bold text-[var(--color-text-primary)] tracking-tight">Junior Software Developer Instructor</h3>
            <span class="font-body text-[13px] text-[var(--color-text-muted)]">2025 &mdash; 2026</span>
          </div>
          <p class="font-body text-[14px] text-[var(--color-primary)] font-medium mb-2">Organization &middot; Zimbabwe</p>
          <ul class="font-body text-[14px] text-[var(--color-text-secondary)] leading-relaxed space-y-1">
            <li>Teaching web development fundamentals and modern frameworks</li>
            <li>Creating practical assignments and project-based learning experiences</li>
          </ul>
        </div>
      </div>

      <a href="/cv" class="inline-flex items-center font-body text-[14px] text-[var(--color-primary)] font-medium mt-8 hover:underline">
        Download CV &rarr;
      </a>
    </div>
  </section>

  <!-- Education & Learning -->
  <section class="bg-[var(--color-secondary)] py-16 md:py-24">
    <div class="max-w-[900px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-10 tracking-tight leading-tight">
        Education & <span class="marker-highlight">Learning</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <div class="bg-white rounded-[12px] border border-[var(--color-card-border)] p-5">
          <h3 class="font-display italic text-[18px] font-bold text-[var(--color-text-primary)] tracking-tight">Software Engineering</h3>
          <p class="font-body text-[13px] text-[var(--color-text-secondary)] mt-1">Full-stack development, system design, architecture</p>
        </div>
        <div class="bg-white rounded-[12px] border border-[var(--color-card-border)] p-5">
          <h3 class="font-display italic text-[18px] font-bold text-[var(--color-text-primary)] tracking-tight">AI / Machine Learning</h3>
          <p class="font-body text-[13px] text-[var(--color-text-secondary)] mt-1">LLMs, AI agents, RAG, automation systems</p>
        </div>
        <div class="bg-white rounded-[12px] border border-[var(--color-card-border)] p-5">
          <h3 class="font-display italic text-[18px] font-bold text-[var(--color-text-primary)] tracking-tight">System Design</h3>
          <p class="font-body text-[13px] text-[var(--color-text-secondary)] mt-1">Scalable architecture, APIs, databases</p>
        </div>
        <div class="bg-white rounded-[12px] border border-[var(--color-card-border)] p-5">
          <h3 class="font-display italic text-[18px] font-bold text-[var(--color-text-primary)] tracking-tight">Product Development</h3>
          <p class="font-body text-[13px] text-[var(--color-text-secondary)] mt-1">Agile, user research, MVP methodology</p>
        </div>
        <div class="bg-white rounded-[12px] border border-[var(--color-card-border)] p-5">
          <h3 class="font-display italic text-[18px] font-bold text-[var(--color-text-primary)] tracking-tight">SEO & Growth</h3>
          <p class="font-body text-[13px] text-[var(--color-text-secondary)] mt-1">Technical SEO, content strategy, analytics</p>
        </div>
        <div class="bg-white rounded-[12px] border border-[var(--color-card-border)] p-5">
          <h3 class="font-display italic text-[18px] font-bold text-[var(--color-text-primary)] tracking-tight">Education</h3>
          <p class="font-body text-[13px] text-[var(--color-text-secondary)] mt-1">Curriculum design, technical instruction</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Certificates & Credentials -->
  <section class="py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10">
      <h2 class="font-display italic text-[36px] md:text-[48px] text-[var(--color-text-primary)] mb-4 tracking-tight leading-tight">
        Certificates & <span class="scribble-underline">Credentials</span>
      </h2>
      <p class="font-body text-[16px] text-[var(--color-text-secondary)] mb-10 max-w-[600px] leading-relaxed">
        Continuous learning validated through industry certifications and courses.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="certificates-grid">
        <div class="text-center py-8 col-span-full">
          <p class="font-body text-[14px] text-[var(--color-text-muted)]">Loading certificates...</p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (async function loadCertificates() {
      try {
        const res = await fetch('/api/certificates');
        if (!res.ok) return;
        const certs = await res.json();
        const grid = document.getElementById('certificates-grid');
        if (!certs.length) {
          grid.innerHTML = '<p class="font-body text-[14px] text-[var(--color-text-muted)] col-span-full text-center py-8">No certificates yet.</p>';
          return;
        }
        grid.innerHTML = certs.map(c => `
          <div class="bg-white rounded-[12px] border border-[var(--color-card-border)] p-5 flex flex-col">
            <div class="flex items-start gap-3 mb-3">
              <div class="w-10 h-10 rounded-full bg-[var(--color-secondary)] flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
