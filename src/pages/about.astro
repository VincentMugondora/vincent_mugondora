---
import PageLayout from "@layouts/PageLayout.astro";
import { siteConfig } from "@config/site";

const heroImage = "/vincent.avif";
---

<PageLayout title="About Vincent Mugondora | Software Developer & AI Builder" description="Learn about Vincent Mugondora — a Zimbabwean software developer, AI builder, and technology educator building useful software.">
  <main class="pt-[72px]">
    <!-- Hero Section -->
    <section class="max-w-[1200px] mx-auto px-6 md:px-10 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-12 lg:gap-16 items-start">
        <!-- Left column -->
        <div>
          <span class="inline-block font-[var(--font-display)] text-[16px] text-[var(--color-text-secondary)] border border-[var(--color-card-border)] rounded-full px-4 py-1 mb-6">
            Available For Work
          </span>
          <h1 class="font-[var(--font-display)] text-[48px] md:text-[72px] lg:text-[96px] text-[var(--color-text-primary)] leading-[1.05]">
            I do <span class="text-[var(--color-primary)]">software</span> things.
          </h1>
          <p class="font-[var(--font-body)] text-[18px] text-[var(--color-text-secondary)] mt-6 max-w-[520px]">
            I build digital products that solve real problems and work reliably.
            My work is grounded in solid engineering principles, with a mix of system design,
            AI integration, and a practical understanding of how software is actually built
            and used.
          </p>
          <div class="flex flex-col sm:flex-row sm:items-center gap-4 mt-8">
            <a
              href="/contact"
              class="flex-1 sm:flex-none inline-flex items-center justify-center px-8 py-3 bg-[var(--color-primary)] text-white font-[var(--font-body)] text-[16px] font-medium rounded-[10px] hover:bg-[var(--color-primary-hover)] transition-colors duration-200"
            >
              Work With Me
            </a>
            <a
              href={`mailto:${siteConfig.email}`}
              class="flex-1 sm:flex-none inline-flex items-center justify-center px-8 py-3 border border-[var(--color-card-border)] text-[var(--color-text-primary)] font-[var(--font-body)] text-[16px] font-medium rounded-[10px] hover:bg-[var(--color-secondary)] transition-colors duration-200"
            >
              Send Email
            </a>
          </div>
        </div>

        <!-- Right column: profile card + info cards -->
        <div class="hidden sm:flex flex-col sm:flex-row lg:flex-col xl:flex-row gap-4">
          <!-- Profile card -->
          <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 w-full sm:w-[260px] min-h-[360px] flex flex-col">
            <div class="w-[84px] h-[84px] rounded-full overflow-hidden bg-black">
              <img src={heroImage} alt="Vincent Mugondora" class="w-full h-full object-cover" />
            </div>
            <div class="mt-auto">
              <h3 class="font-[var(--font-display)] text-[24px] font-bold text-[var(--color-text-primary)] text-left">Vincent Mugondora</h3>
              <p class="font-[var(--font-body)] text-[16px] text-[var(--color-text-secondary)] mt-2 text-left">
                I believe good{" "}
                <span class="relative inline-block">
                  <span class="absolute left-0 right-0 bottom-0 h-[45%] bg-[var(--color-highlight-yellow)] -z-10 rounded-sm opacity-40"></span>
                  <span class="relative">Software</span>
                </span>{" "}
                starts with understanding people. Not assumptions, not hype. Just real problems, clearly solved.
              </p>
            </div>
          </div>

          <!-- Info cards column -->
          <div class="flex flex-col gap-4 w-full sm:w-[240px]">
            <!-- Details card -->
            <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 min-h-[280px] flex flex-col">
              <div class="w-14 h-14 rounded-full bg-[var(--color-secondary)] flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
              </div>
              <div class="mt-auto">
                <h4 class="font-[var(--font-display)] text-[20px] font-bold text-[var(--color-text-primary)] italic">Details</h4>
                <ol class="font-[var(--font-body)] text-[14px] text-[var(--color-text-secondary)] mt-2 space-y-1 list-decimal list-inside">
                  <li>Harare, Zimbabwe</li>
                  <li>GMT+2</li>
                  <li>Open to remote work</li>
                </ol>
              </div>
            </div>

            <!-- How I Work card -->
            <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 min-h-[280px] flex flex-col">
              <div class="w-14 h-14 rounded-full bg-[var(--color-secondary)] flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z"/><path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="M12 2v2"/><path d="M12 22v-2"/><path d="m17 20.66-1-1.73"/><path d="M11 10.27 7 3.34"/><path d="m20.66 17-1.73-1"/><path d="m3.34 7 1.73 1"/><path d="M14 12h8"/><path d="M2 12h2"/><path d="m20.66 7-1.73 1"/><path d="m3.34 17 1.73-1"/><path d="m17 3.34-1 1.73"/><path d="m11 13.73-4 6.93"/></svg>
              </div>
              <div class="mt-auto">
                <h4 class="font-[var(--font-display)] text-[20px] font-bold text-[var(--color-text-primary)] italic">How I Work</h4>
                <ol class="font-[var(--font-body)] text-[14px] text-[var(--color-text-secondary)] mt-2 space-y-1 list-decimal list-inside">
                  <li>I start with the problem, not the tools.</li>
                  <li>I build, test, and iterate quickly.</li>
                  <li>Then I refine until it's solid.</li>
                </ol>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Timeline Section -->
    <section class="max-w-[1200px] mx-auto px-6 md:px-10 py-16 md:py-24">
      <h2 class="font-[var(--font-display)] text-[36px] md:text-[48px] text-[var(--color-text-primary)]">
        How I got <span class="scribble-underline scribble-tight">here</span>.
      </h2>
      <p class="font-[var(--font-body)] text-[16px] text-[var(--color-text-secondary)] mt-2 max-w-[500px]">
        A timeline of the work I've done, what I've learned, and the experiences that shaped how I build today.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12 items-stretch">
        <!-- Timeline Card 1 -->
        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex flex-col h-full min-h-[440px]">
          <div class="h-[180px] flex items-start">
            <div class="w-14 h-14 rounded-full bg-[var(--color-secondary)] flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>
            </div>
          </div>
          <div>
            <p class="font-[var(--font-body)] text-[14px] text-[var(--color-text-muted)]">
              <span class="font-medium text-[var(--color-text-primary)]">Software Development</span> 2022 – Present
            </p>
            <h3 class="font-[var(--font-display)] text-[22px] font-bold text-[var(--color-text-primary)] italic mt-2">Full-Stack Engineer</h3>
            <p class="font-[var(--font-body)] text-[14px] text-[var(--color-text-secondary)] mt-3 leading-relaxed">
              Building web applications, APIs, and AI-integrated systems. Focused on creating reliable software that solves real problems for businesses and users.
            </p>
          </div>
        </div>

        <!-- Timeline Card 2 -->
        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex flex-col h-full min-h-[440px]">
          <div class="h-[180px] flex items-start">
            <div class="w-14 h-14 rounded-full bg-[var(--color-secondary)] flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
            </div>
          </div>
          <div>
            <p class="font-[var(--font-body)] text-[14px] text-[var(--color-text-muted)]">
              <span class="font-medium text-[var(--color-text-primary)]">AI & Automation</span> 2023 – Present
            </p>
            <h3 class="font-[var(--font-display)] text-[22px] font-bold text-[var(--color-text-primary)] italic mt-2">AI Builder</h3>
            <p class="font-[var(--font-body)] text-[14px] text-[var(--color-text-secondary)] mt-3 leading-relaxed">
              Exploring and building AI-powered solutions — from LLM integrations and intelligent agents to automation workflows that help businesses work more efficiently.
            </p>
          </div>
        </div>

        <!-- Timeline Card 3 -->
        <div class="bg-white rounded-[16px] border border-[var(--color-card-border)] p-6 flex flex-col h-full min-h-[440px]">
          <div class="h-[180px] flex items-start">
            <div class="w-14 h-14 rounded-full bg-[var(--color-secondary)] flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
            </div>
          </div>
          <div>
            <p class="font-[var(--font-body)] text-[14px] text-[var(--color-text-muted)]">
              <span class="font-medium text-[var(--color-text-primary)]">Education</span> 2023 – Present
            </p>
            <h3 class="font-[var(--font-display)] text-[22px] font-bold text-[var(--color-text-primary)] italic mt-2">Technology Educator</h3>
            <p class="font-[var(--font-body)] text-[14px] text-[var(--color-text-secondary)] mt-3 leading-relaxed">
              Teaching software development by focusing on fundamentals and real projects. Helping students understand how to think about problems, structure solutions, and write code that works.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Tools Section -->
    <section class="bg-[var(--color-secondary)] py-16 md:py-24">
      <div class="max-w-[1200px] mx-auto px-6 md:px-10 text-center">
        <h2 class="font-[var(--font-display)] text-[36px] md:text-[48px] text-[var(--color-text-primary)] italic">Tools I trust.</h2>
        <p class="font-[var(--font-body)] text-[16px] text-[var(--color-text-secondary)] mt-2">
          Not a long list. Just the tools I actually use and understand well.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-14 mt-12">
          <div class="flex flex-col items-center gap-2">
            <div class="w-14 h-14 rounded-full bg-white border border-[var(--color-card-border)] flex items-center justify-center">
              <span class="font-bold text-[var(--color-text-primary)] text-xs">TS</span>
            </div>
            <span class="text-[12px] text-[var(--color-text-secondary)]">TypeScript</span>
          </div>
          <div class="flex flex-col items-center gap-2">
            <div class="w-14 h-14 rounded-full bg-white border border-[var(--color-card-border)] flex items-center justify-center">
              <span class="font-bold text-[var(--color-text-primary)] text-xs">Py</span>
            </div>
            <span class="text-[12px] text-[var(--color-text-secondary)]">Python</span>
          </div>
          <div class="flex flex-col items-center gap-2">
            <div class="w-14 h-14 rounded-full bg-white border border-[var(--color-card-border)] flex items-center justify-center">
              <span class="font-bold text-[var(--color-text-primary)] text-xs">Re</span>
            </div>
            <span class="text-[12px] text-[var(--color-text-secondary)]">React</span>
          </div>
          <div class="flex flex-col items-center gap-2">
            <div class="w-14 h-14 rounded-full bg-white border border-[var(--color-card-border)] flex items-center justify-center">
              <span class="font-bold text-[var(--color-text-primary)] text-xs">Nj</span>
            </div>
            <span class="text-[12px] text-[var(--color-text-secondary)]">Node.js</span>
          </div>
          <div class="flex flex-col items-center gap-2">
            <div class="w-14 h-14 rounded-full bg-white border border-[var(--color-card-border)] flex items-center justify-center">
              <span class="font-bold text-[var(--color-text-primary)] text-xs">AI</span>
            </div>
            <span class="text-[12px] text-[var(--color-text-secondary)]">AI / LLMs</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</PageLayout>

<style>
  .scribble-underline {
    position: relative;
    display: inline-block;
  }
  .scribble-underline::after {
    content: "";
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: -14px;
    height: 12px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 14' fill='none' preserveAspectRatio='none'><path d='M3 9 C 50 3, 110 12, 197 5' stroke='%231BB6F9' stroke-width='6' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    transform: rotate(-2deg);
    pointer-events: none;
  }
  .scribble-underline.scribble-tight::after {
    bottom: -6px;
  }
</style>
