---
import PageLayout from "@layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";
import { getProfilePageJsonLd } from "@/lib/seo";

const heroImage = "/vincent.avif";

const profileJsonLd = getProfilePageJsonLd();

const workAreas = [
  {
    title: "Software Engineering",
    text: "Building practical applications with attention to structure, maintainability and the real problem behind the code.",
    icon: "lucide:code-2",
  },
  {
    title: "Web Development",
    text: "Creating fast, accessible web experiences that combine strong technical foundations with clear communication.",
    icon: "lucide:globe",
  },
  {
    title: "AI & Automation",
    text: "Exploring how AI agents, LLMs and automation can help people and organizations work more effectively.",
    icon: "lucide:bot",
  },
  {
    title: "Technology Education",
    text: "Teaching software development in a practical way so students and developers can understand, build and keep growing.",
    icon: "lucide:graduation-cap",
  },
  {
    title: "System Design",
    text: "Thinking through architecture, constraints, data flow and trade-offs before turning an idea into software.",
    icon: "lucide:layers",
  },
  {
    title: "Digital Products",
    text: "Shaping ideas into useful products, experiments and platforms with a builder's eye for execution.",
    icon: "lucide:rocket",
  },
];

const journey = [
  {
    label: "Learning to build",
    text: "Vincent's work begins with a builder's mindset: learning by making, asking better technical questions and using code to turn ideas into working systems.",
    icon: "lucide:hammer",
  },
  {
    label: "Engineering focus",
    text: "That focus grew into software engineering, web development and system architecture, with an emphasis on performance, clarity and maintainable foundations.",
    icon: "lucide:wrench",
  },
  {
    label: "Teaching technology",
    text: "Alongside building, Vincent teaches technology and software development, translating technical ideas into practical learning for students and developers.",
    icon: "lucide:book-open",
  },
  {
    label: "AI and entrepreneurship",
    text: "The current direction brings together AI, automation, digital products and entrepreneurship, with a particular interest in useful technology for Zimbabwe and Africa.",
    icon: "lucide:sparkles",
  },
];

const principles = [
  { text: "Performance is a product decision, not an afterthought.", icon: "lucide:gauge" },
  { text: "Simple systems are easier to understand, teach and improve.", icon: "lucide:minimize-2" },
  { text: "Continuous learning keeps the work honest.", icon: "lucide:refresh-cw" },
  { text: "The best technology starts with a real problem.", icon: "lucide:target" },
  { text: "Useful software should help people move forward.", icon: "lucide:arrow-up-right" },
];

const exploring = [
  "AI agents and practical automation",
  "System design and software architecture",
  "AI for education and developer learning",
  "Technology entrepreneurship in Zimbabwe and Africa",
  "Emerging technology that can solve local problems",
];
---

<PageLayout title="About Vincent Mugondora | Software Engineer & AI Builder" description="Learn about Vincent Mugondora, a Zimbabwean software engineer, AI builder, technology educator and entrepreneur building useful technology for Africa.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(profileJsonLd)} />

  <section class="about-hero">
    <div class="about-hero__panel">
      <div class="about-hero__content">
        <p class="badge">About Vincent</p>
        <h1 class="about-hero__title">Building technology, teaching people, and learning in public.</h1>
        <p class="about-hero__desc">
          Vincent Mugondora is a Zimbabwean software engineer, AI builder, technology educator and entrepreneur. He builds digital products, teaches practical software development and explores how AI and emerging technology can create opportunity in Zimbabwe, Africa and beyond.
        </p>
        <div class="about-hero__actions">
          <a class="btn btn--dark" href="/work">View Work</a>
          <a class="btn btn--outline" href="/contact">Start a Conversation</a>
        </div>
      </div>
      <figure class="about-hero__media">
        <img
          src={heroImage}
          alt="Vincent Mugondora"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="section-wrap" aria-labelledby="journey-title">
    <header class="section-header">
      <p class="badge">Journey</p>
      <h2 id="journey-title" class="section-title">From learning by building to building with purpose</h2>
      <p class="section-intro">A path shaped by curiosity, code and the drive to create something useful.</p>
    </header>

    <div class="journey-grid">
      {journey.map((item, index) => (
        <article class="journey-card">
          <span class="journey-card__icon"><Icon name={item.icon} /></span>
          <div class="journey-card__body">
            <h3>{item.label}</h3>
            <p>{item.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-wrap section-wrap--dark" aria-labelledby="work-title">
    <header class="section-header section-header--dark">
      <p class="badge badge--dark">Expertise</p>
      <h2 id="work-title" class="section-title section-title--light">What I Do</h2>
      <p class="section-intro section-intro--light">Code, teaching, systems and products.</p>
    </header>

    <div class="work-grid">
      {workAreas.map((area) => (
        <article class="work-card">
          <span class="work-card__icon"><Icon name={area.icon} /></span>
          <h3>{area.title}</h3>
          <p>{area.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-wrap" aria-labelledby="philosophy-title">
    <header class="section-header">
      <p class="badge">How I Think</p>
      <h2 id="philosophy-title" class="section-title">Useful software starts with clear thinking</h2>
      <p class="section-intro">I care about performance, simplicity and continuous learning because they make technology easier to trust, maintain and teach.</p>
    </header>

    <div class="principles-grid">
      {principles.map((principle) => (
        <article class="principle-card">
          <span class="principle-card__icon"><Icon name={principle.icon} /></span>
          <p>{principle.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-wrap" aria-labelledby="teaching-title">
    <header class="section-header">
      <p class="badge">Teaching & Impact</p>
      <h2 id="teaching-title" class="section-title">Helping people understand technology well enough to build with it</h2>
    </header>

    <div class="teaching-grid">
      <div class="teaching-content">
        <p>
          Vincent's work in technology education is grounded in practical software development. The goal is not to make technical topics sound impressive; it is to help students and developers understand how software works and how to apply that knowledge.
        </p>
        <p>
          Through teaching, writing, workshops and mentorship-focused work, he breaks down concepts in software engineering, AI, web development and system design for people who want to build real things.
        </p>
      </div>
      <aside class="teaching-panel">
        <h3>Teaching focus</h3>
        <ul>
          <li><Icon name="lucide:check" /> Practical software development</li>
          <li><Icon name="lucide:check" /> AI and software engineering concepts</li>
          <li><Icon name="lucide:check" /> System design for growing developers</li>
          <li><Icon name="lucide:check" /> Technology careers and learning paths</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section-wrap" aria-labelledby="exploring-title">
    <div class="exploring-grid">
      <div class="exploring-card">
        <p class="badge">Currently Exploring</p>
        <h2 id="exploring-title">The next layer of the work</h2>
        <p class="exploring-card__text">The current focus is learning and building around AI, automation, system design, software architecture and emerging technology that can be applied to real problems.</p>
        <ul class="exploring-list">
          {exploring.map((item) => (
            <li><Icon name="lucide:arrow-right" /> {item}</li>
          ))}
        </ul>
      </div>

      <div class="exploring-card exploring-card--dark">
        <p class="badge badge--dark">Beyond Code</p>
        <h2>A builder's view of problems</h2>
        <p class="exploring-card__text">Vincent's work also has an entrepreneurial side: looking for useful problems, shaping ideas into digital products and thinking about how technology companies can serve people well.</p>
        <p class="exploring-card__text">Zimnovate remains a separate commercial technology company identity, while this site is Vincent's personal home for engineering, teaching, speaking, writing and exploration.</p>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-inner">
      <h2>Building better technology and helping more people learn it.</h2>
      <p>The direction is ambitious, but still grounded: keep learning, keep building and make the work useful.</p>
      <a class="btn btn--dark" href="/contact">Start a Conversation</a>
    </div>
  </section>
</PageLayout>

<style>
  .about-hero {
    width: min(1200px, 100%);
    margin: 0 auto;
    padding: 100px clamp(18px, 3vw, 36px) 0;
  }

  .about-hero__panel {
    background: #f1f1ef;
    border-radius: 26px;
    padding: clamp(18px, 3vw, 34px);
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(18px, 2.5vw, 30px);
    align-items: center;
  }

  .about-hero__content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .about-hero__title {
    margin: 0;
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: #111;
    max-width: 18ch;
  }

  .about-hero__desc {
    margin: 0;
    color: #5f5f5f;
    line-height: 1.6;
    font-size: 0.95rem;
    max-width: 52ch;
  }

  .about-hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .about-hero__media {
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 4/5;
    background: #c9c9c9;
  }

  .about-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    filter: grayscale(1);
    transition: filter 0.5s;
  }

  .about-hero__media:hover img {
    filter: grayscale(0);
  }

  /* Shared */
  .badge {
    margin: 0;
    display: inline-block;
    padding: 6px 12px;
    border: 1px solid #e4e0d8;
    border-radius: 999px;
    background: #fff;
    color: #666;
    font-size: 12px;
    width: fit-content;
  }

  .badge--dark {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.8);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 22px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn--dark {
    background: #1b1b1b;
    color: #fff;
  }

  .btn--dark:hover {
    background: #333;
  }

  .btn--outline {
    background: transparent;
    color: #1b1b1b;
    border: 1px solid #bdbdb8;
  }

  .btn--outline:hover {
    border-color: #888;
  }

  .section-wrap {
    width: min(1200px, 100%);
    margin: 28px auto 0;
    padding: clamp(20px, 3vw, 34px);
    background: #f4f2ed;
    border-radius: 20px;
  }

  .section-wrap--dark {
    background: #1b1b1b;
  }

  .section-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 24px;
  }

  .section-header--dark .section-title {
    color: #fff;
  }

  .section-title {
    margin: 12px 0 0;
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-size: clamp(2rem, 4.2vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: #151515;
  }

  .section-title--light {
    color: #fff;
  }

  .section-intro {
    margin: 12px auto 0;
    color: #5f5f5f;
    line-height: 1.55;
    max-width: 66ch;
    font-size: 0.95rem;
  }

  .section-intro--light {
    color: rgba(255, 255, 255, 0.7);
  }

  /* Journey */
  .journey-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .journey-card {
    background: #fff;
    border: 1px solid #e6e2db;
    border-radius: 16px;
    padding: 20px;
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 14px;
    align-items: start;
  }

  .journey-card__icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid #ddd8d1;
    background: #f8f7f4;
    display: grid;
    place-items: center;
    color: #3f3f3f;
  }

  .journey-card__icon :global(svg) {
    width: 18px;
    height: 18px;
  }

  .journey-card h3 {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 600;
    color: #1a1a1a;
  }

  .journey-card p {
    margin: 6px 0 0;
    color: #666;
    line-height: 1.5;
    font-size: 0.92rem;
  }

  /* Work cards */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .work-card {
    background: #fff;
    border: 1px solid #e6e2db;
    border-radius: 16px;
    padding: 18px;
    transition: transform 0.2s, border-color 0.2s;
  }

  .work-card:hover {
    transform: translateY(-2px);
    border-color: #ccc;
  }

  .work-card__icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid #ddd8d1;
    background: #f8f7f4;
    display: grid;
    place-items: center;
    color: #3f3f3f;
    margin-bottom: 12px;
  }

  .work-card__icon :global(svg) {
    width: 16px;
    height: 16px;
  }

  .work-card h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: #1b1b1b;
  }

  .work-card p {
    margin: 8px 0 0;
    color: #666;
    line-height: 1.48;
    font-size: 0.92rem;
  }

  /* Principles */
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }

  .principle-card {
    background: #fff;
    border: 1px solid #e6e2db;
    border-radius: 16px;
    padding: 16px;
    min-height: 140px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .principle-card__icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid #ddd8cf;
    background: #fff;
    display: grid;
    place-items: center;
    color: #3f3f3f;
    box-shadow: 0 2px 5px rgba(18, 18, 18, 0.06);
  }

  .principle-card__icon :global(svg) {
    width: 14px;
    height: 14px;
  }

  .principle-card p {
    margin: 0;
    color: #555;
    line-height: 1.48;
    font-size: 0.9rem;
  }

  /* Teaching */
  .teaching-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 16px;
    align-items: start;
  }

  .teaching-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .teaching-content p {
    margin: 0;
    color: #5f5f5f;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .teaching-panel {
    background: #fff;
    border: 1px solid #e6e2db;
    border-radius: 16px;
    padding: 20px;
  }

  .teaching-panel h3 {
    margin: 0 0 14px;
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-size: 1.2rem;
    font-weight: 500;
    color: #1b1b1b;
  }

  .teaching-panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .teaching-panel li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #555;
    font-size: 0.92rem;
  }

  .teaching-panel li :global(svg) {
    width: 14px;
    height: 14px;
    color: #3fbf61;
    flex-shrink: 0;
  }

  /* Exploring */
  .exploring-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .exploring-card {
    background: #fff;
    border: 1px solid #e6e2db;
    border-radius: 16px;
    padding: 24px;
  }

  .exploring-card--dark {
    background: #1b1b1b;
    border-color: #333;
    color: #fff;
  }

  .exploring-card--dark .exploring-card__text {
    color: rgba(255, 255, 255, 0.7);
  }

  .exploring-card h2 {
    margin: 12px 0 0;
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: #151515;
  }

  .exploring-card--dark h2 {
    color: #fff;
  }

  .exploring-card__text {
    margin: 12px 0 0;
    color: #5f5f5f;
    line-height: 1.55;
    font-size: 0.92rem;
  }

  .exploring-list {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .exploring-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #555;
    font-size: 0.92rem;
  }

  .exploring-list li :global(svg) {
    width: 14px;
    height: 14px;
    color: #888;
    flex-shrink: 0;
  }

  /* CTA */
  .cta-section {
    width: min(1200px, 100%);
    margin: 28px auto 0;
    padding: clamp(20px, 3vw, 34px);
    background: #1b1b1b;
    border-radius: 20px;
    text-align: center;
  }

  .cta-inner {
    max-width: 640px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .cta-inner h2 {
    margin: 0;
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: #fff;
  }

  .cta-inner p {
    margin: 14px 0 0;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.55;
    font-size: 0.95rem;
  }

  .cta-inner .btn {
    margin-top: 24px;
    background: #fff;
    color: #1b1b1b;
  }

  .cta-inner .btn:hover {
    background: #f0f0f0;
  }

  /* Responsive */
  @media (max-width: 980px) {
    .about-hero__panel {
      grid-template-columns: 1fr;
    }

    .about-hero__media {
      order: -1;
      aspect-ratio: 16/9;
    }

    .journey-grid {
      grid-template-columns: 1fr;
    }

    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .principles-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .teaching-grid {
      grid-template-columns: 1fr;
    }

    .exploring-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .about-hero {
      padding: 80px 14px 0;
    }

    .about-hero__panel {
      border-radius: 20px;
      padding: 16px;
    }

    .work-grid {
      grid-template-columns: 1fr;
    }

    .principles-grid {
      grid-template-columns: 1fr;
    }

    .section-wrap {
      margin: 16px auto 0;
      border-radius: 16px;
    }
  }
</style>
