---
import PageLayout from "@layouts/PageLayout.astro";
import { Image } from "astro:assets";
import heroImage from "@/assets/vincent.avif";
import { getProfilePageJsonLd } from "@/lib/seo";

const profileJsonLd = getProfilePageJsonLd();
---

<PageLayout title="About Vincent Mugondora | Software Developer & AI Builder" description="Vincent Mugondora is a Zimbabwean software developer, AI builder and technology educator. Learn about his experience building software, AI solutions and teaching technology.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(profileJsonLd)} />

  <!-- Hero Section -->
  <section class="about-hero">
    <div class="about-hero__container">
      <div class="about-hero__content">
        <div class="about-hero__badge">
          <span class="about-hero__badge-dot"></span>
          About me
        </div>
        <h1 class="about-hero__title">Good software starts with clear thinking.</h1>
        <p class="about-hero__desc">
          I'm a Zimbabwean software developer, technology educator and entrepreneur focused on building practical digital products, teaching software development and exploring AI, software architecture and emerging technology.
        </p>
        <div class="about-hero__signature">Vincent Mugondora</div>
      </div>
      <div class="about-hero__image">
        <Image
          src={heroImage}
          alt="Vincent Mugondora"
          widths={[400, 600, 800]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          loading="eager"
          fetchpriority="high"
          class="about-hero__img"
        />
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="about-stats">
    <div class="about-stats__container">
      <div class="about-stats__card">
        <div class="about-stats__icon">
          <svg fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="18"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg>
        </div>
        <h3 class="about-stats__number">5+</h3>
        <p class="about-stats__label">Years of experience</p>
        <p class="about-stats__text">Building products and educating developers since 2019.</p>
      </div>

      <div class="about-stats__card">
        <div class="about-stats__icon">
          <svg fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="18"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </div>
        <h3 class="about-stats__number">30+</h3>
        <p class="about-stats__label">Projects Shipped</p>
        <p class="about-stats__text">Trusted by startups, students, and established brands.</p>
      </div>

      <div class="about-stats__card">
        <div class="about-stats__icon">
          <svg fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="18"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
        </div>
        <h3 class="about-stats__number">Available</h3>
        <p class="about-stats__label">For new projects</p>
        <p class="about-stats__text">Currently available for architecture consulting and development.</p>
      </div>
    </div>
  </section>

  <!-- My Approach Section -->
  <section class="about-approach">
    <div class="about-approach__container">
      <div class="about-approach__content">
        <div class="about-approach__badge">
          <svg fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="14"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          My approach
        </div>
        <h2 class="about-approach__title">Engineering is more than just writing code</h2>
        <p class="about-approach__desc">
          A clear and collaborative workflow that moves each project from first idea to robust, scalable architecture.
        </p>

        <div class="about-approach__timeline">
          <div class="about-approach__step">
            <div class="about-approach__step-marker">
              <svg fill="none" height="12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="12"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" x2="8" y1="13" y2="13"></line><line x1="16" x2="8" y1="17" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            </div>
            <div>
              <h4 class="about-approach__step-title">Architecture first</h4>
              <p class="about-approach__step-text">Understanding the domain, constraints, and requirements before writing a single line of code.</p>
            </div>
          </div>

          <div class="about-approach__step">
            <div class="about-approach__step-marker">
              <svg fill="none" height="12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="12"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            </div>
            <div>
              <h4 class="about-approach__step-title">Clean execution</h4>
              <p class="about-approach__step-text">Building a focused technical foundation with maintainability in mind.</p>
            </div>
          </div>

          <div class="about-approach__step">
            <div class="about-approach__step-marker">
              <svg fill="none" height="12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="12"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
            </div>
            <div>
              <h4 class="about-approach__step-title">Iterative refinement</h4>
              <p class="about-approach__step-text">Testing and polishing every component until the system feels robust and complete.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="about-approach__image">
        <img
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuA-e8nIlH_XxgHyRancjU6jH5xtxzhuEY_w_JF6PYMcx87IBTpNod1bkLfdq_n48DfycJn20mXqiEfV4qjJFOC7N4NiWAQi7zdtefE6J79VxtpyVypitZo1Z5KVk44kW7a3Eh5n9KXfR58UegkgKCR7ZE1Jd73zbjxsm6MkM93760e8Wm_Rwl4i-hPhLCLb_ASFp6nB-3QrJ3lKxUZdxmf0lR03-wyJm3A5zLJSe21EEv0T7mX7F1-ifQ"
          alt="Workspace"
          class="about-approach__img"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* ===== ABOUT PAGE STYLES ===== */

  /* Hero */
  .about-hero {
    padding: 3rem 1.5rem 6rem;
  }

  @media (min-width: 768px) {
    .about-hero {
      padding: 6rem 1.5rem;
    }
  }

  .about-hero__container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .about-hero__container {
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
    }
  }

  .about-hero__content {
    max-width: 36rem;
  }

  .about-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid #e5e5e5;
    font-size: 0.75rem;
    font-weight: 500;
    margin-bottom: 2rem;
  }

  .about-hero__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #121212;
  }

  .about-hero__title {
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
    font-weight: 400;
  }

  .about-hero__desc {
    font-size: 1.125rem;
    line-height: 1.7;
    color: #666;
    margin: 0 0 2.5rem;
  }

  @media (min-width: 768px) {
    .about-hero__desc {
      font-size: 1.25rem;
    }
  }

  .about-hero__signature {
    font-family: "Brush Script MT", "Segoe Script", cursive;
    font-size: 2.5rem;
    opacity: 0.8;
  }

  .about-hero__image {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    border-radius: 1rem;
    overflow: hidden;
    background: #e5e5e5;
  }

  @media (min-width: 768px) {
    .about-hero__image {
      aspect-ratio: 1;
    }
  }

  @media (min-width: 1024px) {
    .about-hero__image {
      aspect-ratio: 4/5;
    }
  }

  .about-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Stats */
  .about-stats {
    padding: 0 1.5rem 4rem;
  }

  .about-stats__container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .about-stats__container {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .about-stats__card {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
  }

  .about-stats__icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: #f3f3f4;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    color: #121212;
  }

  .about-stats__number {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
  }

  .about-stats__label {
    font-weight: 500;
    margin: 0 0 0.5rem;
  }

  .about-stats__text {
    font-size: 0.875rem;
    color: #666;
    margin: 0;
  }

  /* Approach */
  .about-approach {
    padding: 6rem 1.5rem;
  }

  .about-approach__container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .about-approach__container {
      grid-template-columns: 1fr 1fr;
    }
  }

  .about-approach__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid #e5e5e5;
    font-size: 0.75rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
    color: #666;
  }

  .about-approach__title {
    font-family: "Lora Variable", "Lora", Georgia, serif;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
    font-weight: 400;
  }

  .about-approach__desc {
    font-size: 1.125rem;
    color: #666;
    margin: 0 0 3rem;
    line-height: 1.6;
  }

  .about-approach__timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: relative;
    padding-left: 2.5rem;
  }

  .about-approach__timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 11px;
    width: 1px;
    background: #e5e5e5;
  }

  .about-approach__step {
    display: flex;
    gap: 1rem;
    position: relative;
  }

  .about-approach__step-marker {
    position: absolute;
    left: -2.5rem;
    top: 2px;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: #fff;
    border: 1px solid #e5e5e5;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    color: #666;
  }

  .about-approach__step-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .about-approach__step-text {
    font-size: 0.875rem;
    color: #666;
    margin: 0;
    line-height: 1.5;
  }

  .about-approach__image {
    width: 100%;
    aspect-ratio: 4/3;
    border-radius: 1rem;
    overflow: hidden;
    background: #e5e5e5;
  }

  .about-approach__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
