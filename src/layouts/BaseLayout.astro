---
import "@/styles/fonts.css";
import "@/styles/global.css";
import "@/styles/typography.css";
import { siteConfig } from "@/config/site";
import { getBaseJsonLd } from "@/lib/seo";


interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  ogType?: string;
  publishedAt?: string;
  noindex?: boolean;
}

const { title, description, image, canonicalURL, ogType, publishedAt, noindex } = Astro.props;

const pageTitle = title
  ? title.includes(siteConfig.name) ? title : `${title} | ${siteConfig.name}`
  : siteConfig.title;
const pageDescription = description ?? siteConfig.description;
let currentPath = Astro.url.pathname;
if (currentPath.endsWith('/index.html')) {
  currentPath = currentPath.slice(0, -11) || '/';
} else if (currentPath.endsWith('.html')) {
  currentPath = currentPath.slice(0, -5);
} else if (currentPath === 'index.html') {
  currentPath = '/';
}
if (currentPath.length > 1 && currentPath.endsWith('/')) {
  currentPath = currentPath.slice(0, -1);
}
const canonical = canonicalURL ?? new URL(currentPath, siteConfig.url).href;
const ogImage = image ?? `${siteConfig.url}/og-default.png`;
const jsonLd = getBaseJsonLd();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/avif" href="/logo.avif" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />

    <link rel="preload" href="/fonts/Caveat-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-VariableFont_opsz,wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="dns-prefetch" href="https://analytics.ahrefs.com" />
    <link rel="preconnect" href="https://analytics.ahrefs.com" crossorigin />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="geo.region" content="ZW-HA" />
    <meta name="geo.placename" content="Harare, Zimbabwe" />
    <link rel="alternate" hreflang="en" href={canonical} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.name} href="/rss.xml" />

    <meta name="author" content="Vincent Mugondora" />
    <meta property="og:type" content={ogType ?? "website"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={ogImage} />

    <meta property="og:locale" content="en_ZW" />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {publishedAt && <meta property="article:author" content={siteConfig.url} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={siteConfig.twitterHandle} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Ahrefs Analytics -->
    <script src="https://analytics.ahrefs.com/analytics.js" data-key="TW3vMyn8vSGd3oswazXOuQ" async></script>
  </head>
  <body class="font-body antialiased">
    <slot />
  </body>
</html>
