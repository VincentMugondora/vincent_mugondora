---
import BaseLayout from "./BaseLayout.astro";
import Navbar from "@components/navigation/Navbar.astro";
import Footer from "@components/navigation/Footer.astro";
import { getArticleJsonLd } from "@/lib/seo";
import { siteConfig } from "@/config/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  publishedAt?: Date;
  updatedAt?: Date;
  category?: string;
}

const { title, description, image, canonicalURL, publishedAt, updatedAt } = Astro.props;

const articleUrl = canonicalURL ?? new URL(Astro.url.pathname, siteConfig.url).href;

const articleJsonLd = publishedAt
  ? getArticleJsonLd({
      title,
      description,
      url: articleUrl,
      publishedAt: publishedAt.toISOString(),
      updatedAt: updatedAt?.toISOString(),
      image,
    })
  : null;
---

<BaseLayout title={title} description={description} image={image} canonicalURL={canonicalURL}>
  <Navbar />
  <main id="main-content" class="pt-24 pb-16">
    <article class="prose mx-auto max-w-3xl px-6">
      <slot />

      <footer class="not-prose mt-16 border-t border-[var(--color-card-border)] pt-8">
        <div class="flex items-start gap-4">
          <a href="/about" class="flex-shrink-0">
            <img src="/vincent.avif" alt="Vincent Mugondora" width="48" height="48" loading="lazy" decoding="async" class="w-12 h-12 rounded-full object-cover" />
          </a>
          <div>
            <p class="font-body font-medium text-[var(--color-text-primary)]">
              <a href="/about" class="no-underline hover:text-[var(--color-primary)]">Vincent Mugondora</a>
            </p>
            <p class="font-body text-sm text-[var(--color-text-secondary)]">Software Developer & AI Builder in Zimbabwe. I build software, teach developers, and create AI solutions for Africa.</p>
            <div class="flex items-center gap-3 mt-2">
              <a href="https://github.com/vincentmugondora" class="font-body text-xs text-[var(--color-text-muted)] hover:text-[var(--color-primary)]" rel="me">GitHub</a>
              <a href="https://www.linkedin.com/in/vincent-mugondora-7b2a922b3/" class="font-body text-xs text-[var(--color-text-muted)] hover:text-[var(--color-primary)]" rel="me">LinkedIn</a>
              <a href="https://twitter.com/vincemugondora" class="font-body text-xs text-[var(--color-text-muted)] hover:text-[var(--color-primary)]" rel="me">Twitter</a>
            </div>
          </div>
        </div>
      </footer>
    </article>
  </main>
  <Footer />
  {articleJsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  )}
</BaseLayout>
