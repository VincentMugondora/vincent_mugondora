---
import Section from "@components/ui/Section.astro";
import Container from "@components/ui/Container.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";

const areas = [
  {
    title: "Full-Stack Applications",
    description: "Web and mobile applications built with modern frameworks, clean architecture, and performance in mind.",
  },
  {
    title: "AI & Intelligent Systems",
    description: "AI agents, RAG systems, and automation tools that solve practical problems for businesses and education.",
  },
  {
    title: "System Architecture",
    description: "Scalable system designs that prioritize reliability, maintainability, and developer experience.",
  },
  {
    title: "Developer Tools & Education",
    description: "Tools, workshops, and content that help developers grow their skills and build better software.",
  },
];
---

<Section theme="dark">
  <Container>
    <SectionHeader
      title="What I Build"
      subtitle="Engineering across the full stack, with a focus on AI and impactful technology."
      theme="dark"
    />
    <div class="grid gap-8 sm:grid-cols-2">
      {areas.map((area) => (
        <div class="rounded-lg border border-offwhite/10 p-8">
          <h3 class="font-heading text-xl font-semibold text-offwhite">
            {area.title}
          </h3>
          <p class="mt-3 text-offwhite/60">
            {area.description}
          </p>
        </div>
      ))}
    </div>
  </Container>
</Section>
