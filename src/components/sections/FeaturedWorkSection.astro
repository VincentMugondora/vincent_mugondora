---
import { Image } from "astro:assets";
import { getFeaturedProjects } from "@lib/content";

const projects = await getFeaturedProjects();

const placeholderProjects = [
  { title: "Zimnovate Platform", description: "Full-stack web application for Zimbabwe's tech ecosystem", color: "#1a1a2e" },
  { title: "AI Writing Assistant", description: "Agentic AI tool for content generation and optimization", color: "#16213e" },
  { title: "EdTech Dashboard", description: "Learning management system for African universities", color: "#0f3460" },
  { title: "Cloud Migration Tool", description: "AWS infrastructure automation for enterprise clients", color: "#1a1a1a" },
  { title: "Portfolio Builder", description: "Modern portfolio generator built with Astro and React", color: "#2d2d2d" },
  { title: "API Gateway Service", description: "High-performance REST API with real-time capabilities", color: "#1b2838" },
];
---

<section class="selected-work" aria-labelledby="selected-work-title">
  <header class="selected-work__header">
    <p class="selected-work__badge">Selected work</p>
    <h2 id="selected-work-title" class="selected-work__title">
      Projects with clarity
    </h2>
    <p class="selected-work__description">
      A curated collection of engineering, AI, and product work created for modern teams across Africa.
    </p>
  </header>

  <div class="selected-work__grid">
    {projects.length > 0 ? (
      projects.map((project) => (
        <a
          class="project-card"
          href={`/work/${project.id}`}
          aria-label={`View ${project.data.title} project`}
        >
          <figure class="project-card__media">
            {project.data.image ? (
              <Image
                src={project.data.image}
                alt={`${project.data.title} thumbnail`}
                width={580}
                height={360}
                loading="lazy"
              />
            ) : (
              <div class="project-card__placeholder">
                <span>{project.data.title.charAt(0)}</span>
              </div>
            )}
          </figure>
          <div class="project-card__meta">
            <h3>{project.data.title}</h3>
            <span aria-hidden="true">↗</span>
          </div>
        </a>
      ))
    ) : (
      placeholderProjects.map((project) => (
        <a
          class="project-card"
          href="/work"
          aria-label={`View ${project.title} project`}
        >
          <figure class="project-card__media">
            <div class="project-card__placeholder" style={`background: ${project.color}`}>
              <span>{project.title.charAt(0)}</span>
            </div>
          </figure>
          <div class="project-card__meta">
            <h3>{project.title}</h3>
            <span aria-hidden="true">↗</span>
          </div>
        </a>
      ))
    )}
  </div>
</section>

<style>
  .selected-work {
    width: min(1200px, 100%);
    margin: 0 auto;
    padding: 0 clamp(18px, 3vw, 36px);
  }

  .selected-work__header {
    max-width: 760px;
    margin: 0 auto 24px;
    text-align: center;
  }

  .selected-work__badge {
    margin: 0 auto 14px;
    display: inline-block;
    padding: 6px 12px;
    border: 1px solid #e7e4de;
    border-radius: 999px;
    background: #fff;
    color: #6f6f6f;
    font-size: 12px;
    line-height: 1;
  }

  .selected-work__title {
    margin: 0;
    font-family: "Lora Variable", "Lora", Georgia, "Times New Roman", serif;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
    font-size: clamp(2rem, 4.1vw, 3.1rem);
    color: #151515;
  }

  .selected-work__description {
    margin: 14px auto 0;
    max-width: 62ch;
    color: #5f5f5f;
    line-height: 1.55;
    font-size: 0.95rem;
  }

  .selected-work__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .project-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: transform 0.2s ease;
  }

  .project-card:focus-visible {
    outline: 2px solid #1b1b1b;
    outline-offset: 4px;
    border-radius: 18px;
  }

  .project-card:hover {
    transform: translateY(-3px);
  }

  .project-card__media {
    margin: 0;
    height: clamp(220px, 34vw, 370px);
    border-radius: 16px;
    overflow: hidden;
    background: #e9e7e2;
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1);
    transition: transform 0.35s ease;
  }

  .project-card:hover .project-card__media img {
    transform: scale(1.03);
  }

  .project-card__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: #1a1a2e;
    transition: transform 0.35s ease;
  }

  .project-card:hover .project-card__placeholder {
    transform: scale(1.03);
  }

  .project-card__placeholder span {
    font-size: 3rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.3);
    font-family: "Lora Variable", "Lora", Georgia, serif;
  }

  .project-card__meta {
    background: #ffffff;
    border: 1px solid #ebe8e2;
    border-radius: 16px;
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
  }

  .project-card__meta h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .project-card__meta span {
    color: #838383;
    font-size: 16px;
    line-height: 1;
  }

  @media (max-width: 820px) {
    .selected-work__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
