---
import { getFeaturedProjects } from "@lib/content";

const projects = await getFeaturedProjects();

const placeholderProjects = [
  { title: "Zimnovate Platform", description: "Full-stack web application for Zimbabwe's tech ecosystem", color: "#0b1220" },
  { title: "AI Writing Assistant", description: "Agentic AI tool for content generation and optimization", color: "#1e293b" },
  { title: "EdTech Dashboard", description: "Learning management system for African universities", color: "#0f3460" },
  { title: "Cloud Migration Tool", description: "AWS infrastructure automation for enterprise clients", color: "#0b1220" },
];
---

<section class="py-16 md:py-24" aria-labelledby="work-title">
  <div class="mx-auto max-w-[1200px] px-5 md:px-8">
    <header class="mb-10 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <h2 id="work-title" class="font-heading text-[clamp(2rem,4vw,3rem)] font-bold leading-tight tracking-tight text-midnight">
          Featured work
        </h2>
        <p class="mt-3 max-w-[50ch] text-muted leading-relaxed">
          A curated selection of engineering, AI, and product work built for teams across Africa.
        </p>
      </div>
      <a href="/work" class="inline-flex items-center gap-1.5 text-sm font-semibold text-electric transition-colors hover:text-midnight">
        View all projects
        <span aria-hidden="true">&rarr;</span>
      </a>
    </header>

    <div class="grid gap-6 sm:grid-cols-2">
      {projects.length > 0 ? (
        projects.map((project) => (
          <a
            href={`/work/${project.id}`}
            class="group flex flex-col overflow-hidden rounded-xl border border-slate-brand/8 bg-white transition-all hover:-translate-y-1 hover:shadow-md"
            aria-label={`View ${project.data.title} project`}
          >
            <div class="relative aspect-[16/10] overflow-hidden bg-midnight">
              {project.data.image ? (
                <img
                  src={project.data.image}
                  alt={`${project.data.title} thumbnail`}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                  loading="lazy"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center">
                  <span class="font-heading text-4xl font-bold text-white/20">{project.data.title.charAt(0)}</span>
                </div>
              )}
            </div>
            <div class="flex items-center justify-between gap-4 px-5 py-4">
              <h3 class="font-heading text-base font-semibold text-midnight">{project.data.title}</h3>
              <span class="text-muted transition-colors group-hover:text-electric" aria-hidden="true">&nearr;</span>
            </div>
          </a>
        ))
      ) : (
        placeholderProjects.map((project) => (
          <a
            href="/work"
            class="group flex flex-col overflow-hidden rounded-xl border border-slate-brand/8 bg-white transition-all hover:-translate-y-1 hover:shadow-md"
            aria-label={`View ${project.title} project`}
          >
            <div class="relative aspect-[16/10] overflow-hidden" style={`background: ${project.color}`}>
              <div class="flex h-full w-full items-center justify-center">
                <span class="font-heading text-4xl font-bold text-white/20">{project.title.charAt(0)}</span>
              </div>
            </div>
            <div class="flex items-center justify-between gap-4 px-5 py-4">
              <div>
                <h3 class="font-heading text-base font-semibold text-midnight">{project.title}</h3>
                <p class="mt-1 text-xs text-muted">{project.description}</p>
              </div>
              <span class="text-muted transition-colors group-hover:text-electric" aria-hidden="true">&nearr;</span>
            </div>
          </a>
        ))
      )}
    </div>
  </div>
</section>
