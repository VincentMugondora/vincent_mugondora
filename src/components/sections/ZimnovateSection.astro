---
import Section from "@components/ui/Section.astro";
import Container from "@components/ui/Container.astro";
---

<Section theme="dark">
  <Container>
    <div class="max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-widest text-gold">Entrepreneurship</p>
      <h2 class="mt-4 font-heading text-3xl font-bold text-offwhite lg:text-4xl">
        Zimnovate
      </h2>
      <p class="mt-4 text-lg text-offwhite/70">
        Building technology solutions for Zimbabwe and Africa. Zimnovate is my
        company focused on creating practical products that address local challenges
        with world-class engineering.
      </p>
      <a
        href="https://zimnovate.co.zw"
        class="mt-6 inline-flex items-center gap-2 font-medium text-electric transition-colors hover:text-gold"
        target="_blank"
        rel="noopener noreferrer"
      >
        Visit Zimnovate
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 12L12 4M12 4H5M12 4v7" />
        </svg>
      </a>
    </div>
  </Container>
</Section>
