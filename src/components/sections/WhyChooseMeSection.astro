---
import { Icon } from "astro-icon/components";
---

<section class="why" aria-labelledby="why-title">
  <header class="why__header">
    <div class="why__header-left">
      <p class="why__badge">Why choose me</p>
      <h2 id="why-title" class="why__title">
        Engineering built around lasting impact
      </h2>
    </div>
    <p class="why__intro">
      I bring strategy, technical depth, and refined execution together to create meaningful digital solutions with lasting impact.
    </p>
  </header>

  <div class="why__grid">
    <!-- Left column -->
    <div class="stack stack--left">
      <article class="card card--clients" aria-label="Clients">
        <div class="avatars" aria-hidden="true">
          <span class="avatar avatar--1"></span>
          <span class="avatar avatar--2"></span>
          <span class="avatar avatar--3"></span>
          <span class="avatar avatar--4"></span>
        </div>
        <p class="clients-copy"><strong>20+</strong> clients</p>
      </article>

      <article class="card card--tall">
        <p class="card__lead">
          Clear technical direction shaped around every project goal.
        </p>
        <p class="metric">95%</p>
        <p class="label">Client satisfaction</p>
      </article>
    </div>

    <!-- Center column -->
    <div class="stack stack--center">
      <article class="card card--mid">
        <p class="card__lead">
          Full-stack applications, AI systems, and cloud infrastructure delivered with care.
        </p>
        <p class="metric">30+</p>
        <p class="label">Projects completed</p>
      </article>

      <article class="card card--availability">
        <p class="availability">
          <span class="dot" aria-hidden="true"></span>
          Available for projects
        </p>
      </article>
    </div>

    <!-- Right column -->
    <article class="card card--dark">
      <p class="card__lead card__lead--light">
        I help founders, teams, and communities turn ideas into refined digital experiences that scale and deliver real value.
      </p>
      <p class="metric metric--light">4.9</p>
      <p class="stars" aria-label="5 out of 5 stars"><Icon name="lucide:star" /><Icon name="lucide:star" /><Icon name="lucide:star" /><Icon name="lucide:star" /><Icon name="lucide:star" /></p>
      <p class="label label--light">
        Trusted by clients across Africa
      </p>
    </article>
  </div>
</section>

<style>
  .why {
    max-width: 1200px;
    margin: 0 auto;
    background: #f2f0ec;
    border-radius: 20px;
    padding: clamp(20px, 3vw, 34px);
  }

  .why__header {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 20px;
    align-items: end;
    margin-bottom: 16px;
  }

  .why__badge {
    margin: 0 0 12px;
    display: inline-block;
    border: 1px solid #e2dfd8;
    border-radius: 999px;
    background: #fff;
    color: #6d6d6d;
    padding: 6px 12px;
    font-size: 12px;
    line-height: 1;
  }

  .why__title {
    margin: 0;
    font-family: "Lora Variable", "Lora", Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 4.3vw, 3.25rem);
    line-height: 1.03;
    letter-spacing: -0.02em;
    font-weight: 500;
    max-width: 16ch;
    color: #151515;
  }

  .why__intro {
    margin: 0;
    color: #565656;
    line-height: 1.58;
    max-width: 46ch;
    font-size: 0.95rem;
  }

  .why__grid {
    display: grid;
    grid-template-columns: 0.95fr 0.95fr 1.1fr;
    gap: 16px;
    align-items: stretch;
  }

  .stack {
    display: grid;
    gap: 16px;
  }

  .stack--left {
    grid-template-rows: auto 1fr;
  }

  .stack--center {
    grid-template-rows: 1fr auto;
  }

  .card {
    border-radius: 16px;
    border: 1px solid #e6e2db;
    background: #fff;
    padding: 16px;
  }

  .card__lead {
    margin: 0 0 18px;
    color: #3e3e3e;
    line-height: 1.5;
    font-size: 0.92rem;
  }

  .metric {
    margin: 0;
    font-family: "Lora Variable", "Lora", Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 4vw, 2.65rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: #151515;
  }

  .label {
    margin: 8px 0 0;
    color: #6d6d6d;
    font-size: 0.93rem;
  }

  /* Clients compact card */
  .card--clients {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 14px;
  }

  .avatars {
    display: flex;
    align-items: center;
  }

  .avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid #fff;
    margin-left: -10px;
  }

  .avatar:first-child {
    margin-left: 0;
  }

  .avatar--1 { background: linear-gradient(135deg, #6f8cff, #c0ccff); }
  .avatar--2 { background: linear-gradient(135deg, #ff9d7a, #ffd3c4); }
  .avatar--3 { background: linear-gradient(135deg, #4fcf9d, #b6f0db); }
  .avatar--4 { background: linear-gradient(135deg, #e5b44d, #f8ddaa); }

  .clients-copy {
    margin: 0;
    color: #666;
    font-size: 0.94rem;
  }

  .clients-copy strong {
    color: #191919;
    font-family: "Lora Variable", "Lora", Georgia, "Times New Roman", serif;
    font-weight: 600;
    font-size: 1.05rem;
  }

  .card--tall {
    min-height: 252px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .card--mid {
    min-height: 210px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .card--availability {
    display: flex;
    align-items: center;
    min-height: 74px;
    padding: 14px 16px;
  }

  .availability {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #3e3e3e;
    font-size: 0.95rem;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3fbf61;
    box-shadow: 0 0 0 4px rgba(63, 191, 97, 0.16);
  }

  /* Dark right card */
  .card--dark {
    background: #262626;
    border: 1px solid #333;
    color: #fff;
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.18);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100%;
  }

  .card__lead--light {
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 24px;
  }

  .metric--light {
    color: #fff;
  }

  .stars {
    margin: 8px 0 0;
    color: #f3c563;
    display: flex;
    gap: 2px;
  }

  .stars :global(svg) {
    width: 16px;
    height: 16px;
    fill: #f3c563;
  }

  .label--light {
    color: rgba(255, 255, 255, 0.75);
  }

  @media (max-width: 980px) {
    .why__header {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .why__title {
      max-width: 20ch;
    }

    .why__grid {
      grid-template-columns: 1fr;
    }

    .stack--left,
    .stack--center {
      grid-template-rows: auto;
    }

    .card--tall,
    .card--mid {
      min-height: 0;
    }
  }
</style>
