---
---

<section class="benefits" aria-labelledby="benefits-title">
  <header class="benefits__header">
    <p class="benefits__badge">Benefits</p>
    <h2 id="benefits-title" class="benefits__title">
      Discover why we stand out
    </h2>
    <p class="benefits__subtitle">
      Building clean, scalable systems that solve real problems, integrate AI intelligently, and support meaningful growth for teams across Africa.
    </p>
  </header>

  <div class="benefits__grid">
    <!-- Card 1: Clean design systems -->
    <article class="benefit-card">
      <div class="benefit-card__preview preview-controls" aria-hidden="true">
        <div class="control-strip">
          <span></span><span></span><span></span>
        </div>
        <div class="switch-row">
          <div class="switch"></div>
          <div class="line"></div>
        </div>
        <div class="slider"></div>
        <div class="button-row">
          <div class="pill"></div>
          <div class="pill pill--light"></div>
        </div>
      </div>
      <h3>Clean architecture & systems</h3>
      <p>
        Scalable, maintainable codebases with clear separation of concerns — built to evolve with your product.
      </p>
    </article>

    <!-- Card 2: Performance -->
    <article class="benefit-card">
      <div class="benefit-card__preview preview-chart" aria-hidden="true">
        <div class="chart-grid"></div>
        <div class="chart-line"></div>
        <div class="metric-card">
          <p>+38%</p>
          <span>Performance</span>
        </div>
      </div>
      <h3>Built to perform</h3>
      <p>
        Optimized for speed, SEO, and conversion — sites and systems that rank higher and load faster.
      </p>
    </article>

    <!-- Card 3: AI-ready -->
    <article class="benefit-card">
      <div class="benefit-card__preview preview-mobile" aria-hidden="true">
        <div class="phone">
          <div class="notch"></div>
          <div class="avatar"></div>
          <div class="text text--lg"></div>
          <div class="text"></div>
          <div class="text text--sm"></div>
          <div class="cta"></div>
        </div>
      </div>
      <h3>AI-powered solutions</h3>
      <p>
        From agentic workflows to intelligent automation — shipping AI that delivers real business value.
      </p>
    </article>
  </div>
</section>

<style>
  .benefits {
    max-width: 1200px;
    margin: 0 auto;
    background: #f3f1ed;
    border-radius: 20px;
    padding: clamp(20px, 3vw, 34px);
  }

  .benefits__header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 26px;
  }

  .benefits__badge {
    margin: 0 auto 14px;
    display: inline-block;
    background: #fff;
    border: 1px solid #e7e4de;
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 12px;
    color: #6c6c6c;
  }

  .benefits__title {
    margin: 0;
    font-family: "Lora Variable", "Lora", Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 4.2vw, 3.15rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    font-weight: 500;
    color: #151515;
  }

  .benefits__subtitle {
    margin: 14px auto 0;
    color: #555;
    max-width: 66ch;
    line-height: 1.55;
    font-size: 0.95rem;
  }

  .benefits__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .benefit-card {
    background: #ffffff;
    border: 1px solid #e7e4de;
    border-radius: 16px;
    padding: 14px;
  }

  .benefit-card h3 {
    margin: 14px 0 8px;
    font-size: 1.05rem;
    line-height: 1.2;
    font-weight: 600;
    color: #151515;
  }

  .benefit-card p {
    margin: 0;
    color: #666;
    line-height: 1.5;
    font-size: 0.94rem;
  }

  .benefit-card__preview {
    border-radius: 12px;
    background: #f8f8f7;
    border: 1px solid #eceae5;
    height: 180px;
    position: relative;
    overflow: hidden;
  }

  /* Card 1: UI controls */
  .preview-controls {
    padding: 16px;
  }

  .control-strip {
    display: flex;
    gap: 6px;
    margin-bottom: 14px;
  }

  .control-strip span {
    width: 8px;
    height: 8px;
    border-radius: 99px;
    background: #9d9d9d;
  }

  .switch-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .switch {
    width: 34px;
    height: 20px;
    border-radius: 999px;
    background: #1e1e1e;
    position: relative;
  }

  .switch::after {
    content: "";
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    right: 3px;
    top: 3px;
    background: #fff;
  }

  .line {
    height: 8px;
    border-radius: 99px;
    flex: 1;
    background: #d8d8d8;
  }

  .slider {
    width: 100%;
    height: 6px;
    border-radius: 99px;
    background: linear-gradient(90deg, #2a2a2a 60%, #d4d4d4 60%);
    margin-bottom: 16px;
  }

  .button-row {
    display: flex;
    gap: 10px;
  }

  .pill {
    width: 84px;
    height: 28px;
    border-radius: 999px;
    background: #1f1f1f;
  }

  .pill--light {
    background: #d3d3d3;
  }

  /* Card 2: chart */
  .preview-chart {
    background: linear-gradient(180deg, #f8f8f7, #f2f2f0);
  }

  .chart-grid {
    position: absolute;
    inset: 20px;
    border-left: 1px solid #d6d6d2;
    border-bottom: 1px solid #d6d6d2;
    background-image: linear-gradient(#ecece9 1px, transparent 1px),
      linear-gradient(90deg, #ecece9 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .chart-line {
    position: absolute;
    left: 30px;
    right: 24px;
    bottom: 35px;
    height: 90px;
    border: 3px solid transparent;
    border-top-color: #1f1f1f;
    border-right-color: #1f1f1f;
    border-radius: 80px 80px 0 0;
    transform: skewX(-14deg);
  }

  .metric-card {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(22, 22, 22, 0.92);
    color: #fff;
    border-radius: 10px;
    padding: 8px 10px;
    min-width: 80px;
    text-align: center;
  }

  .metric-card p {
    color: #fff;
    margin: 0;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1;
  }

  .metric-card span {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.8);
  }

  /* Card 3: phone */
  .preview-mobile {
    display: grid;
    place-items: center;
  }

  .phone {
    width: 112px;
    height: 160px;
    border-radius: 20px;
    border: 1px solid #d7d7d3;
    background: #fff;
    padding: 10px;
    position: relative;
  }

  .notch {
    width: 40px;
    height: 6px;
    border-radius: 99px;
    background: #d4d4d4;
    margin: 0 auto 10px;
  }

  .avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #202020;
    margin: 0 auto 10px;
  }

  .text {
    height: 7px;
    border-radius: 99px;
    background: #dcdcdc;
    margin-bottom: 7px;
  }

  .text--lg {
    width: 76%;
    margin-left: auto;
    margin-right: auto;
    background: #2f2f2f;
  }

  .text--sm {
    width: 58%;
    margin-left: auto;
    margin-right: auto;
  }

  .cta {
    margin: 12px auto 0;
    width: 70%;
    height: 22px;
    border-radius: 999px;
    background: #202020;
  }

  @media (max-width: 900px) {
    .benefits__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
