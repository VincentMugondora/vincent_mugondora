---
import Section from "@components/ui/Section.astro";
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";
---

<Section theme="light">
  <Container>
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="font-heading text-3xl font-bold text-midnight">Speaking</h2>
        <p class="mt-4 text-muted">
          I speak about AI, software engineering, technology entrepreneurship,
          and building tech careers - particularly in the African context.
        </p>
        <div class="mt-6">
          <Button href="/speaking" variant="secondary" size="sm">Speaking Topics</Button>
        </div>
      </div>
      <div>
        <h2 class="font-heading text-3xl font-bold text-midnight">Teaching</h2>
        <p class="mt-4 text-muted">
          I teach software engineering fundamentals, AI development, and system
          design through workshops, mentorship, and hands-on courses.
        </p>
        <div class="mt-6">
          <Button href="/teaching" variant="secondary" size="sm">Learn More</Button>
        </div>
      </div>
    </div>
  </Container>
</Section>
