---
import Section from "@components/ui/Section.astro";
import Container from "@components/ui/Container.astro";
---

<Section theme="light">
  <Container>
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <h2 class="font-heading text-3xl font-bold text-midnight lg:text-4xl">
          Engineering software that solves real problems
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-muted">
          I'm a software engineer and entrepreneur based in Zimbabwe, focused on building
          products that combine strong engineering fundamentals with practical impact. From
          AI-powered systems to full-stack applications, I care about clean architecture,
          performance, and building technology that serves people.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          Beyond code, I teach, speak, and write about technology - helping the next
          generation of African developers build with confidence.
        </p>
      </div>
      <div class="flex items-center justify-center">
        <div class="aspect-square w-full max-w-sm rounded-lg border border-midnight/10 bg-midnight/5"></div>
      </div>
    </div>
  </Container>
</Section>
