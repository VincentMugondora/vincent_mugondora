---
import Container from "@components/ui/Container.astro";
---

<section class="relative min-h-screen bg-[#f5f5f3] pt-24 lg:pt-16">
  <Container>
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-8 lg:min-h-[85vh]">
      <!-- Left content -->
      <div class="flex flex-col justify-center py-12 lg:py-24">
        <h1 class="font-heading text-5xl font-bold leading-[1.1] tracking-tight text-midnight md:text-6xl lg:text-7xl">
          Build better<br />software, <em class="font-normal not-italic text-muted">faster</em>
        </h1>
        <p class="mt-6 max-w-md text-base leading-relaxed text-muted lg:text-lg">
          I build refined software, AI systems, and digital solutions for ambitious teams and communities across Africa.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="/work"
            class="inline-flex items-center gap-2 rounded-full bg-midnight px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-slate-brand"
          >
            View projects
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 rounded-full border border-midnight/15 px-6 py-3 text-sm font-medium text-midnight transition-colors hover:bg-midnight/5"
          >
            Get in touch
          </a>
        </div>

        <!-- Stats -->
        <div class="mt-14 flex gap-10 lg:gap-14">
          <div>
            <p class="font-heading text-3xl font-bold text-midnight lg:text-4xl">30+</p>
            <p class="mt-1 text-sm text-muted">Projects completed</p>
          </div>
          <div>
            <p class="font-heading text-3xl font-bold text-midnight lg:text-4xl">5yr</p>
            <p class="mt-1 text-sm text-muted">Experience</p>
          </div>
          <div>
            <p class="font-heading text-3xl font-bold text-midnight lg:text-4xl">20+</p>
            <p class="mt-1 text-sm text-muted">Happy clients</p>
          </div>
        </div>
      </div>

      <!-- Right: portrait + floating card -->
      <div class="relative flex items-end justify-center lg:justify-end">
        <div class="relative w-full max-w-md lg:max-w-lg xl:max-w-xl">
          <!-- Portrait image -->
          <img
            src="/images/portrait.svg"
            alt="Vincent Mugondora"
            class="h-auto w-full rounded-2xl object-cover grayscale"
            style="aspect-ratio: 3/4;"
          />

          <!-- Floating availability card -->
          <div class="absolute bottom-6 right-0 translate-x-4 rounded-xl bg-midnight/80 p-4 text-white backdrop-blur-md sm:bottom-10 sm:translate-x-8 lg:translate-x-12">
            <p class="text-xs text-white/60">Select project</p>
            <p class="mt-1 text-sm font-semibold">Available for projects</p>
            <div class="mt-2 flex items-center justify-between gap-6">
              <p class="max-w-[180px] text-xs leading-relaxed text-white/70">
                Share a few details, and I'll get back with a clear direction.
              </p>
              <a
                href="/contact"
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-white/20"
                aria-label="Start a project"
              >
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                  <path d="M1 13L13 1M13 1H3M13 1v10" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
