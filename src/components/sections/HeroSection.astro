---
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__panel">
    <!-- Left column -->
    <div class="hero__content">
      <p class="hero__eyebrow">Software Engineer &bull; AI Builder &bull; Educator</p>

      <h1 id="hero-title" class="hero__title">
        Build better software, <span class="muted">faster</span>
      </h1>

      <p class="hero__description">
        I build refined software, AI systems, and digital solutions for ambitious teams and communities across Africa.
      </p>

      <div class="hero__actions">
        <a class="button button--primary" href="/work">View projects</a>
        <a class="button button--secondary" href="/contact">Get in touch</a>
      </div>

      <dl class="hero__stats" aria-label="Highlights">
        <div class="stat">
          <dt>30+</dt>
          <dd>Projects completed</dd>
        </div>
        <div class="stat">
          <dt>5yr</dt>
          <dd>Experience</dd>
        </div>
        <div class="stat">
          <dt>20+</dt>
          <dd>Happy clients</dd>
        </div>
      </dl>
    </div>

    <!-- Right column: portrait + overlay card -->
    <figure class="hero__media">
      <img
        src="/images/portrait.svg"
        alt="Vincent Mugondora"
      />

      <figcaption class="availability-card">
        <p class="availability-card__label">Select project</p>
        <h2 class="availability-card__title">Available for projects</h2>
        <p class="availability-card__text">
          Share a few details, and I'll get back with a clear direction.
        </p>
        <a
          class="availability-card__link"
          href="/contact"
          aria-label="Get in touch"
        >&#8599;</a>
      </figcaption>
    </figure>
  </div>

  <!-- Partners row -->
  <div class="partners" aria-label="Technologies & partners">
    <a href="https://www.python.org" target="_blank" rel="noreferrer">Python</a>
    <a href="https://www.typescriptlang.org" target="_blank" rel="noreferrer">TypeScript</a>
    <a href="https://react.dev" target="_blank" rel="noreferrer">React</a>
    <a href="https://astro.build" target="_blank" rel="noreferrer">Astro</a>
    <a href="https://nodejs.org" target="_blank" rel="noreferrer">Node.js</a>
    <a href="https://openai.com" target="_blank" rel="noreferrer">AI/ML</a>
  </div>
</section>

<style>
  .hero {
    width: min(1200px, 100%);
    margin: 0 auto;
    padding: clamp(18px, 3vw, 36px);
    padding-top: 100px;
  }

  .hero__panel {
    background: #f1f1ef;
    border-radius: 26px;
    padding: clamp(18px, 3vw, 34px);
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(18px, 2.5vw, 30px);
    align-items: stretch;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
  }

  .hero__eyebrow {
    margin: 0;
    color: #6f6f6f;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .hero__title {
    margin: 0;
    font-family: "Lora Variable", "Lora", Georgia, "Times New Roman", serif;
    font-size: clamp(2.2rem, 5.3vw, 4.65rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    font-weight: 500;
    max-width: 12ch;
    color: #111111;
  }

  .hero__title .muted {
    color: #8e8e8e;
  }

  .hero__description {
    margin: 0;
    color: #383838;
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    line-height: 1.55;
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .button {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 12px 18px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    border: 1px solid transparent;
    transition: transform 0.18s ease, background-color 0.18s ease,
      border-color 0.18s ease, color 0.18s ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button--primary {
    background: #111;
    color: #fff;
  }

  .button--secondary {
    background: transparent;
    color: #1b1b1b;
    border-color: #bdbdb8;
  }

  .hero__stats {
    margin: 6px 0 0;
    padding-top: 18px;
    border-top: 1px solid #dfdfdb;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .stat {
    margin: 0;
  }

  .stat dt {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.05;
    color: #111;
  }

  .stat dd {
    margin: 6px 0 0;
    color: #666;
    font-size: 0.93rem;
  }

  /* Right media column */
  .hero__media {
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    min-height: clamp(340px, 50vw, 560px);
    background: #c9c9c9;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    position: absolute;
    inset: 0;
    filter: grayscale(1);
  }

  /* Floating availability card */
  .availability-card {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    background: rgba(17, 17, 17, 0.72);
    backdrop-filter: blur(5px);
    border-radius: 12px;
    color: #fff;
    padding: 16px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
  }

  .availability-card__label {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.82);
  }

  .availability-card__title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .availability-card__text {
    margin: 8px 0 0;
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.9rem;
    line-height: 1.45;
    max-width: 34ch;
  }

  .availability-card__link {
    position: absolute;
    right: 14px;
    top: 14px;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: #ffffff;
    color: #151515;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    line-height: 1;
  }

  /* Partners row */
  .partners {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    align-items: center;
    color: #666;
    font-size: 0.95rem;
    line-height: 1.2;
  }

  .partners a {
    position: relative;
    padding-right: 20px;
    color: inherit;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .partners a:hover {
    color: #4f4f4f;
  }

  .partners a:focus-visible {
    outline: 2px solid #333;
    outline-offset: 2px;
    border-radius: 4px;
  }

  .partners a:not(:last-child)::after {
    content: "•";
    position: absolute;
    right: 7px;
    top: 0;
    color: #a4a4a4;
  }

  /* Responsive */
  @media (max-width: 980px) {
    .hero__panel {
      grid-template-columns: 1fr;
    }

    .hero__media {
      order: -1;
      min-height: 420px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 14px;
      padding-top: 80px;
    }

    .hero__panel {
      border-radius: 20px;
      padding: 16px;
    }

    .hero__stats {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .hero__media {
      min-height: 340px;
    }

    .availability-card {
      position: static;
      border-radius: 0 0 12px 12px;
      margin: 0;
    }

    .availability-card__link {
      position: static;
      margin-top: 12px;
    }
  }
</style>
