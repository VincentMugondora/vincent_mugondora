---
---

<section class="relative pt-28 pb-16 md:pt-36 md:pb-24" aria-labelledby="hero-title">
  <div class="mx-auto max-w-[1200px] px-5 md:px-8">
    <div class="grid gap-10 md:grid-cols-[1.1fr_0.9fr] md:items-center md:gap-12">
      <!-- Left column -->
      <div class="flex flex-col gap-6">
        <p class="text-sm font-medium uppercase tracking-widest text-muted">
          Software Engineer &bull; AI Builder &bull; Educator
        </p>

        <h1
          id="hero-title"
          class="font-heading text-[clamp(2.5rem,5.5vw,4.5rem)] font-bold leading-[0.95] tracking-tight text-midnight"
        >
          Building technology, developing people
        </h1>

        <p class="max-w-[48ch] text-lg leading-relaxed text-slate-brand/80">
          I build software, AI systems, and digital solutions for ambitious teams and communities across Africa.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href="/work"
            class="inline-flex items-center gap-2 rounded-lg bg-electric px-5 py-3 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-electric/25"
          >
            View projects
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 rounded-lg border border-slate-brand/20 px-5 py-3 text-sm font-semibold text-slate-brand transition-all hover:-translate-y-0.5 hover:border-slate-brand/40"
          >
            Get in touch
          </a>
        </div>
      </div>

      <!-- Right column: portrait -->
      <figure class="relative overflow-hidden rounded-2xl bg-midnight/5">
        <img
          src="/vincent.avif"
          alt="Vincent Mugondora"
          class="aspect-[3/4] w-full object-cover object-top"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-x-4 bottom-4 rounded-xl border border-white/10 bg-midnight/80 p-4 backdrop-blur-sm">
          <p class="text-xs font-medium text-white/70">Available for projects</p>
          <p class="mt-1 text-sm leading-snug text-white">
            Share a few details, and I'll get back with a clear direction.
          </p>
        </div>
      </figure>
    </div>

    <!-- Skills carousel -->
    <div class="mt-12 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_60px,black_calc(100%-60px),transparent)]" aria-label="Skills & technologies">
      <div class="skills-track flex w-max gap-5" aria-hidden="false">
        <span class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-slate-brand/10 bg-offwhite px-4 py-2 text-sm font-medium text-slate-brand/70">Python</span>
        <span class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-slate-brand/10 bg-offwhite px-4 py-2 text-sm font-medium text-slate-brand/70">TypeScript</span>
        <span class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-slate-brand/10 bg-offwhite px-4 py-2 text-sm font-medium text-slate-brand/70">React</span>
        <span class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-slate-brand/10 bg-offwhite px-4 py-2 text-sm font-medium text-slate-brand/70">Astro</span>
        <span class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-slate-brand/10 bg-offwhite px-4 py-2 text-sm font-medium text-slate-brand/70">Node.js</span>
        <span class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-slate-brand/10 bg-offwhite px-4 py-2 text-sm font-medium text-slate-brand/70">Agentic AI</span>
        <span class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-slate-brand/10 bg-offwhite px-4 py-2 text-sm font-medium text-slate-brand/70">AWS</span>
        <span class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-slate-brand/10 bg-offwhite px-4 py-2 text-sm font-medium text-slate-brand/70">SEO</span>
        <span class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-slate-brand/10 bg-offwhite px-4 py-2 text-sm font-medium text-slate-brand/70">System Architecture</span>
        <span class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-slate-brand/10 bg-offwhite px-4 py-2 text-sm font-medium text-slate-brand/70">Next.js</span>
        <span class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-slate-brand/10 bg-offwhite px-4 py-2 text-sm font-medium text-slate-brand/70">Databases</span>
        <span class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-slate-brand/10 bg-offwhite px-4 py-2 text-sm font-medium text-slate-brand/70">API Design</span>
        <span class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-slate-brand/10 bg-offwhite px-4 py-2 text-sm font-medium text-slate-brand/70">UI/UX Design</span>
        <span class="inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-slate-brand/10 bg-offwhite px-4 py-2 text-sm font-medium text-slate-brand/70">Technical Writing</span>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const track = document.querySelector('.skills-track');
  if (track) {
    const items = track.innerHTML;
    track.innerHTML = items + items;
  }
</script>

<style>
  .skills-track {
    animation: scroll-skills 35s linear infinite;
  }
  .skills-track:hover {
    animation-play-state: paused;
  }
  @keyframes scroll-skills {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
