---
import Container from "@components/ui/Container.astro";
---

<section class="relative bg-white px-4 pt-28 pb-16 sm:px-6 lg:px-8 lg:pt-32">
  <div class="mx-auto max-w-7xl">
    <!-- Hero card container -->
    <div class="relative overflow-hidden rounded-3xl bg-[#f0f0ed] px-8 py-16 sm:px-12 md:px-16 lg:py-20">
      <div class="grid items-end gap-12 lg:grid-cols-2 lg:gap-8">
        <!-- Left content -->
        <div class="relative z-10 flex flex-col justify-center">
          <h1 class="font-heading text-5xl font-bold leading-[1.05] tracking-tight text-midnight md:text-6xl lg:text-[5rem]">
            Build better<br />software, <span class="text-[#c0bdb8]">faster</span>
          </h1>
          <p class="mt-7 max-w-md text-base leading-relaxed text-muted lg:text-lg">
            I build refined software, AI systems, and digital solutions for ambitious teams and communities across Africa.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="/work"
              class="inline-flex items-center gap-2 rounded-full bg-midnight px-7 py-3.5 text-sm font-medium text-white transition-colors hover:bg-slate-brand"
            >
              View projects
            </a>
            <a
              href="/contact"
              class="inline-flex items-center gap-2 rounded-full border border-midnight/15 bg-white px-7 py-3.5 text-sm font-medium text-midnight transition-colors hover:bg-midnight/5"
            >
              Get in touch
            </a>
          </div>

          <!-- Stats -->
          <div class="mt-16 flex gap-12 lg:gap-16">
            <div>
              <p class="font-heading text-4xl font-bold text-midnight lg:text-5xl">30+</p>
              <p class="mt-1 text-sm text-muted">Projects completed</p>
            </div>
            <div>
              <p class="font-heading text-4xl font-bold text-midnight lg:text-5xl">5yr</p>
              <p class="mt-1 text-sm text-muted">Experience</p>
            </div>
            <div>
              <p class="font-heading text-4xl font-bold text-midnight lg:text-5xl">20+</p>
              <p class="mt-1 text-sm text-muted">Happy clients</p>
            </div>
          </div>
        </div>

        <!-- Right: portrait + floating card -->
        <div class="relative hidden lg:block">
          <div class="absolute bottom-0 right-0 top-[-80px] w-full">
            <img
              src="/images/portrait.svg"
              alt="Vincent Mugondora"
              class="absolute bottom-0 right-0 h-[110%] w-auto max-w-none object-cover object-top grayscale"
            />
          </div>

          <!-- Floating availability card -->
          <div class="absolute bottom-8 right-4 z-20 rounded-2xl bg-midnight/85 p-5 text-white backdrop-blur-lg" style="max-width: 320px;">
            <p class="text-xs text-white/50">Select project</p>
            <p class="mt-1 text-sm font-semibold">Available for projects</p>
            <div class="mt-3 flex items-center justify-between gap-4">
              <p class="text-xs leading-relaxed text-white/65">
                Share a few details, and I'll get back with a clear direction.
              </p>
              <a
                href="/contact"
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-midnight transition-colors hover:bg-white/90"
                aria-label="Start a project"
              >
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 13L13 1M13 1H3M13 1v10" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
