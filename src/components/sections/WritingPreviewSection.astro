---
import Section from "@components/ui/Section.astro";
import Container from "@components/ui/Container.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import Button from "@components/ui/Button.astro";
import { getPublishedPosts } from "@lib/content";
import { formatDate } from "@lib/utils";

const posts = await getPublishedPosts();
const recent = posts.slice(0, 3);
---

<Section theme="dark">
  <Container>
    <SectionHeader
      title="Writing"
      subtitle="Technical articles on software engineering, AI, and building technology in Africa."
      theme="dark"
    />
    {recent.length > 0 ? (
      <div class="grid gap-6 lg:grid-cols-3">
        {recent.map((post) => (
          <a href={`/writing/${post.id}`} class="group block rounded-lg border border-offwhite/10 p-6 transition-colors hover:border-electric/40">
            <p class="font-mono text-xs uppercase text-offwhite/40">
              {formatDate(post.data.publishedAt)}
            </p>
            <h3 class="mt-3 font-heading text-lg font-semibold text-offwhite group-hover:text-electric">
              {post.data.title}
            </h3>
            <p class="mt-2 text-sm text-offwhite/60">
              {post.data.description}
            </p>
          </a>
        ))}
      </div>
    ) : (
      <div class="rounded-lg border border-dashed border-offwhite/20 p-12 text-center">
        <p class="text-offwhite/60">Articles coming soon.</p>
      </div>
    )}
    <div class="mt-12 text-center">
      <Button href="/writing" variant="ghost" class="text-offwhite hover:text-electric">Read All Articles</Button>
    </div>
  </Container>
</Section>
