---
---

<section class="py-16 md:py-24" aria-labelledby="services-title">
  <div class="mx-auto max-w-[1200px] px-5 md:px-8">
    <header class="mx-auto mb-12 max-w-[720px] text-center">
      <h2 id="services-title" class="font-heading text-[clamp(2rem,4vw,3rem)] font-bold leading-tight tracking-tight text-midnight">
        What I build
      </h2>
      <p class="mt-4 text-muted leading-relaxed">
        Focused engineering and AI expertise to help teams build scalable systems, intelligent products, and refined digital experiences.
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-3">
      <!-- Full-Stack Development -->
      <article class="group rounded-xl border border-slate-brand/8 bg-white p-6 transition-all hover:border-electric/20 hover:shadow-sm">
        <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-electric/10 text-electric font-mono text-sm font-bold">
          &lt;/&gt;
        </div>
        <h3 class="font-heading text-lg font-semibold text-midnight">Full-Stack Development</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Building responsive, high-performance web applications with clean architecture, smooth interactions, and production-ready code.
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          <li class="rounded-md bg-offwhite px-2 py-1 font-mono text-xs text-muted">React</li>
          <li class="rounded-md bg-offwhite px-2 py-1 font-mono text-xs text-muted">Next.js</li>
          <li class="rounded-md bg-offwhite px-2 py-1 font-mono text-xs text-muted">Astro</li>
          <li class="rounded-md bg-offwhite px-2 py-1 font-mono text-xs text-muted">Node.js</li>
        </ul>
      </article>

      <!-- AI & Agentic Systems -->
      <article class="group rounded-xl border border-slate-brand/8 bg-white p-6 transition-all hover:border-electric/20 hover:shadow-sm">
        <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-gold/15 text-gold font-mono text-sm font-bold">
          ✦
        </div>
        <h3 class="font-heading text-lg font-semibold text-midnight">AI & Agentic Systems</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Designing and deploying intelligent AI agents, automation pipelines, and ML-powered features that deliver real business value.
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          <li class="rounded-md bg-offwhite px-2 py-1 font-mono text-xs text-muted">LLMs</li>
          <li class="rounded-md bg-offwhite px-2 py-1 font-mono text-xs text-muted">Agents</li>
          <li class="rounded-md bg-offwhite px-2 py-1 font-mono text-xs text-muted">RAG</li>
          <li class="rounded-md bg-offwhite px-2 py-1 font-mono text-xs text-muted">Automation</li>
        </ul>
      </article>

      <!-- Cloud & Architecture -->
      <article class="group rounded-xl border border-slate-brand/8 bg-white p-6 transition-all hover:border-electric/20 hover:shadow-sm">
        <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-midnight/8 text-midnight font-mono text-sm font-bold">
          ◈
        </div>
        <h3 class="font-heading text-lg font-semibold text-midnight">Cloud & Architecture</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Scalable system design, AWS infrastructure, API development, and DevOps — engineered for growth and reliability.
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          <li class="rounded-md bg-offwhite px-2 py-1 font-mono text-xs text-muted">AWS</li>
          <li class="rounded-md bg-offwhite px-2 py-1 font-mono text-xs text-muted">Docker</li>
          <li class="rounded-md bg-offwhite px-2 py-1 font-mono text-xs text-muted">APIs</li>
          <li class="rounded-md bg-offwhite px-2 py-1 font-mono text-xs text-muted">CI/CD</li>
        </ul>
      </article>
    </div>
  </div>
</section>
