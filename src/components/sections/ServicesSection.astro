---
---

<section class="services" aria-labelledby="services-title">
  <header class="services__header">
    <h2 id="services-title">Engineering services for modern teams</h2>
    <p>
      Focused engineering and AI expertise to help teams build scalable systems, intelligent products, and refined digital experiences.
    </p>
  </header>

  <div class="tabs">
    <input type="radio" name="service" id="tab-development" class="tab-input" checked />
    <input type="radio" name="service" id="tab-ai-systems" class="tab-input" />
    <input type="radio" name="service" id="tab-architecture" class="tab-input" />

    <!-- Left service selector -->
    <div class="tabs__selector" role="tablist" aria-label="Services">
      <label for="tab-development" id="label-development" role="tab" tabindex="0">
        <span class="icon" aria-hidden="true">&lt;/&gt;</span>
        <span class="text-wrap">
          <span class="title">Full-Stack Development</span>
          <span class="desc">Building responsive, high-performance web applications with clean architecture, smooth interactions, and production-ready code.</span>
        </span>
      </label>

      <label for="tab-ai-systems" id="label-ai-systems" role="tab" tabindex="0">
        <span class="icon" aria-hidden="true">✦</span>
        <span class="text-wrap">
          <span class="title">AI & Agentic Systems</span>
          <span class="desc">Designing and deploying intelligent AI agents, automation pipelines, and ML-powered features that deliver real business value.</span>
        </span>
      </label>

      <label for="tab-architecture" id="label-architecture" role="tab" tabindex="0">
        <span class="icon" aria-hidden="true">◈</span>
        <span class="text-wrap">
          <span class="title">Cloud & Architecture</span>
          <span class="desc">Scalable system design, AWS infrastructure, API development, and DevOps — engineered for growth and reliability.</span>
        </span>
      </label>
    </div>

    <!-- Right preview panel -->
    <div class="tabs__preview" aria-live="polite">
      <article class="panel panel-development" role="tabpanel" aria-labelledby="label-development">
        <div class="preview-illustration preview-dev">
          <div class="browser-bar"><span></span><span></span><span></span></div>
          <div class="code-lines">
            <div class="code-line code-line--keyword"></div>
            <div class="code-line code-line--indent"></div>
            <div class="code-line code-line--indent code-line--long"></div>
            <div class="code-line code-line--indent"></div>
            <div class="code-line code-line--keyword"></div>
            <div class="code-line code-line--indent code-line--short"></div>
            <div class="code-line code-line--indent"></div>
          </div>
          <div class="dev-badge">React • Next.js • Astro</div>
        </div>
      </article>

      <article class="panel panel-ai-systems" role="tabpanel" aria-labelledby="label-ai-systems">
        <div class="preview-illustration preview-ai">
          <div class="ai-nodes">
            <div class="ai-node ai-node--1"></div>
            <div class="ai-node ai-node--2"></div>
            <div class="ai-node ai-node--3"></div>
            <div class="ai-connector"></div>
            <div class="ai-connector ai-connector--2"></div>
          </div>
          <div class="ai-output">
            <div class="ai-output__line"></div>
            <div class="ai-output__line ai-output__line--short"></div>
          </div>
          <div class="dev-badge">LLMs • Agents • Automation</div>
        </div>
      </article>

      <article class="panel panel-architecture" role="tabpanel" aria-labelledby="label-architecture">
        <div class="preview-illustration preview-arch">
          <div class="arch-blocks">
            <div class="arch-block arch-block--1"></div>
            <div class="arch-block arch-block--2"></div>
            <div class="arch-block arch-block--3"></div>
          </div>
          <div class="arch-lines">
            <div class="arch-line"></div>
            <div class="arch-line"></div>
          </div>
          <div class="dev-badge">AWS • Docker • APIs</div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .services {
    max-width: 1200px;
    margin: 0 auto;
    background: #f2f0ec;
    border-radius: 20px;
    padding: clamp(20px, 3vw, 34px);
  }

  .services__header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 18px;
  }

  .services__header h2 {
    margin: 0;
    font-family: "Lora Variable", "Lora", Georgia, "Times New Roman", serif;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    color: #151515;
  }

  .services__header p {
    margin: 14px auto 0;
    color: #5f5f5f;
    line-height: 1.55;
    max-width: 66ch;
    font-size: 0.95rem;
  }

  /* Tabs */
  .tabs {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 16px;
    align-items: stretch;
  }

  .tab-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .tabs__selector {
    display: grid;
    gap: 10px;
  }

  .tabs__selector label {
    border: 1px solid #e4e0d9;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.7);
    padding: 14px;
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 12px;
    align-items: start;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .tabs__selector label:hover {
    transform: translateY(-1px);
  }

  .tabs__selector label:focus-visible {
    outline: 2px solid #181818;
    outline-offset: 2px;
  }

  .icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid #ddd8d1;
    background: #f8f7f4;
    display: grid;
    place-items: center;
    color: #3f3f3f;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .text-wrap {
    display: block;
  }

  .title {
    display: block;
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 6px;
    color: #1a1a1a;
  }

  .desc {
    display: block;
    color: #6a6a6a;
    line-height: 1.45;
    font-size: 0.92rem;
  }

  /* Preview panel */
  .tabs__preview {
    border: 1px solid #e4e0d9;
    background: #ffffff;
    border-radius: 16px;
    padding: 10px;
    min-height: 420px;
    position: relative;
  }

  .panel {
    position: absolute;
    inset: 10px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .preview-illustration {
    width: 100%;
    height: 100%;
    border-radius: 12px;
    background: #1a1a1a;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px;
    position: relative;
  }

  /* Dev preview */
  .browser-bar {
    display: flex;
    gap: 6px;
    position: absolute;
    top: 20px;
    left: 20px;
  }

  .browser-bar span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #444;
  }

  .code-lines {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 70%;
  }

  .code-line {
    height: 8px;
    border-radius: 4px;
    background: #333;
    width: 80%;
  }

  .code-line--keyword {
    width: 40%;
    background: #4a7dff;
  }

  .code-line--indent {
    margin-left: 20px;
  }

  .code-line--long {
    width: 90%;
  }

  .code-line--short {
    width: 50%;
  }

  /* AI preview */
  .ai-nodes {
    position: relative;
    width: 160px;
    height: 120px;
  }

  .ai-node {
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 2px solid #555;
  }

  .ai-node--1 { top: 0; left: 50%; transform: translateX(-50%); background: #4a7dff; border-color: #4a7dff; }
  .ai-node--2 { bottom: 0; left: 10px; background: #333; }
  .ai-node--3 { bottom: 0; right: 10px; background: #333; }

  .ai-connector {
    position: absolute;
    top: 36px;
    left: 50%;
    width: 2px;
    height: 50px;
    background: #444;
    transform: translateX(-50%) rotate(25deg);
    transform-origin: top;
  }

  .ai-connector--2 {
    transform: translateX(-50%) rotate(-25deg);
  }

  .ai-output {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
  }

  .ai-output__line {
    width: 120px;
    height: 6px;
    border-radius: 3px;
    background: #333;
  }

  .ai-output__line--short {
    width: 80px;
  }

  /* Architecture preview */
  .arch-blocks {
    display: flex;
    gap: 16px;
  }

  .arch-block {
    width: 60px;
    height: 50px;
    border-radius: 8px;
    border: 2px solid #444;
  }

  .arch-block--1 { background: #4a7dff; border-color: #4a7dff; }
  .arch-block--2 { background: #333; }
  .arch-block--3 { background: #333; }

  .arch-lines {
    margin-top: 16px;
    display: flex;
    gap: 40px;
  }

  .arch-line {
    width: 60px;
    height: 2px;
    background: #444;
  }

  /* Badge */
  .dev-badge {
    position: absolute;
    bottom: 16px;
    right: 16px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(4px);
  }

  /* Show selected panel + selected label */
  #tab-development:checked ~ .tabs__preview .panel-development,
  #tab-ai-systems:checked ~ .tabs__preview .panel-ai-systems,
  #tab-architecture:checked ~ .tabs__preview .panel-architecture {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  #tab-development:checked ~ .tabs__selector label[for="tab-development"],
  #tab-ai-systems:checked ~ .tabs__selector label[for="tab-ai-systems"],
  #tab-architecture:checked ~ .tabs__selector label[for="tab-architecture"] {
    background: #ffffff;
    border-color: #d8d3cb;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04);
  }

  @media (max-width: 920px) {
    .tabs {
      grid-template-columns: 1fr;
    }

    .tabs__preview {
      min-height: 300px;
    }
  }
</style>
