---

<footer class="site-footer">
  <div class="footer__inner">
    <div class="footer__grid">
      <div class="footer__brand-col">
        <a href="/" class="footer__logo">VM.</a>
        <p class="footer__tagline">
          Vincent Mugondora — Software Engineer, AI Builder, Educator. Available for freelance opportunities and consulting.
        </p>
      </div>

      <div class="footer__nav-col">
        <h4 class="footer__heading">Navigation</h4>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/work">Work</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/writing">Writing</a></li>
          <li><a href="/speaking">Speaking</a></li>
        </ul>
      </div>

      <div class="footer__connect-col">
        <h4 class="footer__heading">Connect</h4>
        <ul>
          <li><a href="mailto:hello@vincentmugondora.com">Email</a></li>
          <li><a href="https://twitter.com/vincemugondora" target="_blank" rel="noopener noreferrer">Twitter</a></li>
          <li><a href="https://www.linkedin.com/in/vincemugondora" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href="https://github.com/vincemugondora" target="_blank" rel="noopener noreferrer">GitHub</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>&copy; {new Date().getFullYear()} Vincent Mugondora. All rights reserved.</span>
      <span>Built with purpose.</span>
    </div>

    <div class="footer__watermark" aria-hidden="true">VINCENT</div>
  </div>
</footer>

<style>
  .site-footer {
    background: #111;
    color: #fff;
    padding: 5rem 1.5rem 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background-size: 40px 40px;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
  }

  @media (min-width: 768px) {
    .site-footer {
      padding: 5rem 3rem 2.5rem;
    }
  }

  .footer__inner {
    max-width: 80rem;
    margin: 0 auto;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-bottom: 5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 5rem;
  }

  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .footer__logo {
    font-family: var(--font-display);
    font-size: 3rem;
    letter-spacing: 0.05em;
    color: #fff;
    text-decoration: none;
    display: block;
    margin-bottom: 1.5rem;
  }

  .footer__tagline {
    font-family: var(--font-mono);
    color: #9ca3af;
    font-size: 0.875rem;
    line-height: 1.6;
    max-width: 24rem;
    margin: 0;
  }

  .footer__heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-orange);
    margin: 0 0 1.5rem;
  }

  .footer__nav-col ul,
  .footer__connect-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer__nav-col a,
  .footer__connect-col a {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #9ca3af;
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer__nav-col a:hover,
  .footer__connect-col a:hover {
    color: #fff;
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #6b7280;
  }

  @media (min-width: 768px) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer__watermark {
    margin-top: 5rem;
    text-align: center;
    font-family: var(--font-display);
    font-size: 15vw;
    line-height: 1;
    letter-spacing: -0.03em;
    opacity: 0.05;
    pointer-events: none;
    user-select: none;
  }
</style>
