---
import { siteConfig } from "@config/site";
---

<footer class="bg-[var(--color-footer)] text-white rounded-t-[16px] md:rounded-t-[80px]">
  <div class="max-w-[1200px] mx-auto px-6 md:px-10 py-12 md:py-16">
    <!-- CTA + Links row -->
    <div class="grid grid-cols-1 md:grid-cols-[1.5fr_1fr_1fr_1fr] gap-10 md:gap-12">
      <!-- CTA -->
      <div>
        <h2 class="font-display italic text-[24px] md:text-[28px] leading-tight text-white mb-3">
          Let's build something meaningful.
        </h2>
        <p class="font-body text-[14px] text-gray-400 mb-4">
          Available for collaborations, speaking and projects.
        </p>
        <a
          href="/contact"
          class="inline-flex items-center px-6 py-2.5 bg-white text-[var(--color-footer)] font-body text-[14px] font-medium rounded-[8px] hover:bg-gray-100 transition-colors"
        >
          Let's Talk &rarr;
        </a>
      </div>

      <!-- Explore -->
      <div>
        <h3 class="font-body text-[12px] font-semibold uppercase tracking-widest text-gray-400 mb-3">Explore</h3>
        <div class="flex flex-col gap-1.5">
          <a href="/work" class="font-body text-[14px] text-gray-300 hover:text-white transition-colors">Work</a>
          <a href="/ai-lab" class="font-body text-[14px] text-gray-300 hover:text-white transition-colors">AI Lab</a>
          <a href="/writing" class="font-body text-[14px] text-gray-300 hover:text-white transition-colors">Writing</a>
          <a href="/about" class="font-body text-[14px] text-gray-300 hover:text-white transition-colors">About</a>
          <a href="/speaking" class="font-body text-[14px] text-gray-300 hover:text-white transition-colors">Speaking</a>
          <a href="/teaching" class="font-body text-[14px] text-gray-300 hover:text-white transition-colors">Teaching</a>
          <a href="/certificates" class="font-body text-[14px] text-gray-300 hover:text-white transition-colors">Certificates</a>
          <a href="/now" class="font-body text-[14px] text-gray-300 hover:text-white transition-colors">Now</a>
        </div>
      </div>

      <!-- Connect -->
      <div>
        <h3 class="font-body text-[12px] font-semibold uppercase tracking-widest text-gray-400 mb-3">Connect</h3>
        <div class="flex flex-col gap-1.5">
          <a href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer" class="font-body text-[14px] text-gray-300 hover:text-white transition-colors">LinkedIn</a>
          <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="font-body text-[14px] text-gray-300 hover:text-white transition-colors">GitHub</a>
          <a href={siteConfig.twitterUrl} target="_blank" rel="noopener noreferrer" class="font-body text-[14px] text-gray-300 hover:text-white transition-colors">X</a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="font-body text-[12px] font-semibold uppercase tracking-widest text-gray-400 mb-3">Services</h3>
        <div class="flex flex-col gap-1.5">
          <a href="/services/software-development" class="font-body text-[14px] text-gray-300 hover:text-white transition-colors">Software Development</a>
          <a href="/services/web-development" class="font-body text-[14px] text-gray-300 hover:text-white transition-colors">Web Development</a>
          <a href="/services/ai-automation" class="font-body text-[14px] text-gray-300 hover:text-white transition-colors">AI Automation</a>
          <a href="/contact" class="font-body text-[14px] text-gray-300 hover:text-white transition-colors">Contact</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-gray-700">
    <div class="max-w-[1200px] mx-auto px-6 md:px-10 py-4">
      <p class="font-body text-[13px] text-gray-400 text-center md:text-left">
        &copy; 2026 Vincent Mugondora
      </p>
    </div>
  </div>
</footer>
