---
import Container from "@components/ui/Container.astro";
import { mainNav } from "@config/navigation";
import { siteConfig } from "@config/site";
---

<footer class="border-t border-midnight/10 bg-midnight py-16 text-offwhite">
  <Container>
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <a href="/" class="font-heading text-xl font-bold text-offwhite">
          {siteConfig.name}
        </a>
        <p class="mt-3 max-w-xs text-sm text-offwhite/60">
          {siteConfig.description}
        </p>
      </div>

      <nav aria-label="Footer navigation">
        <h3 class="font-heading text-sm font-semibold uppercase tracking-wider text-offwhite/40">
          Pages
        </h3>
        <ul class="mt-4 flex flex-col gap-2" role="list">
          {mainNav.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-offwhite/70 transition-colors hover:text-offwhite">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h3 class="font-heading text-sm font-semibold uppercase tracking-wider text-offwhite/40">
          Connect
        </h3>
        <ul class="mt-4 flex flex-col gap-2" role="list">
          <li>
            <a href="https://github.com/vincemugondora" class="text-sm text-offwhite/70 transition-colors hover:text-offwhite" rel="noopener noreferrer" target="_blank">
              GitHub
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/vincemugondora" class="text-sm text-offwhite/70 transition-colors hover:text-offwhite" rel="noopener noreferrer" target="_blank">
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-offwhite/10 pt-8 text-center text-sm text-offwhite/40">
      <p>&copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved.</p>
    </div>
  </Container>
</footer>
