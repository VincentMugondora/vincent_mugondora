---
import { mainNav } from "@config/navigation";
import { siteConfig } from "@config/site";
---

<footer class="border-t border-slate-brand/8 bg-offwhite">
  <div class="mx-auto max-w-[1200px] px-5 py-12 md:px-8 md:py-16">
    <div class="grid gap-10 sm:grid-cols-[1.5fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-flex items-center gap-2.5 text-midnight no-underline">
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-midnight text-[11px] font-semibold leading-none text-white">V</span>
          <span class="font-heading text-lg font-medium tracking-tight">{siteConfig.name}</span>
        </a>
        <p class="mt-3 max-w-[30ch] text-sm leading-relaxed text-muted">
          {siteConfig.description}
        </p>
      </div>

      <nav aria-label="Footer navigation">
        <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted">Pages</h3>
        <ul class="flex flex-col gap-2" role="list">
          {mainNav.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-slate-brand/80 no-underline transition-colors hover:text-midnight">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted">Connect</h3>
        <ul class="flex flex-col gap-2" role="list">
          <li>
            <a href="https://github.com/vincemugondora" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-brand/80 no-underline transition-colors hover:text-midnight">
              GitHub
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/vincemugondora" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-brand/80 no-underline transition-colors hover:text-midnight">
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-slate-brand/8 pt-6 text-center">
      <p class="text-xs text-muted">
        &copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
