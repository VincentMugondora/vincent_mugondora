---
import { mainNav } from "@config/navigation";
import { siteConfig } from "@config/site";
---

<footer class="footer" role="contentinfo">
  <div class="footer__inner">
    <div class="footer__grid">
      <!-- Brand column -->
      <div class="footer__brand-col">
        <a href="/" class="footer__brand" aria-label={`${siteConfig.name} — Home`}>
          <span class="footer__mark" aria-hidden="true">V</span>
          <span class="footer__name">{siteConfig.name}</span>
        </a>
        <p class="footer__tagline">{siteConfig.description}</p>
      </div>

      <!-- Navigation column -->
      <nav class="footer__nav" aria-label="Footer navigation">
        <h3 class="footer__heading">Pages</h3>
        <ul role="list">
          {mainNav.map((item) => (
            <li>
              <a href={item.href} class="footer__link">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Connect column -->
      <div class="footer__connect">
        <h3 class="footer__heading">Connect</h3>
        <ul role="list">
          <li>
            <a href="https://github.com/vincemugondora" target="_blank" rel="noopener noreferrer" class="footer__link">
              GitHub
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/vincemugondora" target="_blank" rel="noopener noreferrer" class="footer__link">
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    margin-top: 4rem;
  }

  .footer__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.25rem 2rem;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 2rem;
  }

  /* Brand */
  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  .footer__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--color-midnight);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
  }

  :global(.dark) .footer__mark {
    background: var(--color-electric);
  }

  .footer__name {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .footer__tagline {
    margin: 0.75rem 0 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
    max-width: 30ch;
  }

  /* Headings */
  .footer__heading {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  /* Links */
  .footer__nav ul,
  .footer__connect ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__link {
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: color 0.15s ease;
  }

  .footer__link:hover {
    color: var(--text-primary);
  }

  .footer__link:focus-visible {
    outline: 2px solid var(--color-electric);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Bottom */
  .footer__bottom {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .footer__bottom p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.75rem;
  }

  @media (max-width: 640px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
