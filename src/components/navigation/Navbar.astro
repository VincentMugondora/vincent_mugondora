---
import Container from "@components/ui/Container.astro";
import { mainNav } from "@config/navigation";
import { siteConfig } from "@config/site";

const currentPath = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 z-50 bg-white/80 backdrop-blur-md">
  <Container>
    <nav class="flex h-16 items-center justify-between" aria-label="Main navigation">
      <a href="/" class="flex items-center gap-2 font-heading text-lg font-bold text-midnight">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-midnight text-white text-sm font-bold">V</span>
        {siteConfig.name}
      </a>

      <ul class="hidden items-center gap-8 md:flex" role="list">
        {mainNav.map((item) => {
          const isActive = currentPath === item.href || currentPath.startsWith(item.href + "/");
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  "text-sm font-medium transition-colors",
                  isActive
                    ? "text-midnight"
                    : "text-muted hover:text-midnight",
                ]}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>

      <div class="hidden md:block">
        <a
          href="/contact"
          class="inline-flex items-center gap-2 rounded-full bg-midnight px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-brand"
        >
          Let's talk
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 13L13 1M13 1H3M13 1v10" />
          </svg>
        </a>
      </div>

      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-md text-midnight md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </nav>
  </Container>
</header>

<div
  class="fixed inset-0 z-50 hidden flex-col bg-white"
  data-mobile-menu
  aria-hidden="true"
>
  <Container>
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-2 font-heading text-lg font-bold text-midnight">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-midnight text-white text-sm font-bold">V</span>
        {siteConfig.name}
      </a>
      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-md text-midnight"
        aria-label="Close menu"
        data-menu-close
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </Container>
  <nav class="flex flex-1 flex-col px-6 pt-8" aria-label="Mobile navigation">
    <ul class="flex flex-col gap-2" role="list">
      {mainNav.map((item) => {
        const isActive = currentPath === item.href || currentPath.startsWith(item.href + "/");
        return (
          <li>
            <a
              href={item.href}
              class:list={[
                "block rounded-md px-4 py-3 text-lg font-medium transition-colors",
                isActive
                  ? "text-midnight"
                  : "text-muted hover:text-midnight",
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
    <div class="mt-8 px-4">
      <a
        href="/contact"
        class="inline-flex items-center gap-2 rounded-full bg-midnight px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-brand"
      >
        Let's talk
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 13L13 1M13 1H3M13 1v10" />
        </svg>
      </a>
    </div>
  </nav>
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const toggle = document.querySelector("[data-menu-toggle]");
    const close = document.querySelector("[data-menu-close]");
    const menu = document.querySelector("[data-mobile-menu]");
    if (!toggle || !close || !menu) return;

    function open() {
      menu.classList.remove("hidden");
      menu.classList.add("flex");
      menu.setAttribute("aria-hidden", "false");
      toggle.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    }

    function shut() {
      menu.classList.add("hidden");
      menu.classList.remove("flex");
      menu.setAttribute("aria-hidden", "true");
      toggle.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    }

    toggle.addEventListener("click", open);
    close.addEventListener("click", shut);
    menu.querySelectorAll("a").forEach(a => a.addEventListener("click", shut));
  });
</script>
