---
import { mainNav } from "@config/navigation";
import { siteConfig } from "@config/site";

const currentPath = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4 sm:px-6 lg:px-10 lg:pt-5">
  <nav
    class="navbar mx-auto grid max-w-[1180px] min-h-14 items-center gap-3 rounded-[14px] bg-transparent px-3 py-2.5 transition-[background-color,box-shadow] duration-300"
    data-navbar
    aria-label="Primary"
  >
    <!-- Brand -->
    <a href="/" class="brand flex items-center gap-2.5 text-midnight no-underline">
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-midnight text-[11px] font-semibold leading-none text-white">V</span>
      <span class="text-xl font-medium tracking-tight">{siteConfig.name}</span>
    </a>

    <!-- Desktop links -->
    <ul class="nav-links-desktop hidden items-center justify-self-center md:flex" role="list">
      {mainNav.map((item) => {
        const isActive = currentPath === item.href || currentPath.startsWith(item.href + "/");
        return (
          <li>
            <a
              href={item.href}
              class:list={[
                "text-[15px] leading-none tracking-tight transition-colors",
                isActive
                  ? "font-semibold text-midnight"
                  : "text-midnight hover:text-muted",
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Desktop CTA -->
    <a
      href="/contact"
      class="cta-desktop hidden items-center gap-2 justify-self-end rounded-full bg-midnight px-[18px] py-[11px] text-sm font-medium leading-none tracking-tight text-white transition-[filter] hover:brightness-110 md:inline-flex"
    >
      <span>Let&rsquo;s talk</span>
      <span class="text-[15px] leading-none" aria-hidden="true">&#8599;</span>
    </a>

    <!-- Mobile menu (no JS, uses details/summary) -->
    <details class="mobile-menu relative justify-self-end md:hidden">
      <summary
        class="flex cursor-pointer items-center gap-2.5 rounded-full bg-midnight px-3.5 py-2.5 text-sm leading-none text-white select-none"
        aria-label="Toggle navigation menu"
      >
        <span>Menu</span>
        <span class="mobile-menu-icon relative inline-block h-[2px] w-3.5 bg-current" aria-hidden="true"></span>
      </summary>
      <div class="absolute left-0 right-0 top-[calc(100%+8px)] z-50 rounded-[14px] border border-[#ecece9] bg-[#f6f6f4] p-4 shadow-lg sm:left-auto sm:min-w-[240px]">
        <ul class="flex flex-col gap-3.5" role="list">
          {mainNav.map((item) => {
            const isActive = currentPath === item.href || currentPath.startsWith(item.href + "/");
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "block text-base transition-colors",
                    isActive
                      ? "font-semibold text-midnight"
                      : "text-midnight hover:text-muted",
                  ]}
                  aria-current={isActive ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
        <a
          href="/contact"
          class="mt-4 flex w-full items-center justify-center gap-2 rounded-full bg-midnight px-[18px] py-[11px] text-sm font-medium leading-none text-white"
        >
          <span>Let&rsquo;s talk</span>
          <span class="text-[15px] leading-none" aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </details>
  </nav>
</header>

<style>
  .navbar {
    grid-template-columns: auto 1fr auto;
  }

  @media (max-width: 767px) {
    .navbar {
      grid-template-columns: 1fr auto;
    }
  }

  .nav-links-desktop {
    gap: clamp(16px, 2vw, 28px);
  }

  /* Hamburger icon lines */
  .mobile-menu-icon::before,
  .mobile-menu-icon::after {
    content: "";
    position: absolute;
    left: 0;
    width: 100%;
    height: 100%;
    background: currentColor;
    border-radius: 2px;
    transition: transform 180ms ease, opacity 180ms ease;
  }
  .mobile-menu-icon::before { top: -4px; }
  .mobile-menu-icon::after { top: 4px; }

  /* Morph to X when open */
  details[open] .mobile-menu-icon {
    background: transparent;
  }
  details[open] .mobile-menu-icon::before {
    top: 0;
    transform: rotate(45deg);
  }
  details[open] .mobile-menu-icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  /* Remove default marker */
  summary::-webkit-details-marker { display: none; }
  summary { list-style: none; }
</style>
